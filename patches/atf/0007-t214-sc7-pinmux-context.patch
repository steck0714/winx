+static struct {
+    uint32_t pad[PAD_COUNT(pad_regs)], mux[PAD_COUNT(mux_regs)];
+    uint32_t gpio_out[32], gpio_cnf[32], gpio_oe[32];
+    bool valid;
+} pad_context;
+
+static uintptr_t gpio_port(unsigned int port)
+{ return LITE_GPIO_BASE + (port / 4) * 0x100U + (port % 4) * 4U; }
+
+void tegra_lite_pads_save(void)
+{
+    pad_context.valid = false;
+    for (unsigned int i = 0; i < 32; i++) {
+        uintptr_t p = gpio_port(i);
+        pad_context.gpio_out[i] = mmio_read_32(p + 0x20) & 0xffU;
+        pad_context.gpio_cnf[i] = mmio_read_32(p) & 0xffU;
+        pad_context.gpio_oe[i] = mmio_read_32(p + 0x10) & 0xffU;
+    }
+    for (unsigned int i = 0; i < PAD_COUNT(pad_regs); i++)
+        pad_context.pad[i] = mmio_read_32(LITE_MISC_BASE + pad_regs[i].offset);
+    for (unsigned int i = 0; i < PAD_COUNT(mux_regs); i++)
+        pad_context.mux[i] = mmio_read_32(LITE_MISC_BASE + mux_regs[i].offset);
+    pad_context.valid = true;
+    flush_dcache_range((uintptr_t)&pad_context, sizeof(pad_context));
+}
+
+static int pad_write(uintptr_t address, uint32_t value, uint32_t mask)
+{
+    uint32_t current = mmio_read_32(address);
+    if ((current & mask) == (value & mask)) return PSCI_E_SUCCESS;
+    mmio_write_32(address, (current & ~mask) | (value & mask));
+    return (mmio_read_32(address) & mask) == (value & mask) ?
+           PSCI_E_SUCCESS : PSCI_E_INTERN_FAIL;
+}
+
+int32_t tegra_lite_pads_restore(void)
+{
+    if (!pad_context.valid) return PSCI_E_DENIED;
+    pad_context.valid = false;
+    /* Restore every output latch before any direction/mux can drive it.
+     * Do not mask, acknowledge or replay pending GPIO interrupts here. */
+    for (unsigned int i = 0; i < 32; i++)
+        if (pad_write(gpio_port(i) + 0x20, pad_context.gpio_out[i], 0xffU))
+            return PSCI_E_INTERN_FAIL;
+    dsbsy();
+    for (unsigned int i = 0; i < 32; i++) {
+        if (pad_write(gpio_port(i), pad_context.gpio_cnf[i], 0xffU) ||
+            pad_write(gpio_port(i) + 0x10, pad_context.gpio_oe[i], 0xffU))
+            return PSCI_E_INTERN_FAIL;
+    }
+    dsbsy();
+    for (unsigned int i = 0; i < PAD_COUNT(pad_regs); i++) {
+        uint32_t value = pad_context.pad[i];
+        /* Switchroot clears the eMMC brick parking bits after resume. */
+        if (pad_regs[i].offset == 0xa9c || pad_regs[i].offset == 0xab4) value &= ~EMMC_PARKING_MASK;
+        if (pad_write(LITE_MISC_BASE + pad_regs[i].offset, value, pad_regs[i].mask))
+            return PSCI_E_INTERN_FAIL;
+    }
+    for (unsigned int i = 0; i < PAD_COUNT(mux_regs); i++)
+        if (pad_write(LITE_MISC_BASE + mux_regs[i].offset, pad_context.mux[i], mux_regs[i].mask))
+            return PSCI_E_INTERN_FAIL;
+    dsbsy();
+    return PSCI_E_SUCCESS;
+}
