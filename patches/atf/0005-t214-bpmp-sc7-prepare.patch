From: ruje0504-2
Subject: [T214] prepare BPMP and PMIC wake before Windows SC7 CPU_SUSPEND

Apply after 0004. SWITCH_LITE_SC7=1 is a development opt-in. Match
Switchroot's MRQ_ENABLE_SUSPEND and PMC wake-latch setup. Reject the PSCI
request if BPMP permission or the PMIC wake-mask readback fails. The Windows
caller remains responsible for device quiescence and context restoration.

References:
https://github.com/CTCaer/switch-l4t-kernel-nvidia/blob/578d533b99cd5d5c3e57760431d2f621307265cf/drivers/soc/tegra/pm-tegra210.c#L68
https://github.com/CTCaer/switch-l4t-kernel-4.9/blob/2d0059fd3167a8df756de2aa0489d4aa70a9fc15/drivers/soc/tegra/pmc.c#L1940
https://github.com/CTCaer/switch-l4t-platform-t210-nx/blob/cf785c4c176499b301170d79fe57b77f365b73cd/kernel-dts/nx-platforms/tegra210b01-nx-pmic.dtsi#L110

--- a/plat/nvidia/tegra/soc/t210/platform_t210.mk
+++ b/plat/nvidia/tegra/soc/t210/platform_t210.mk
@@ -4,6 +4,13 @@
 #
 # SPDX-License-Identifier: BSD-3-Clause
 #
+
+# Opt-in SC7 preparation for the Windows CPU_SUSPEND path.
+SWITCH_LITE_SC7 ?= 0
+$(eval $(call add_define,SWITCH_LITE_SC7))
+ifeq (${SWITCH_LITE_SC7},1)
+BL31_SOURCES += ${SOC_DIR}/t214/sc7.c
+endif
 
 SWITCH_LITE_POWER_TRACE ?= 0
 $(eval $(call add_define,SWITCH_LITE_POWER_TRACE))
--- a/plat/nvidia/tegra/soc/t210/plat_psci_handlers.c
+++ b/plat/nvidia/tegra/soc/t210/plat_psci_handlers.c
@@ -50,6 +50,10 @@
 #endif
 #endif
 
+#if SWITCH_LITE_SC7
+extern int32_t tegra_lite_sc7_prepare(void);
+#endif
+
 int32_t tegra_soc_validate_power_state(unsigned int power_state,
 					psci_power_state_t *req_state)
 {
@@ -75,15 +79,30 @@
 		req_state->pwr_domain_state[MPIDR_AFFLVL1] = state_id;
 		break;
 
-	case PSTATE_ID_SOC_POWERDN:
+	case PSTATE_ID_SOC_POWERDN: {
+		int32_t bpmp_status = tegra_bpmp_init();
 
 		/*
 		 * sc7entry-fw must be present in the system when the bpmp
 		 * firmware is not present, for a successful System Suspend
 		 * entry.
 		 */
-		if (tegra_bpmp_init() != 0U && !plat_params->sc7entry_fw_base)
+		if (bpmp_status != 0 && !plat_params->sc7entry_fw_base)
 			return PSCI_E_NOT_SUPPORTED;
+
+#if SWITCH_LITE_SC7
+		if (tegra_chipid_is_t210_b01()) {
+			/* The Windows CPU_SUSPEND caller does not run Linux's
+			 * syscore suspend callbacks. Require BPMP permission
+			 * and PMIC wake routing before committing to SC7.
+			 * B01 cannot use Erista's separate sc7entry-fw.
+			 */
+			if (bpmp_status != 0)
+				return PSCI_E_NOT_SUPPORTED;
+			if (tegra_lite_sc7_prepare() != PSCI_E_SUCCESS)
+				return PSCI_E_DENIED;
+		}
+#endif
 
 		/*
 		 * System powerdown request only for afflvl 2
@@ -95,6 +114,7 @@
 			PLAT_SYS_SUSPEND_STATE_ID;
 
 		break;
+	}
 
 	default:
 		ERROR("%s: unsupported state id (%d)\n", __func__, state_id);
--- /dev/null
+++ b/plat/nvidia/tegra/soc/t210/t214/sc7.c
@@ -0,0 +1,56 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-only
+ * SC7 preparation adapted from Switchroot L4T's pm-tegra210.c and pmc.c.
+ * Copyright (c) 2009-2019, NVIDIA CORPORATION. All rights reserved.
+ * Copyright (c) 2026, ruje0504-2.
+ *
+ * The B01 board routes MAX77620 pwr_int_n to PMC wake event 51, active low.
+ * GIC PMU_EXT alone cannot wake a power-gated SoC. The Windows power-button
+ * driver must leave its PMIC source armed while peripheral drivers quiesce.
+ */
+#include <stdint.h>
+#include <bpmp.h>
+#include <drivers/delay_timer.h>
+#include <lib/psci/psci.h>
+#include <pmc.h>
+
+#define LITE_PMC_SW_WAKE_STATUS  0x018U
+#define LITE_PMC_WAKE2_MASK      0x160U
+#define LITE_PMC_WAKE2_LEVEL     0x164U
+#define LITE_PMC_WAKE2_STATUS    0x168U
+#define LITE_PMC_SW_WAKE2_STATUS 0x16cU
+#define LITE_PMC_LATCH_WAKEUPS   (1U << 5)
+#define LITE_PMC_PMIC_WAKE       (1U << (51 - 32))
+
+int32_t tegra_lite_sc7_prepare(void)
+{
+    const uint32_t request[] = { TEGRA_PM_SC7, 0U };
+    uint32_t unused_response = 0U;
+    uint32_t control, mask, level;
+
+    if (tegra_bpmp_send_receive_atomic(MRQ_ENABLE_SUSPEND, request,
+            sizeof(request), &unused_response, 0) != 0)
+        return PSCI_E_DENIED;
+
+    /* Latch wake-pad state using Switchroot's two 120-us settling periods.
+     * This source is fixed active-low; no any-edge polarity flip is needed.
+     * Preserve other wake masks/levels and their pending hardware status. */
+    tegra_pmc_write_32(LITE_PMC_SW_WAKE_STATUS, 0U);
+    tegra_pmc_write_32(LITE_PMC_SW_WAKE2_STATUS, 0U);
+    control = tegra_pmc_read_32(PMC_CONFIG);
+    tegra_pmc_write_32(PMC_CONFIG, control | LITE_PMC_LATCH_WAKEUPS);
+    udelay(120);
+    tegra_pmc_write_32(PMC_CONFIG, control & ~LITE_PMC_LATCH_WAKEUPS);
+    udelay(120);
+
+    mask = tegra_pmc_read_32(LITE_PMC_WAKE2_MASK);
+    level = tegra_pmc_read_32(LITE_PMC_WAKE2_LEVEL);
+    tegra_pmc_write_32(LITE_PMC_WAKE2_STATUS, LITE_PMC_PMIC_WAKE);
+    tegra_pmc_write_32(LITE_PMC_WAKE2_LEVEL, level & ~LITE_PMC_PMIC_WAKE);
+    tegra_pmc_write_32(LITE_PMC_WAKE2_MASK, mask | LITE_PMC_PMIC_WAKE);
+    if (!(tegra_pmc_read_32(LITE_PMC_WAKE2_MASK) & LITE_PMC_PMIC_WAKE) ||
+        (tegra_pmc_read_32(LITE_PMC_WAKE2_LEVEL) & LITE_PMC_PMIC_WAKE))
+        return PSCI_E_DENIED;
+
+    return PSCI_E_SUCCESS;
+}
