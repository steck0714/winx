+SWITCH_LITE_POWER_TRACE ?= 0
+$(eval $(call add_define,SWITCH_LITE_POWER_TRACE))
+ifeq (${SWITCH_LITE_POWER_TRACE},1)
+BL31_SOURCES += ${SOC_DIR}/t214/power_trace.c
+endif
 
 SWITCH_LITE_PMIC_RESET ?= 0
 $(eval $(call add_define,SWITCH_LITE_PMIC_RESET))
