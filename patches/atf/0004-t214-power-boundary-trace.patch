--- /dev/null
+++ b/plat/nvidia/tegra/soc/t210/t214/power_trace.c
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Diagnostic only. Fan PWM encoding follows Hekate bdk/thermal/fan.c.
+ * Called at the final Lite PSCI power-off boundary, before changing SCLK.
+ * PWM1 is the already-running fan; PWM0/backlight and disk I/O are untouched.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <lib/mmio.h>
+
+#define TRACE_FAN_PWM 0x7000a010U
+#define TRACE_TIMERUS 0x60005010U
+#define TRACE_FAN_ENABLE 0x80000000U
+#define TRACE_FAN_OFF 0x81000000U
+
+static bool trace_wait_us(uint32_t duration)
+{
+    uint32_t start = mmio_read_32(TRACE_TIMERUS);
+    uint32_t last = start, stalled = 0;
+    for (;;) {
+        uint32_t now = mmio_read_32(TRACE_TIMERUS);
+        if ((uint32_t)(now - start) >= duration)
+            return true;
+        if (now == last) {
+            /* A diagnostic must not hang shutdown if this timer stopped. */
+            if (++stalled == 100000U)
+                return false;
+        } else {
+            stalled = 0;
+        }
+        last = now;
+    }
+}
+
+void tegra_lite_power_trace(void)
+{
+    uint32_t saved = mmio_read_32(TRACE_FAN_PWM);
+    unsigned int i;
+    if (!(saved & TRACE_FAN_ENABLE))
+        return;
+    for (i = 0; i < 2; ++i) {
+        mmio_write_32(TRACE_FAN_PWM, TRACE_FAN_OFF);
+        (void)mmio_read_32(TRACE_FAN_PWM);
+        if (!trace_wait_us(1500000U))
+            break;
+        mmio_write_32(TRACE_FAN_PWM, TRACE_FAN_ENABLE);
+        (void)mmio_read_32(TRACE_FAN_PWM);
+        if (!trace_wait_us(1500000U))
+            break;
+    }
+    /* A failed PMIC operation must not leave the fan artificially stopped. */
+    mmio_write_32(TRACE_FAN_PWM, saved);
+    (void)mmio_read_32(TRACE_FAN_PWM);
+}
