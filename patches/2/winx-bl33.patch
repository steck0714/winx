diff --git a/Tools/test-rtc/check.py b/Tools/test-rtc/check.py
new file mode 100644
index 0000000..a40b5b4
--- /dev/null
+++ b/Tools/test-rtc/check.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Compare LibGetTime() of Library/VirtualRealTimeClockLib with Python's datetime for many dates.
+usage: check.py <test_rtc binary built with -D__DATE__=...> "<Mmm dd yyyy>" <expected base date YYYY-MM-DD>"""
+import datetime, random, subprocess, sys
+exe, date_str, base_str = sys.argv[1:4]
+base = datetime.datetime.strptime(base_str, "%Y-%m-%d").replace(tzinfo=datetime.timezone.utc)
+random.seed(1)
+# edge seconds: around day / month / year / leap boundaries, plus random spread over ~300 years
+vals = {0, 1, 59, 60, 3599, 3600, 86399, 86400, 86401}
+for k in range(0, 4000):
+    vals.add(k * 86400 + random.choice((0, 86399)))                         # every day boundary for ~11 years
+vals.update(random.randrange(0, 300 * 365 * 86400) for _ in range(200000))
+# deterministic boundaries for the next 400 years: new year, Feb 28/29, Mar 1, year end
+for yr in range(base.year, base.year + 400):
+    for (mo, dy) in ((1, 1), (2, 28), (2, 29), (3, 1), (12, 31)):
+        try:
+            d = datetime.datetime(yr, mo, dy, tzinfo=datetime.timezone.utc)
+        except ValueError:
+            continue                                   # Feb 29 of a non-leap year
+        e = int((d - base).total_seconds())
+        if e >= 0:
+            vals.update((e, e + 86399))
+vals = sorted(vals)
+inp = "\n".join(map(str, vals)) + "\n"
+out = subprocess.run([exe], input=inp, capture_output=True, text=True, check=True).stdout.splitlines()
+assert len(out) == len(vals)
+bad = 0
+for line in out:
+    e, st, Y, M, D, h, m, s, tz, ns = map(int, line.split())
+    want = base + datetime.timedelta(seconds=e)
+    got = (Y, M, D, h, m, s)
+    exp = (want.year, want.month, want.day, want.hour, want.minute, want.second)
+    ok = got == exp and st == 0 and tz == 0 and ns == 0 and 1 <= D <= 31 and 1 <= M <= 12
+    if not ok:
+        bad += 1
+        if bad <= 5: print("MISMATCH", e, "got", got, "want", exp)
+print(f"{date_str!r:16} base {base_str}: {len(vals)} timestamps, {bad} mismatches")
+sys.exit(1 if bad else 0)
diff --git a/Tools/test-rtc/run-qemu.sh b/Tools/test-rtc/run-qemu.sh
new file mode 100644
index 0000000..ef6264e
--- /dev/null
+++ b/Tools/test-rtc/run-qemu.sh
@@ -0,0 +1,32 @@
+#!/bin/bash
+# AArch64 variant of run.sh: compiles the REAL VirtualRealTimeClockLib.c with the firmware's own compiler flags
+# (-Os -funsigned-char -mstrict-align -mgeneral-regs-only ...) plus -O0/-O2 for good measure, runs it bare metal in
+# qemu-system-aarch64 (-M virt) and checks every result against Python's datetime with the same check.py.
+# Needs aarch64-linux-gnu-gcc/-objcopy, qemu-system-aarch64, python3. Slow (minutes): ~207k timestamps per run.
+set -eu
+HERE=$(cd "$(dirname "$0")" && pwd)
+PKG=$(cd "$HERE/../.." && pwd)
+BM=$HERE/baremetal
+OUT=${OUT_DIR:-$(mktemp -d)}
+CC=${CROSS_COMPILE:-aarch64-linux-gnu-}gcc
+rc=0
+t() {   # <__DATE__ string> <expected YYYY-MM-DD> <opt>
+  local tag; tag=$(echo "$1-$3" | tr -c 'A-Za-z0-9-\n' _)
+  $CC $3 -g -fshort-wchar -fno-builtin -fno-strict-aliasing -Wall -Werror -funsigned-char -ffreestanding -nostdlib \
+      -mlittle-endian -fno-short-enums -fno-pic -fno-pie -mcmodel=small -ffixed-x18 -mstrict-align -mgeneral-regs-only \
+      -fno-asynchronous-unwind-tables -fno-unwind-tables -ffunction-sections -fdata-sections \
+      -Wno-builtin-macro-redefined -D__DATE__="\"$1\"" -I "$BM/shim" \
+      -T "$BM/link.ld" "$BM/start.S" "$BM/main.c" "$PKG/Library/VirtualRealTimeClockLib/VirtualRealTimeClockLib.c" \
+      -o "$OUT/rtc_$tag.elf"
+  printf '#!/bin/bash\nRTC_BM_ELF=%q exec python3 %q\n' "$OUT/rtc_$tag.elf" "$BM/qemu-run.py" > "$OUT/run_$tag.sh"
+  chmod +x "$OUT/run_$tag.sh"
+  printf '%-4s ' "$3"
+  python3 "$HERE/check.py" "$OUT/run_$tag.sh" "$1" "$2" || rc=1
+}
+for opt in -Os -O0 -O2; do
+  t "Oct  5 2026" 2026-10-05 $opt
+  t "Feb 29 2028" 2028-02-29 $opt
+  t "Mar  1 2100" 2100-03-01 $opt
+  t "Xyz 99 1999" 2018-06-01 $opt
+done
+exit $rc
diff --git a/Tools/test-rtc/run.sh b/Tools/test-rtc/run.sh
new file mode 100644
index 0000000..d621ada
--- /dev/null
+++ b/Tools/test-rtc/run.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# Host-side check of the calendar arithmetic in Library/VirtualRealTimeClockLib (needs gcc + python3).
+set -eu
+HERE=$(cd "$(dirname "$0")" && pwd)
+PKG=$(cd "$HERE/../.." && pwd)
+OUT=${OUT_DIR:-$(mktemp -d)}
+rc=0
+t() {   # <__DATE__ string> <expected YYYY-MM-DD>
+  gcc -std=gnu11 -O1 -w -Wno-builtin-macro-redefined -D__DATE__="\"$1\"" -I "$HERE/shim" \
+      "$HERE/test_rtc.c" "$PKG/Library/VirtualRealTimeClockLib/VirtualRealTimeClockLib.c" -o "$OUT/test_rtc"
+  python3 "$HERE/check.py" "$OUT/test_rtc" "$1" "$2" || rc=1
+}
+t "Oct  5 2026" 2026-10-05
+t "Jan  1 2026" 2026-01-01
+t "Dec 31 2026" 2026-12-31
+t "Feb 29 2028" 2028-02-29     # leap day
+t "Mar  1 2100" 2100-03-01     # 2100 is not a leap year
+t "Feb 28 2100" 2100-02-28
+t "Jan  1 2200" 2200-01-01
+t "Xyz 99 1999" 2018-06-01     # unparsable/implausible: documented fallback
+exit $rc
