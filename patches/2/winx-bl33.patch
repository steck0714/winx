+#define SD_VENCLKCTL                0x100
+#define SD_VENIOTRIMCTL             0x1AC
+#define SD_SDMEMCMPPADCTL           0x1E0
+#define SD_AUTOCALCFG               0x1E4
+#define SD_AUTOCALSTS               0x1EC
+#define SD_IOSPARE                  0x1F0
