+// Runs hekate's real fan_set_duty() (bdk/thermal/fan.c + power/regulator_5v.c + soc/gpio.c, compiled as
+// C++ unchanged) against the fake register file and prints the register writes.
+#include <utils/types.h>
+#include <thermal/fan.h>
+#include <soc/hw_init.h>
+#include <soc/fuse.h>
+#include <soc/clock.h>
+#include <soc/timer.h>
+#include <soc/t210.h>
+#include "scenario.hpp"
+
+// Stand-ins for the parts of hekate that are not under test.
+u32  hw_get_chip_id () {                     // same logic as bdk/soc/hw_init.c
+  return (((u32) *(vu32 *)(APB_MISC_BASE + APB_MISC_GP_HIDREV) >> 4) & 0xF) >= GP_HIDREV_MAJOR_T210B01
+         ? GP_HIDREV_MAJOR_T210B01 : GP_HIDREV_MAJOR_T210;
+}
+u32  fuse_read_hw_type () { return FUSE_NX_HW_TYPE_ICOSA; }   // Erista; clock_enable_pwm() is Aula-only
+void clock_enable_pwm () { fprintf (stderr, "hekate side: clock_enable_pwm() called (Aula only!)\n"); exit (3); }
+u32  get_tmr_us () { return 0; }
+
+int main (int argc, char **argv) {
+  Scenario s = parse_scenario (argc, argv);
+  prefill_registers (s);
+  fan_set_duty (s.duty);
+  dump_trace ("hekate", s);
+  return 0;
+}
diff --git a/Tools/test-fan-trace/mutation-test.py b/Tools/test-fan-trace/mutation-test.py
new file mode 100644
index 0000000..dc24dd5
--- /dev/null
+++ b/Tools/test-fan-trace/mutation-test.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Mutation test for the fan trace harness: inject known bugs into a copy of FanDxe.c and check that
+compare.py notices each one.  HEKATE_DIR=/path/to/hekate Tools/test-fan-trace/mutation-test.py
+
+Expected result: every mutant is CAUGHT except the control (unchanged file) and "no final PWM1 pinmux
+write", an equivalent mutant: on the first call that second write stores the value the pad already has.
+"""
+import os, pathlib, subprocess, sys, tempfile
+
+HERE = pathlib.Path(__file__).resolve().parent
+PKG = HERE.parent.parent
+HEKATE = pathlib.Path(os.environ["HEKATE_DIR"])
+CXX = ["g++", "-std=gnu++17", "-x", "c++", "-fpermissive", "-w", "-O1"]
+src = (PKG / "Drivers/FanDxe/FanDxe.c").read_text()
+
+M = [
+ ("CONTROL (no change)", "FAN_PWM_PARK                   0x100", "FAN_PWM_PARK                   0x100"),
+ ("pulse shift 16->15", "#define PWM_CSR_PULSE_SHIFT            16", "#define PWM_CSR_PULSE_SHIFT            15"),
+ ("fan pad port V->U", "gpio_config (GPIO_PORT_V, GPIO_PIN_4, GPIO_MODE_SPIO)", "gpio_config (GPIO_PORT_U, GPIO_PIN_4, GPIO_MODE_SPIO)"),
+ ("fan pad pin 4->3", "gpio_config (GPIO_PORT_V, GPIO_PIN_4, GPIO_MODE_SPIO)", "gpio_config (GPIO_PORT_V, GPIO_PIN_3, GPIO_MODE_SPIO)"),
+ ("LCD_GPIO2 offset 0x20C->0x208", "#define PINMUX_AUX_LCD_GPIO2           0x20C", "#define PINMUX_AUX_LCD_GPIO2           0x208"),
+ ("SATA_LED offset 0x4C->0x48", "#define PINMUX_AUX_SATA_LED_ACTIVE     0x4C ", "#define PINMUX_AUX_SATA_LED_ACTIVE     0x48 "),
+ ("drop PWM park write", "  PWM (PWM_CONTROLLER_PWM_CSR_1) = PWM_CSR_EN | (FAN_PWM_PARK << PWM_CSR_PULSE_SHIFT);\n", ""),
+ ("gpio order: oe before out", "  gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_HIGH);\n  gpio_output_enable (GPIO_PORT_A, GPIO_PIN_5, GPIO_OUTPUT_ENABLE);", "  gpio_output_enable (GPIO_PORT_A, GPIO_PIN_5, GPIO_OUTPUT_ENABLE);\n  gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_HIGH);"),
+ ("A5 driven low", "gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_HIGH)", "gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_LOW)"),
+ ("PMC clobbers other bits", "PMC (APBDEV_PMC_NO_IOPOWER) = Value & ~PMC_GPIO_BIT;", "PMC (APBDEV_PMC_NO_IOPOWER) = 0;"),
+ ("PMC bit 21->20", "#define PMC_GPIO_BIT                   (1U << 21)", "#define PMC_GPIO_BIT                   (1U << 20)"),
+ ("duty scale 236->235", "#define FAN_DUTY_SCALE                 236", "#define FAN_DUTY_SCALE                 235"),
+ ("non-inverted duty", "InvDuty = FAN_DUTY_SCALE - Duty;", "InvDuty = Duty;"),
+ ("touch CC4 (USB VBUS pad)", "  PINMUX_AUX (PINMUX_AUX_SATA_LED_ACTIVE) = 1;\n", "  PINMUX_AUX (PINMUX_AUX_SATA_LED_ACTIVE) = 1;\n  gpio_write (GPIO_PORT_CC, GPIO_PIN_4, GPIO_LOW);\n"),
+ ("touch backlight CSR_0", "  PWM (PWM_CONTROLLER_PWM_CSR_1) = PWM_CSR_EN | (InvDuty << PWM_CSR_PULSE_SHIFT);", "  PWM (0x00) = PWM_CSR_EN;\n  PWM (PWM_CONTROLLER_PWM_CSR_1) = PWM_CSR_EN | (InvDuty << PWM_CSR_PULSE_SHIFT);"),
+ ("no final PWM1 pinmux write", "  PINMUX_AUX (PINMUX_AUX_LCD_GPIO2) = 1;                // enable fan\n", ""),
+ ("clock source wrong", "((6U << 29) | 4U)", "((6U << 29) | 2U)"),
+ ("chip check inverted", "!= GP_HIDREV_MAJOR_T210)", "== GP_HIDREV_MAJOR_T210)"),
+ ("no clamp", "  if (Duty > FAN_DUTY_MAX) {\n    Duty = FAN_DUTY_MAX;\n  }\n", ""),
+ ("PWM clock check ignores enable bit", "return ((CLOCK (CLK_RST_CLK_OUT_ENB_L) & CLK_L_PWM_BIT) != 0) &&", "return TRUE &&"),
+ ("PWM clock check ignores reset", "((CLOCK (CLK_RST_RST_DEVICES_L) & CLK_L_PWM_BIT) == 0)", "TRUE"),
+]
+
+tmp = pathlib.Path(tempfile.mkdtemp())
+subprocess.run(CXX + ["-I", str(HERE / "shim/hekate"), "-I", str(HERE / "shim/common"), "-I", str(HEKATE / "bdk"),
+                      str(HERE / "main_hekate.cpp"), str(HERE / "regmodel.cpp"),
+                      str(HEKATE / "bdk/thermal/fan.c"), str(HEKATE / "bdk/power/regulator_5v.c"), str(HEKATE / "bdk/soc/gpio.c"),
+                      "-o", str(tmp / "trace_hekate")], check=True)
+unexpected = 0
+for name, old, new in M:
+    assert src.count(old) == 1, (name, src.count(old))
+    (tmp / "FanDxe.c").write_text(src.replace(old, new))
+    r = subprocess.run(CXX + ["-I", str(HERE / "shim/edk2"), "-I", str(HERE / "shim/common"), "-I", str(PKG / "Include"),
+                              str(HERE / "main_fan.cpp"), str(HERE / "regmodel.cpp"), str(tmp / "FanDxe.c"),
+                              str(PKG / "Library/GpioLib/GpioLib.c"), "-o", str(tmp / "trace_mut")],
+                       capture_output=True, text=True)
+    if r.returncode:
+        print("COMPILE-ERR", name, r.stderr[:200]); unexpected += 1; continue
+    c = subprocess.run([sys.executable, str(HERE / "compare.py"), str(tmp / "trace_hekate"), str(tmp / "trace_mut")],
+                       capture_output=True, text=True)
+    caught = c.returncode != 0
+    summary = [l for l in c.stdout.splitlines() if "scenarios passed" in l]
+    expected_pass = name.startswith("CONTROL") or name == "no final PWM1 pinmux write"
+    flag = "ok " if caught != expected_pass else "BAD"
+    unexpected += (caught == expected_pass)
+    print(f"{flag} {'CAUGHT' if caught else 'passed'}  {name:34s} {summary[0] if summary else ''}")
+print("unexpected results:", unexpected)
+sys.exit(1 if unexpected else 0)
diff --git a/Tools/test-fan-trace/regmodel.cpp b/Tools/test-fan-trace/regmodel.cpp
new file mode 100644
index 0000000..8401df1
--- /dev/null
+++ b/Tools/test-fan-trace/regmodel.cpp
@@ -0,0 +1,116 @@
+// Register file + trace recorder + scenario set-up for the fan trace test.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+#include "regmodel.hpp"
+#include "scenario.hpp"
+
+namespace {
+const uint64_t CAR = 0x60006000;
+const uint64_t GPIO = 0x6000D000;
+const uint64_t PINMUX = 0x70003000;
+const uint64_t APB_MISC = 0x70000000;
+const uint64_t PWM = 0x7000A000;
+const uint64_t PMC = 0x7000E400;
+
+struct Event { char kind; uint64_t addr; uint32_t val; uint32_t old; };
+std::map<uint64_t, uint32_t> g_val;
+std::map<uint64_t, uint32_t> g_init;
+std::vector<Event> g_ev;
+bool g_recording = false;
+
+uint32_t cur (uint64_t a) { auto it = g_val.find (a); return it == g_val.end () ? 0 : it->second; }
+}
+
+uint32_t reg_read (uint64_t a) {
+  uint32_t v = cur (a);
+  if (g_recording) g_ev.push_back ({'R', a, v, v});
+  return v;
+}
+
+void reg_write (uint64_t a, uint32_t v) {
+  uint32_t old = cur (a);
+  if (g_recording) g_ev.push_back ({'W', a, v, old});
+  // Tegra CAR write-1-to-set / write-1-to-clear aliases of RST_DEVICES_L and CLK_OUT_ENB_L.
+  if      (a == CAR + 0x300) g_val[CAR + 0x004] = cur (CAR + 0x004) |  v;
+  else if (a == CAR + 0x304) g_val[CAR + 0x004] = cur (CAR + 0x004) & ~v;
+  else if (a == CAR + 0x320) g_val[CAR + 0x010] = cur (CAR + 0x010) |  v;
+  else if (a == CAR + 0x324) g_val[CAR + 0x010] = cur (CAR + 0x010) & ~v;
+  else                       g_val[a] = v;
+}
+
+static uint32_t xorshift (uint32_t &s) { s ^= s << 13; s ^= s >> 17; s ^= s << 5; return s; }
+
+Scenario parse_scenario (int argc, char **argv) {
+  Scenario s;
+  for (int i = 1; i < argc; i++) {
+    const char *a = argv[i];
+    if      (!strncmp (a, "--duty=", 7))    s.duty = strtoul (a + 7, 0, 0);
+    else if (!strncmp (a, "--hidrev=", 9))  s.hidrev = strtoul (a + 9, 0, 0);
+    else if (!strncmp (a, "--pwm-clk=", 10)) {
+      const char *v = a + 10;
+      s.pwm_clk = !strcmp (v, "on") ? 1 : !strcmp (v, "off") ? 2 : !strcmp (v, "rst") ? 3 : !strcmp (v, "noclk") ? 0 : -1;
+      if (s.pwm_clk < 0) { fprintf (stderr, "bad --pwm-clk\n"); exit (2); }
+    }
+    else if (!strncmp (a, "--pmc-bits=", 11)) s.pmc_bits = !strcmp (a + 11, "1");
+    else if (!strncmp (a, "--gpio-rand=", 12)) s.gpio_rand = !strcmp (a + 12, "1");
+    else if (!strncmp (a, "--seed=", 7))    s.seed = strtoul (a + 7, 0, 0);
+    else { fprintf (stderr, "bad arg %s\n", a); exit (2); }
+  }
+  return s;
+}
+
+void prefill_registers (const Scenario &s) {
+  g_recording = false;
+  g_val.clear (); g_ev.clear ();
+  uint32_t r = s.seed ? s.seed : 1;
+
+  // identity
+  g_val[APB_MISC + 0x804] = s.hidrev;
+
+  // clocks: other peripherals running, PWM per scenario
+  uint32_t enb = 0x3A00A5C0 & ~(1u << 17), rst = 0x04000100 & ~(1u << 17);
+  if (s.pwm_clk & 1) enb |= (1u << 17);         // clock enabled
+  if (s.pwm_clk & 2) rst |= (1u << 17);         // block held in reset
+  g_val[CAR + 0x010] = enb;
+  g_val[CAR + 0x004] = rst;
+  g_val[CAR + 0x110] = 0x12345678;            // PWM clock source register: junk that must be replaced if touched
+
+  // GPIO controller
+  for (uint64_t off = 0; off < 0x800; off += 4)
+    g_val[GPIO + off] = s.gpio_rand ? xorshift (r) : 0;
+
+  // pinmux: the pads this test cares about get a "PinMuxDxe-like" non-trivial value
+  g_val[PINMUX + 0x20C] = 0x00000001 | (1u << 6);     // LCD_GPIO2
+  g_val[PINMUX + 0x4C]  = (2u << 2) | (1u << 6);      // SATA_LED_ACTIVE: pull-up + input (see PinMux.h)
+  g_val[PINMUX + 0x1A8] = 0x00000041;                 // USB_VBUS_EN0 on the USB function
+  g_val[PINMUX + 0x1EC] = 0x00000050;                 // CAM1_PWDN (tach)
+
+  // PWM: backlight (CSR_0) is running and must survive; CSR_1 = reset value
+  g_val[PWM + 0x00] = 0x80000000u | (200u << 16) | 0x1234;
+  g_val[PWM + 0x10] = 0;
+
+  // PMC: unrelated bits set so read-modify-write preservation is visible
+  uint32_t noio = 0x0A5A5A5A & ~(1u << 21), det = 0x00C3C3C3 & ~(1u << 21);
+  if (s.pmc_bits) { noio |= (1u << 21); det |= (1u << 21); }
+  g_val[PMC + 0x44] = noio;
+  g_val[PMC + 0xE4] = det;
+
+  g_init = g_val;
+  g_recording = true;
+}
+
+void dump_trace (const char *who, const Scenario &s) {
+  printf ("# %s duty=%u hidrev=0x%08x pwm_clk=%s pmc_bits=%d gpio_rand=%d seed=%u\n",
+          who, s.duty, s.hidrev, s.pwm_clk == 1 ? "on" : s.pwm_clk == 2 ? "off" : s.pwm_clk == 3 ? "rst" : "noclk", s.pmc_bits, s.gpio_rand, s.seed);
+  for (auto &kv : g_init)
+    printf ("I %08llx %08x\n", (unsigned long long)kv.first, kv.second);
+  for (auto &e : g_ev)
+    if (e.kind == 'W') printf ("W %08llx %08x %08x\n", (unsigned long long)e.addr, e.val, e.old);
+  for (auto &kv : g_val)
+    printf ("S %08llx %08x\n", (unsigned long long)kv.first, kv.second);
+}
diff --git a/Tools/test-fan-trace/run.sh b/Tools/test-fan-trace/run.sh
new file mode 100644
index 0000000..7680979
--- /dev/null
+++ b/Tools/test-fan-trace/run.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+# Host-side check of Drivers/FanDxe against hekate's own fan driver.
+#
+#   HEKATE_DIR=/path/to/hekate  Tools/test-fan-trace/run.sh
+#
+# Needs g++ and python3, no hardware and no EDK2. hekate must be a checkout of CTCaer/hekate
+# (the sources used are bdk/thermal/fan.c, bdk/power/regulator_5v.c, bdk/soc/gpio.c).
+set -eu
+HERE=$(cd "$(dirname "$0")" && pwd)
+PKG=$(cd "$HERE/../.." && pwd)
+: "${HEKATE_DIR:?set HEKATE_DIR to a hekate checkout}"
+OUT=${OUT_DIR:-$(mktemp -d)}
+CXX="g++ -std=gnu++17 -x c++ -fpermissive -w -O1"
+
+$CXX -I "$HERE/shim/hekate" -I "$HERE/shim/common" -I "$HEKATE_DIR/bdk" \
+     "$HERE/main_hekate.cpp" "$HERE/regmodel.cpp" \
+     "$HEKATE_DIR/bdk/thermal/fan.c" "$HEKATE_DIR/bdk/power/regulator_5v.c" "$HEKATE_DIR/bdk/soc/gpio.c" \
+     -o "$OUT/trace_hekate"
+
+$CXX -I "$HERE/shim/edk2" -I "$HERE/shim/common" -I "$PKG/Include" \
+     "$HERE/main_fan.cpp" "$HERE/regmodel.cpp" \
+     "$PKG/Drivers/FanDxe/FanDxe.c" "$PKG/Library/GpioLib/GpioLib.c" \
+     -o "$OUT/trace_fan"
+
+exec python3 "$HERE/compare.py" "$OUT/trace_hekate" "$OUT/trace_fan"
diff --git a/Tools/test-fan-trace/shim/common/regmodel.hpp b/Tools/test-fan-trace/shim/common/regmodel.hpp
new file mode 100644
index 0000000..1fadcf0
--- /dev/null
+++ b/Tools/test-fan-trace/shim/common/regmodel.hpp
@@ -0,0 +1,20 @@
+// Fake MMIO register file shared by the hekate-side and the FanDxe-side test programs.
+//
+// Register accesses in both code bases look like  *(vu32 *)(base + off) = v  /  |= /  &=  /  (read).
+// The shims make `vu32` a class WITHOUT data members: the "object" is only ever used through its
+// address, which is the register address, so no memory is touched and no mmap is needed.
+#pragma once
+#include <cstdint>
+
+uint32_t reg_read (uint64_t addr);
+void     reg_write (uint64_t addr, uint32_t value);
+
+struct vu32 {
+  uint64_t addr () const { return (uint64_t)(uintptr_t)this; }
+  operator uint32_t () const { return reg_read (addr ()); }
+  vu32 &operator= (uint32_t v) { reg_write (addr (), v); return *this; }
+  vu32 &operator= (const vu32 &o) { uint32_t v = o; reg_write (addr (), v); return *this; }
+  vu32 &operator|= (uint32_t v) { reg_write (addr (), reg_read (addr ()) | v); return *this; }
+  vu32 &operator&= (uint32_t v) { reg_write (addr (), reg_read (addr ()) & v); return *this; }
+  vu32 &operator^= (uint32_t v) { reg_write (addr (), reg_read (addr ()) ^ v); return *this; }
+};
