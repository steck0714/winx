diff --git a/Tools/test-rtc/baremetal/main.c b/Tools/test-rtc/baremetal/main.c
new file mode 100644
index 0000000..72922a2
--- /dev/null
+++ b/Tools/test-rtc/baremetal/main.c
@@ -0,0 +1,38 @@
+/* Bare-metal AArch64 driver around the REAL LibGetTime() (Library/VirtualRealTimeClockLib).
+   QEMU preloads [u64 count][u64 elapsed-seconds ...] at 0x41000000. One result line per value goes to the
+   PL011 in the same format as ../test_rtc.c, then "DONE". Driven by run-qemu.sh / qemu-run.py. */
+#include <PiDxe.h>
+
+UINT64 g_counter, g_freq = 19200000;
+
+/* In the firmware memcpy() comes from CompilerIntrinsicsLib; here the compiler emits a call for the
+   local string arrays in BuildDateEpochSeconds(). volatile: keep GCC from turning the loop back into memcpy. */
+void *memcpy (void *dst, const void *src, unsigned long n) {
+  volatile unsigned char *d = dst; const volatile unsigned char *s = src;
+  while (n--) *d++ = *s++;
+  return dst;
+}
+extern EFI_STATUS LibGetTime (EFI_TIME *Time, EFI_TIME_CAPABILITIES *Cap);
+
+#define UART ((volatile UINT32 *) 0x09000000)
+static void putc_ (char c) { *UART = (UINT8) c; }
+static void puts_ (const char *s) { while (*s) putc_ (*s++); }
+static void putu (UINT64 v) { char b[24]; int i = 0; if (!v) b[i++] = '0'; while (v) { b[i++] = (char) ('0' + v % 10); v /= 10; } while (i) putc_ (b[--i]); }
+static void puti (INT64 v) { if (v < 0) { putc_ ('-'); v = -v; } putu ((UINT64) v); }
+static void sp (void) { putc_ (' '); }
+
+void main_ (void) {
+  const volatile UINT64 *p = (const volatile UINT64 *) 0x41000000;
+  UINT64 n = p[0];
+  for (UINT64 i = 1; i <= n; i++) {
+    UINT64 elapsed = p[i];
+    EFI_TIME t; EFI_TIME_CAPABILITIES c;
+    g_counter = elapsed * g_freq + 12345;                    /* + a fraction of a second: must floor */
+    EFI_STATUS st = LibGetTime (&t, &c);
+    putu (elapsed); sp (); putu (st); sp (); putu (t.Year); sp (); putu (t.Month); sp (); putu (t.Day); sp ();
+    putu (t.Hour); sp (); putu (t.Minute); sp (); putu (t.Second); sp (); puti (t.TimeZone); sp (); putu (t.Nanosecond);
+    putc_ ('\n');
+  }
+  puts_ ("DONE\n");
+  for (;;) __asm__ volatile ("wfi");
+}
diff --git a/Tools/test-rtc/baremetal/qemu-run.py b/Tools/test-rtc/baremetal/qemu-run.py
new file mode 100644
index 0000000..f82ed67
--- /dev/null
+++ b/Tools/test-rtc/baremetal/qemu-run.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Acts as the "test binary" for ../check.py: reads whitespace-separated elapsed-second values on stdin,
+runs them through the bare-metal AArch64 image in qemu-system-aarch64 and prints one result line each.
+Needs RTC_BM_ELF (path to the linked ELF)."""
+import os, struct, subprocess, sys, tempfile, time
+elf = os.environ["RTC_BM_ELF"]
+vals = [int(x) for x in sys.stdin.read().split()]
+with tempfile.TemporaryDirectory() as d:
+    ts, out = os.path.join(d, "ts.bin"), os.path.join(d, "serial.txt")
+    open(ts, "wb").write(struct.pack("<Q", len(vals)) + struct.pack("<%dQ" % len(vals), *vals))
+    open(out, "wb").close()
+    q = subprocess.Popen(["qemu-system-aarch64", "-M", "virt", "-cpu", "cortex-a57", "-m", "128M", "-smp", "1",
+                          "-nographic", "-monitor", "none", "-nic", "none", "-serial", "file:" + out,
+                          "-kernel", elf, "-device", "loader,file=%s,addr=0x41000000" % ts],
+                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    t0, done = time.time(), False
+    while time.time() - t0 < float(os.environ.get("RTC_BM_TIMEOUT", "300")):
+        time.sleep(0.3)
+        with open(out, "rb") as f:
+            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - 8)); tail = f.read()
+        if tail.endswith(b"DONE\n"):
+            done = True
+            break
+        if q.poll() is not None:
+            break
+    q.kill(); q.wait()
+    if not done:
+        sys.exit("qemu run did not finish (no DONE marker)")
+    sys.stdout.write(open(out, "rb").read().decode().replace("DONE\n", ""))
