+STATIC
+inline
+UINT32 *
+RotatedPixel
+(
+    IN UINTN Lx,
+    IN UINTN Ly
+)
+{
+    UINTN X, Y;
+
+#if defined(SWITCH_FB_ROTATE) && (SWITCH_FB_ROTATE == 2)
+    X = Ly;
+    Y = (mNativeHeight - 1) - Lx;
+#else
+    X = (mNativeWidth - 1) - Ly;
+    Y = Lx;
+#endif
+
+    return (UINT32 *)(UINTN)mDisplayMode.FrameBufferBase + Y * mNativeWidth + X;
