-    Hdr = AllocateZeroPool (512);
-    if (Buf == NULL || Hdr == NULL) goto out;
-
-    if (!SdReadSector (Instance, 0, Buf) || Buf[510] != 0x55 || Buf[511] != 0xAA) goto out;
