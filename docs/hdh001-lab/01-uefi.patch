diff --git a/Library/PlatformBootManagerLib/LiteSdBoot.c b/Library/PlatformBootManagerLib/LiteSdBoot.c
new file mode 100644
index 0000000..174a413
--- /dev/null
+++ b/Library/PlatformBootManagerLib/LiteSdBoot.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "PlatformBm.h"
+#include <Library/UefiBootManagerLib.h>
+#include <Protocol/SimpleFileSystem.h>
+
+STATIC VOID
+ShowSdLog (VOID)
+{
+  EFI_GUID SdDriver = {0x5d69e400, 0xe850, 0x4a90, {0x8b,0x9b,0xe9,0x7a,0x8c,0x22,0x23,0x7d}};
+  CHAR16 *Log;
+  UINTN Size;
+
+  if (!EFI_ERROR (GetVariable2 (L"SdDiag", &SdDriver, (VOID **)&Log, &Size))) {
+    Print (L"%s", Log);
+    FreePool (Log);
+  }
+}
+
+// This diagnostic firmware boots only the application beside its BL33 on the SD card.
+VOID EFIAPI
+PlatformBootManagerAfterConsole (VOID)
+{
+  EFI_STATUS Status;
+  EFI_HANDLE *Volumes = NULL;
+  EFI_HANDLE Child;
+  EFI_DEVICE_PATH_PROTOCOL *Path;
+  UINTN Index, Count = 0;
+  BOOLEAN Started = FALSE;
+
+  gBS->SetWatchdogTimer (0, 0, 0, NULL);
+  gST->ConOut->ClearScreen (gST->ConOut);
+  Print (L"LITE UEFI / SD TEST 2\r\nConnecting SD volumes...\r\n");
+  EfiBootManagerConnectAll ();
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &Count, &Volumes);
+  Print (L"File systems: %u (%r)\r\n", (UINT32)Count, Status);
+  if (!EFI_ERROR (Status)) {
+    for (Index = 0; Index < Count; ++Index) {
+      Path = FileDevicePath (Volumes[Index], L"\\switchroot\\woa-lite-uefi\\SDTEST.EFI");
+      if (Path == NULL) {
+        Status = EFI_OUT_OF_RESOURCES;
+        break;
+      }
+      Status = gBS->LoadImage (FALSE, gImageHandle, Path, NULL, 0, &Child);
+      FreePool (Path);
+      Print (L"FS %u / SDTEST.EFI: %r\r\n", (UINT32)Index, Status);
+      if (!EFI_ERROR (Status)) {
+        Started = TRUE;
+        Status = gBS->StartImage (Child, NULL, NULL);
+        Print (L"App returned: %r\r\n", Status);
+        break;
+      }
+    }
+    FreePool (Volumes);
+  }
+  if (!Started || EFI_ERROR (Status)) ShowSdLog ();
+  Print (L"Hold POWER 12s to turn off.\r\n");
+  for (;;) {
+    __asm__ volatile ("wfi");
+  }
+}
