-    }
-
-    if (Gpt && SdReadSector (Instance, 1, Hdr) && CompareMem (Hdr, "EFI PART", 8) == 0) {
-        UINT64 EntLba  = Le64 (Hdr + 72);
-        UINT32 NumEnt  = Le32 (Hdr + 80);
-        UINT32 EntSize = Le32 (Hdr + 84);
