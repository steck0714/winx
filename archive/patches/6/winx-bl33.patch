diff --git a/Tools/host-tests/mousecursor/t.c b/Tools/host-tests/mousecursor/t.c
new file mode 100644
index 0000000..6fd5314
--- /dev/null
+++ b/Tools/host-tests/mousecursor/t.c
@@ -0,0 +1,101 @@
+// Host test of MouseCursorDxe.c: fake GOP framebuffer + fake mouse. Checks that moving the cursor restores the background,
+// keeps pixels painted by someone else while the cursor was up, and clips at the screen edges.
+#include <stdio.h>
+#include <assert.h>
+#include "Uefi.h"
+#include "Protocol/GraphicsOutput.h"
+#include "Protocol/SimplePointer.h"
+EFI_GUID gEfiSimplePointerProtocolGuid, gEfiGraphicsOutputProtocolGuid;
+typedef struct { void *x; } BS;
+static EFI_GRAPHICS_OUTPUT_BLT_PIXEL FB[64*48];
+static EFI_GOP_INFO Info = {64, 48};
+static EFI_GOP_MODE GMode = {&Info};
+static EFI_STATUS GBlt(EFI_GRAPHICS_OUTPUT_PROTOCOL*T, EFI_GRAPHICS_OUTPUT_BLT_PIXEL*B, EFI_GRAPHICS_OUTPUT_BLT_OPERATION Op,
+                       UINTN SX, UINTN SY, UINTN DX, UINTN DY, UINTN W, UINTN H, UINTN D) {
+  if (!D) D = W*4;
+  for (UINTN y=0;y<H;y++) for (UINTN x=0;x<W;x++) {
+    if (Op==EfiBltVideoToBltBuffer) { if (SX+W>64||SY+H>48) return 2; ((EFI_GRAPHICS_OUTPUT_BLT_PIXEL*)((UINT8*)B+(DY+y)*D))[DX+x] = FB[(SY+y)*64+SX+x]; }
+    else { if (DX+W>64||DY+H>48) return 2; FB[(DY+y)*64+DX+x] = ((EFI_GRAPHICS_OUTPUT_BLT_PIXEL*)((UINT8*)B+(SY+y)*D))[SX+x]; }
+  }
+  return 0;
+}
+static EFI_GRAPHICS_OUTPUT_PROTOCOL Gop = {GBlt, &GMode};
+static EFI_SIMPLE_POINTER_MODE SMode = {8,8,0,1,1};
+static EFI_SIMPLE_POINTER_STATE Next; static int Have;
+static EFI_STATUS SGet(EFI_SIMPLE_POINTER_PROTOCOL*T, EFI_SIMPLE_POINTER_STATE*S){ if(!Have) return EFI_NOT_READY; *S=Next; Have=0; return 0; }
+static EFI_SIMPLE_POINTER_PROTOCOL Sp = {0,SGet,0,&SMode};
+static struct { EFI_STATUS (*LocateProtocol)(EFI_GUID*,void*,void**); EFI_STATUS (*LocateHandleBuffer)(int,EFI_GUID*,void*,UINTN*,EFI_HANDLE**);
+  EFI_STATUS (*HandleProtocol)(EFI_HANDLE,EFI_GUID*,void**); EFI_TPL (*RaiseTPL)(EFI_TPL); void (*RestoreTPL)(EFI_TPL); EFI_STATUS (*CreateEvent)(UINT32,UINTN,void*,void*,EFI_EVENT*); EFI_STATUS (*SetTimer)(EFI_EVENT,int,UINT64);} BSv;
+static EFI_STATUS LP(EFI_GUID*g,void*r,void**i){*i=&Gop;return 0;}
+static int LHB_COUNT=1;
+static EFI_STATUS LHB(int t,EFI_GUID*g,void*r,UINTN*c,EFI_HANDLE**h){if(!LHB_COUNT) return 14; *c=1;*h=malloc(sizeof(void*));(*h)[0]=(EFI_HANDLE)1;return 0;}
+static EFI_STATUS HP(EFI_HANDLE h,EFI_GUID*g,void**i){*i=&Sp;return 0;}
+static EFI_STATUS CE(UINT32 t,UINTN l,void*f,void*c,EFI_EVENT*e){return 0;}
+static EFI_STATUS ST(EFI_EVENT e,int t,UINT64 p){return 0;}
+static EFI_TPL RT(EFI_TPL t){return 4;}
+static void RS(EFI_TPL t){}
+#define gBS (&BSv)
+#include "../../../Drivers/MouseCursorDxe/MouseCursorDxe.c"
+static void Tick(int dx,int dy,int l,int r){ Next.RelativeMovementX=dx; Next.RelativeMovementY=dy; Next.LeftButton=l; Next.RightButton=r; Have=1; PollMouse(0,0); }
+static int Cnt(void){ int n=0; for(int i=0;i<64*48;i++) if(FB[i].Red||FB[i].Green||FB[i].Blue) n++; return n; }
+static int Diff(EFI_GRAPHICS_OUTPUT_BLT_PIXEL*Ref){ int d=0; for(int i=0;i<64*48;i++) if(memcmp(&Ref[i],&FB[i],3)) d++; return d; }
+int main(void){
+  BSv.LocateProtocol=LP; BSv.LocateHandleBuffer=LHB; BSv.HandleProtocol=HP; BSv.CreateEvent=CE; BSv.SetTimer=ST; BSv.RaiseTPL=RT; BSv.RestoreTPL=RS;
+  for (int i=0;i<64*48;i++){FB[i].Red=10;FB[i].Green=20;FB[i].Blue=30;}
+  EFI_GRAPHICS_OUTPUT_BLT_PIXEL Ref[64*48]; memcpy(Ref,FB,sizeof FB);
+  EFI_SIMPLE_POINTER_STATE St;
+  PollMouse(0,0); assert(memcmp(Ref,FB,sizeof FB)==0);                    // hidden until the first event
+  assert(Sp.GetState==WrapGetState);                                      // hooked
+  Tick(0,0,0,0); assert(memcmp(Ref,FB,sizeof FB)!=0);                    // first event: cursor appears at the centre
+  assert(mX==32 && mY==24);
+
+  // consumers still get the events (no stealing): accumulated movement and button state
+  assert(Sp.GetState(&Sp,&St)==0 && St.RelativeMovementX==0);            // the (0,0) event itself is "pending" once
+  assert(Sp.GetState(&Sp,&St)==EFI_NOT_READY);
+  Tick(2,0,0,0); Tick(3,1,1,0);
+  assert(Sp.GetState(&Sp,&St)==0);
+  assert(St.RelativeMovementX==5 && St.RelativeMovementY==1 && St.LeftButton==1 && St.RightButton==0);
+  assert(Sp.GetState(&Sp,&St)==EFI_NOT_READY);
+
+  // acceleration: a fast flick moves further than the raw counts, a slow one is about 1:1
+  int x0=mX; Tick(10,0,0,0); int fast=mX-x0; assert(fast>=15 && fast<=17);   // speed 10 -> 1.625x
+  Sp.GetState(&Sp,&St);
+  // sub-pixel remainder: 16 single-count ticks move 17 px (1.0625x), not 16 and not 0
+  mX=10; mFracX=0; x0=mX; for(int i=0;i<16;i++) Tick(1,0,0,0); assert(mX-x0==17);
+  Sp.GetState(&Sp,&St);
+  // negative direction is symmetric and returns to the start within the remainder
+  for(int i=0;i<16;i++) Tick(-1,0,0,0); assert(mX==10 || mX==9 || mX==11);
+  Sp.GetState(&Sp,&St);
+
+  // no consumer for > 500 ms: the pending movement is dropped, a later consumer is not hit by one huge jump
+  Tick(4,4,0,0);
+  for(int i=0;i<30;i++) PollMouse(0,0);
+  Tick(1,1,0,0);
+  assert(Sp.GetState(&Sp,&St)==0 && St.RelativeMovementX==1 && St.RelativeMovementY==1);
+
+  // foreign paint under the cursor survives the next move
+  mX=32; mY=24; mFracX=mFracY=0; Tick(0,0,0,0);
+  FB[24*64+43] = (EFI_GRAPHICS_OUTPUT_BLT_PIXEL){1,2,3,0};                // arrow row 0 col 11 is transparent
+  Tick(10,0,0,0);
+  assert(FB[24*64+43].Blue==1 && FB[24*64+43].Green==2 && FB[24*64+43].Red==3);
+  FB[24*64+43]=Ref[24*64+43];
+
+  // clamping and clipping at the edges
+  Tick(-500,-500,0,0); assert(mX==0 && mY==0);
+  Tick(500,500,1,0);   assert(mX==63 && mY==47);
+  Tick(-500,-500,0,1);
+  CursorErase();
+  printf("pixels differing from background after erase: %d\n", Diff(Ref));
+  assert(Diff(Ref)==0);
+  Tick(0,0,1,1); assert(mDrawn);
+
+  // video mode change: state is reset and the cursor re-centred, no crash
+  Info.HorizontalResolution=32; Info.VerticalResolution=24; Tick(0,0,0,0);
+  assert(mX==16 && mY==12);
+  Info.HorizontalResolution=64; Info.VerticalResolution=48;
+
+  // device removal: records are dropped
+  LHB_COUNT=0; PollMouse(0,0); assert(mRec[0].Sp==NULL);
+  printf("mouse cursor host test OK\n");
+  return 0;
+}
diff --git a/Tools/make-bl33.py b/Tools/make-bl33.py
new file mode 100755
index 0000000..f266cf7
--- /dev/null
+++ b/Tools/make-bl33.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-2-Clause-Patent
+"""Build / verify bl33.bin for hekate's L4T launcher.
+
+    bl33.bin = 4 KiB entry stub (Tools/Bl33/bl33_stub.S) + TEGRA210_EFI.fd
+
+hekate loads it at 0xAA000000 (BL33_LOAD_BASE) and BL31 jumps there in EL2t.
+
+All checks below are STATIC. They catch layout mistakes (wrong FD base, wrong stub, FD that does
+not fit); they do not prove the image boots on a console.
+
+    make-bl33.py --fd TEGRA210_EFI.fd --map FVMAIN_COMPACT.Fv.map -o bl33.bin
+    make-bl33.py --verify bl33.bin [--map FVMAIN_COMPACT.Fv.map]
+"""
+import argparse, hashlib, pathlib, re, shutil, struct, subprocess, sys, tempfile
+
+LOAD_BASE   = 0xAA000000      # hekate: BL33_LOAD_BASE
+STUB_SIZE   = 0x1000
+FD_BASE     = LOAD_BASE + STUB_SIZE
+FD_MAX      = 0x000FF000      # NintendoSwitch.fdf: [FD] Size (0xE0000, or 0xFF000 with SWITCH_NET)
+REGION_MAX  = 0x00100000      # MemoryMap.h (SWITCH_BOOT_CHAIN_HEKATE): stub+FD region
+FDT_MAGIC   = 0xEDFE0DD0      # little-endian view of 0xD00DFEED
+STUB_TAG    = b"WINXHKT1"
+STUB_SRC    = pathlib.Path(__file__).resolve().parent / "Bl33" / "bl33_stub.S"
+
+
+def fail(msg):
+    sys.exit(f"make-bl33: ERROR: {msg}")
+
+
+def build_stub(src):
+    tools = [shutil.which(f"aarch64-linux-gnu-{n}") for n in ("as", "ld", "objcopy")]
+    if not all(tools):
+        fail("aarch64-linux-gnu-{as,ld,objcopy} not found (apt install binutils-aarch64-linux-gnu) or pass --stub")
+    with tempfile.TemporaryDirectory() as d:
+        o, e, b = (pathlib.Path(d, n) for n in ("s.o", "s.elf", "s.bin"))
+        subprocess.run([tools[0], "-o", str(o), str(src)], check=True)
+        subprocess.run([tools[1], f"-Ttext={LOAD_BASE:#x}", "-o", str(e), str(o)], check=True)
+        subprocess.run([tools[2], "-O", "binary", str(e), str(b)], check=True)
+        return b.read_bytes()
+
+
+def check_stub(stub):
+    if len(stub) != STUB_SIZE:
+        fail(f"stub is {len(stub):#x} bytes, expected {STUB_SIZE:#x}")
+    off = struct.unpack_from("<I", stub, 0x10)[0]
+    # hekate reads *(u32 *)(LOAD_BASE + off): must stay inside the image and not be the FDT magic.
+    if off & 3 or not (0x14 <= off <= STUB_SIZE - 4):
+        fail(f"u32 at +0x10 is {off:#x}: hekate would dereference LOAD_BASE+{off:#x} (must be 4-aligned, inside the stub)")
+    probe = struct.unpack_from("<I", stub, off)[0]
+    if probe == FDT_MAGIC:
+        fail("word hekate probes equals the FDT magic: hekate would patch UART strings into the stub")
+    if stub[0x20:0x28] != STUB_TAG:
+        fail(f"stub tag at +0x20 is {stub[0x20:0x28]!r}, expected {STUB_TAG!r}")
+    w0 = struct.unpack_from("<I", stub, 0)[0]
+    if w0 >> 26 != 0b000101:
+        fail(f"first stub instruction {w0:#010x} is not an unconditional B")
+    return off, probe
+
+
+def b_target(word, pc):
+    imm = word & 0x03FFFFFF
+    if imm & 0x02000000:
+        imm -= 0x04000000
+    return pc + imm * 4
+
+
+def check_stub_branch(stub):
+    """Follow the stub: B stub_main ... final B must land on FD_BASE."""
+    t0 = b_target(struct.unpack_from("<I", stub, 0)[0], LOAD_BASE)
+    pc = t0
+    # expected tail: msr daifset,#0xf ; msr spsel,#1 ; isb ; b fd_entry
+    exp = [0xD5034FDF, 0xD50041BF, 0xD5033FDF]
+    for i, e in enumerate(exp):
+        w = struct.unpack_from("<I", stub, pc - LOAD_BASE + 4 * i)[0]
+        if w != e:
+            fail(f"stub_main+{4*i:#x} is {w:#010x}, expected {e:#010x}")
+    wb = struct.unpack_from("<I", stub, pc - LOAD_BASE + 12)[0]
+    if wb >> 26 != 0b000101:
+        fail("stub_main does not end in an unconditional B")
+    t = b_target(wb, pc + 12)
+    if t != FD_BASE:
+        fail(f"stub branches to {t:#x}, expected FD at {FD_BASE:#x}")
+    return t0, t
+
+
+def parse_map(path):
+    txt = pathlib.Path(path).read_text(errors="replace")
+    m = re.search(r"\(Fixed Flash Address, BaseAddress=0x([0-9a-fA-F]+), EntryPoint=0x([0-9a-fA-F]+)", txt)
+    if not m:
+        fail(f"{path}: no 'Fixed Flash Address, BaseAddress=..., EntryPoint=...' line")
+    taken = re.search(r"EFI_FV_TAKEN_SIZE\s*=\s*0x([0-9a-fA-F]+)", txt)
+    total = re.search(r"EFI_FV_TOTAL_SIZE\s*=\s*0x([0-9a-fA-F]+)", txt)
+    used = (int(taken.group(1), 16), int(total.group(1), 16)) if taken and total else None
+    return int(m.group(1), 16), int(m.group(2), 16), used
+
+
+def check_fd(fd, map_path):
+    if len(fd) > FD_MAX:
+        fail(f"FD is {len(fd):#x} bytes, exceeds PcdFdSize {FD_MAX:#x}")
+    if len(fd) < 0x1000:
+        fail("FD suspiciously small")
+    w = struct.unpack_from("<I", fd, 0)[0]
+    if w >> 26 != 0b000101:
+        fail(f"FD first instruction {w:#010x} is not B (expected PrePi entry branch)")
+    entry = b_target(w, FD_BASE)
+    if not (FD_BASE <= entry < FD_BASE + len(fd)):
+        fail(f"FD entry branch lands at {entry:#x}, outside the FD [{FD_BASE:#x}, {FD_BASE+len(fd):#x})")
+    info = f"FD entry branch -> {entry:#x}"
+    if map_path:
+        base, ep, used = parse_map(map_path)
+        if ep != entry:
+            fail(f"map EntryPoint {ep:#x} != FD first-branch target {entry:#x}: FD was not linked for {FD_BASE:#x} "
+                 f"(build with -D SWITCH_HEKATE=1)")
+        info += f"; map EntryPoint {ep:#x} matches, PrePi image base {base:#x}"
+        if used:
+            info += f"; FV used {used[0]:#x} of {used[1]:#x} ({used[0] * 100 // used[1]}%)"
+    return entry, info
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--fd", help="TEGRA210_EFI.fd built with -D SWITCH_HEKATE=1")
+    ap.add_argument("--map", help="FVMAIN_COMPACT.Fv.map from the same build (cross-checks the link address)")
+    ap.add_argument("--stub", help="prebuilt 4 KiB stub (default: assemble Tools/Bl33/bl33_stub.S)")
+    ap.add_argument("-o", "--output", help="bl33.bin to write")
+    ap.add_argument("--verify", metavar="BL33_BIN", help="only verify an existing bl33.bin")
+    a = ap.parse_args()
+
+    if a.verify:
+        img = pathlib.Path(a.verify).read_bytes()
+        stub, fd = img[:STUB_SIZE], img[STUB_SIZE:]
+    else:
+        if not (a.fd and a.output):
+            ap.error("--fd and -o are required (or use --verify)")
+        fd = pathlib.Path(a.fd).read_bytes()
+        stub = pathlib.Path(a.stub).read_bytes() if a.stub else build_stub(STUB_SRC)
+        img = stub + fd
+
+    off, probe = check_stub(stub)
+    t0, tail = check_stub_branch(stub)
+    entry, info = check_fd(fd, a.map)
+    if len(img) > REGION_MAX:
+        fail(f"image {len(img):#x} bytes does not fit the {REGION_MAX:#x}-byte region in MemoryMap.h")
+
+    print(f"stub : {len(stub):#x} B, hekate probe at +0x10 -> +{off:#x} (= {probe:#010x}, not FDT magic), "
+          f"entry b -> {t0:#x}, final b -> {tail:#x}")
+    print(f"fd   : {len(fd):#x} B file (padded to the FD size); {info}")
+    if not a.verify:
+        pathlib.Path(a.output).write_bytes(img)
+        print(f"wrote {a.output}: {len(img)} B, sha256 {hashlib.sha256(img).hexdigest()}")
+    else:
+        print("verify OK (static checks only)")
+    if not a.map:
+        print("note : no --map given; FD link address not cross-checked")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Tools/setup_efifs.sh b/Tools/setup_efifs.sh
new file mode 100755
index 0000000..5b5ee25
--- /dev/null
+++ b/Tools/setup_efifs.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# Prepares EfiFsPkg (read-only NTFS/exFAT/ext2-4/XFS/Btrfs/F2FS/EROFS UEFI drivers) for `-D SWITCH_FSDRV=1`.
+# Usage: Tools/setup_efifs.sh <edk2 dir>      (EfiFs: GPLv3, pbatard/EfiFs v1.12 + GRUB 2.14 sources)
+set -e
+EDK2=${1:?usage: setup_efifs.sh <edk2 dir>}
+W=$(mktemp -d)
+git clone --filter=blob:none https://github.com/pbatard/efifs.git "$W/efifs"
+(cd "$W/efifs" && git checkout -q v1.12)
+mkdir -p "$W/efifs/grub"
+# EfiFs v1.12 expects GRUB 2.14 (a git submodule; the tarball is equivalent).
+curl -fL -o "$W/grub.tar.xz" http://archive.ubuntu.com/ubuntu/pool/main/g/grub2/grub2_2.14.orig.tar.xz \
+  || curl -fL -o "$W/grub.tar.xz" https://ftp.gnu.org/gnu/grub/grub-2.14.tar.xz
+tar -xJf "$W/grub.tar.xz" -C "$W/efifs/grub" --strip-components=1
+(cd "$W/efifs/grub" && patch -p1 < ../0001-GRUB-fixes.patch)
+# Older EDK2 keeps CompilerIntrinsicsLib in ArmPkg; Ubuntu's gcc turns the stack protector on by default.
+sed -i 's#MdePkg/Library/CompilerIntrinsicsLib/CompilerIntrinsicsLib.inf#ArmPkg/Library/CompilerIntrinsicsLib/CompilerIntrinsicsLib.inf#' "$W/efifs/EfiFsPkg.dsc"
+sed -i 's#^  \*_\*_\*_CC_FLAGS                 = -DDISABLE_NEW_DEPRECATED_INTERFACES#& -fno-stack-protector#' "$W/efifs/EfiFsPkg.dsc"
+rm -rf "$EDK2/EfiFsPkg"; mv "$W/efifs" "$EDK2/EfiFsPkg"
+# (after the move: the script creates an absolute symlink grub/include/grub/cpu)
+(cd "$EDK2/EfiFsPkg" && ./set_grub_cpu.sh aarch64)
+echo "EfiFsPkg ready in $EDK2/EfiFsPkg (needs libc6-dev-arm64-cross for Btrfs). Build the firmware with -D SWITCH_FSDRV=1 -D SWITCH_BIGFD=1"
diff --git a/Tools/test-fan-trace/compare.py b/Tools/test-fan-trace/compare.py
new file mode 100755
index 0000000..a2dada8
--- /dev/null
+++ b/Tools/test-fan-trace/compare.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Run hekate's real fan code and Drivers/FanDxe against the same fake register file and compare.
+
+usage: compare.py <trace_hekate> <trace_fan>
+
+What is checked, per scenario:
+  * the ordered list of register writes of FanDxe equals hekate's fan_set_duty() sequence once the
+    DELIBERATE differences are removed (tach pad/GPIO S7, USB_VBUS_EN0 pad/GPIO CC4, and writes that
+    do not change a register);
+  * the final value of every register that either side touched is identical (except the same
+    deliberate ones);
+  * the backlight PWM (CSR_0) and every GPIO bit that is not part of the fan are untouched;
+  * T210B01 and duty 0: FanDxe writes nothing.
+It passes or fails; it says nothing about the real board.
+"""
+import subprocess, sys, itertools
+
+CAR, GPIO, PINMUX, PWM, PMC = 0x60006000, 0x6000D000, 0x70003000, 0x7000A000, 0x7000E400
+ALIAS = {CAR + 0x300, CAR + 0x304, CAR + 0x320, CAR + 0x324}
+# registers hekate writes and FanDxe deliberately does not (see the header of FanDxe.c)
+OMIT = {
+    PINMUX + 0x1EC,                              # CAM1_PWDN pad (tachometer)
+    GPIO + 0x408, GPIO + 0x418,                  # GPIO S7 CNF / OE (tachometer)
+    PINMUX + 0x1A8,                              # USB_VBUS_EN0 pad
+    GPIO + 0x700, GPIO + 0x710, GPIO + 0x720,    # GPIO CC4 CNF / OE / OUT
+}
+# hekate clock_enable(&_clock_pwm), hand-derived from bdk/soc/clock.c clock_enable() and _clock_pwm
+CLK_PWM = [(CAR + 0x300, 1 << 17), (CAR + 0x324, 1 << 17), (CAR + 0x110, (6 << 29) | 4),
+           (CAR + 0x320, 1 << 17), (CAR + 0x304, 1 << 17)]
+
+def run(binary, args):
+    out = subprocess.run([binary] + args, capture_output=True, text=True, check=False)
+    if out.returncode != 0:
+        raise SystemExit(f"{binary} {args}: rc={out.returncode}\n{out.stderr}")
+    init, writes, final, status = {}, [], {}, None
+    for line in out.stdout.splitlines():
+        f = line.split()
+        if not f: continue
+        if f[0] == 'I': init[int(f[1], 16)] = int(f[2], 16)
+        elif f[0] == 'W': writes.append((int(f[1], 16), int(f[2], 16), int(f[3], 16)))
+        elif f[0] == 'S': final[int(f[1], 16)] = int(f[2], 16)
+        elif f[0] == '#' and len(f) > 2 and f[1] == 'status': status = int(f[2])
+    return init, writes, final, status
+
+def effective(writes, drop=()):
+    """Drop omitted registers and writes that do not change the register (the PMC read-modify-write
+    no-ops); keep the CAR set/clear aliases, whose effect is on another register."""
+    return [(a, v) for (a, v, old) in writes if a not in drop and (a in ALIAS or v != old)]
+
+def fmt(seq):
+    return "\n".join(f"    {a:08x} <= {v:08x}" for a, v in seq)
+
+def check(name, cond, detail=""):
+    if not cond:
+        print(f"  FAIL {name}\n{detail}")
+    return cond
+
+def scenario(hbin, fbin, label, fan_args, hek_args=None, expect_clock_enable=False,
+             expect_silent=False, expect_status=0):
+    hek_args = fan_args if hek_args is None else hek_args
+    ok = True
+    hi, hw, hf, _ = run(hbin, hek_args)
+    fi, fw, ff, fst = run(fbin, fan_args)
+    ok &= check("same initial state", hi == fi)
+    ok &= check(f"status {expect_status}", fst == expect_status, f"    got {fst}")
+    if expect_silent:
+        ok &= check("no register writes at all", not fw, fmt([(a, v) for a, v, _ in fw]))
+        ok &= check("final state == initial state", ff == fi)
+        print(f"{'PASS' if ok else 'FAIL'}  {label}")
+        return ok
+
+    ok &= check("FanDxe never writes an omitted register", not any(a in OMIT for a, _, _ in fw),
+                fmt([(a, v) for a, v, _ in fw if a in OMIT]))
+    hseq = effective(hw, drop=OMIT)
+    fseq = effective(fw)
+    if expect_clock_enable:
+        ok &= check("PWM clock bring-up == hekate clock_enable(&_clock_pwm)", fseq[:5] == CLK_PWM,
+                    "    mine:\n" + fmt(fseq[:5]) + "\n    expected:\n" + fmt(CLK_PWM))
+        fseq = fseq[5:]
+    ok &= check("write sequence == hekate fan_set_duty() minus deliberate omissions", fseq == hseq,
+                "    hekate:\n" + fmt(hseq) + "\n    FanDxe:\n" + fmt(fseq))
+    skip = set(OMIT)
+    if expect_clock_enable:
+        skip |= {CAR + 0x004, CAR + 0x010, CAR + 0x110}        # hekate does not touch them on Erista
+    diffs = [(a, hf.get(a), ff.get(a)) for a in sorted(set(hf) | set(ff)) if a not in skip and hf.get(a) != ff.get(a)]
+    ok &= check("final register state identical", not diffs,
+                "\n".join(f"    {a:08x} hekate={h} fandxe={f}" for a, h, f in diffs))
+    # independent invariants on the FanDxe result
+    duty = min(fan_args_duty(fan_args), 235)
+    ok &= check("PWM CSR_1 = EN | (236-duty)<<16", ff[PWM + 0x10] == 0x80000000 | ((236 - duty) << 16),
+                f"    {ff[PWM + 0x10]:08x}")
+    ok &= check("backlight PWM CSR_0 untouched", ff[PWM] == fi[PWM] and not any(a == PWM for a, _, _ in fw))
+    ok &= check("pinmux LCD_GPIO2 = 1 (PWM1), SATA_LED_ACTIVE = 1", ff[PINMUX + 0x20C] == 1 and ff[PINMUX + 0x4C] == 1)
+    ok &= check("USB_VBUS_EN0 pad untouched", ff[PINMUX + 0x1A8] == fi[PINMUX + 0x1A8])
+    # GPIO: only V4 (cnf cleared) and A5 (cnf/oe/out set) may differ
+    want = dict(fi)
+    want[GPIO + 0x504] &= ~(1 << 4)
+    for off in (0x000, 0x010, 0x020):
+        want[GPIO + off] |= (1 << 5)
+    gd = [(a, want[a], ff[a]) for a in sorted(ff) if GPIO <= a < GPIO + 0x800 and want[a] != ff[a]]
+    ok &= check("GPIO: only V4 -> SFIO and A5 -> output high changed", not gd,
+                "\n".join(f"    {a:08x} want={w:08x} got={g:08x}" for a, w, g in gd))
+    # PMC: bit 21 cleared, everything else preserved
+    for off in (0x44, 0xE4):
+        ok &= check(f"PMC+{off:#x}: bit 21 clear, other bits preserved",
+                    ff[PMC + off] == fi[PMC + off] & ~(1 << 21), f"    {ff[PMC + off]:08x}")
+    if not expect_clock_enable:
+        ok &= check("CAR untouched", all(ff[a] == fi[a] for a in (CAR + 4, CAR + 0x10, CAR + 0x110)))
+    else:
+        ok &= check("PWM clock ends enabled and out of reset",
+                    (ff[CAR + 0x10] >> 17) & 1 == 1 and (ff[CAR + 4] >> 17) & 1 == 0)
+    print(f"{'PASS' if ok else 'FAIL'}  {label}  ({len(fseq)} effective writes)")
+    return ok
+
+def fan_args_duty(args):
+    for a in args:
+        if a.startswith('--duty='): return int(a[7:], 0)
+    return 76
+
+def main():
+    hbin, fbin = sys.argv[1], sys.argv[2]
+    results = []
+    for duty, pmc, grand, seed in itertools.product((1, 51, 76, 102, 235), (0, 1), (0, 1), (7, 12345)):
+        if not grand and seed != 7: continue            # zero-filled GPIO does not depend on the seed
+        a = [f"--duty={duty}", f"--pmc-bits={pmc}", f"--gpio-rand={grand}", f"--seed={seed}"]
+        results.append(scenario(hbin, fbin, f"Erista duty={duty:3d} pmc_bits={pmc} gpio_rand={grand} seed={seed}", a))
+    # PWM clock off: FanDxe brings it up exactly as hekate's clock_enable() would
+    for state, text in (("off", "clock off + in reset"), ("rst", "clock on but held in reset"),
+                        ("noclk", "clock off, not in reset")):
+        for grand in (0, 1):
+            a = ["--duty=76", f"--pwm-clk={state}", f"--gpio-rand={grand}", "--pmc-bits=1"]
+            results.append(scenario(hbin, fbin, f"Erista duty=76 PWM {text}, gpio_rand={grand}", a,
+                                    expect_clock_enable=True))
+    # PCD is UINT8: 255 is clamped to 235 (hekate itself clamps at 236, which means "off", so compare with 235)
+    results.append(scenario(hbin, fbin, "Erista duty=255 -> clamped to 235",
+                            ["--duty=255"], hek_args=["--duty=235"]))
+    # must stay silent
+    results.append(scenario(hbin, fbin, "T210B01 (Mariko) -> no writes", ["--duty=76", "--hidrev=0x00012120"],
+                            expect_silent=True, expect_status=3))
+    results.append(scenario(hbin, fbin, "duty=0 -> no writes", ["--duty=0"], hek_args=["--duty=76"],
+                            expect_silent=True, expect_status=0))
+    n_ok = sum(results)
+    print(f"\n{n_ok}/{len(results)} scenarios passed")
+    sys.exit(0 if n_ok == len(results) else 1)
+
+main()
diff --git a/Tools/test-fan-trace/main_fan.cpp b/Tools/test-fan-trace/main_fan.cpp
new file mode 100644
index 0000000..163b4f8
--- /dev/null
+++ b/Tools/test-fan-trace/main_fan.cpp
@@ -0,0 +1,27 @@
+// Runs the real Drivers/FanDxe/FanDxe.c and Library/GpioLib/GpioLib.c (compiled as C++ unchanged, with the
+// EDK2 headers they need replaced by tiny shims) against the same fake register file.
+#include <cstdarg>
+#include "scenario.hpp"
+#include <Uefi.h>
+
+uint8_t            g_pcd_duty = 0;
+static EFI_BOOT_SERVICES g_bs;
+EFI_BOOT_SERVICES *gBS = &g_bs;
+
+void shim_debug (unsigned level, const char *fmt, ...) {
+  va_list ap; va_start (ap, fmt);
+  fprintf (stderr, "[DEBUG %02x] ", level); vfprintf (stderr, fmt, ap);
+  va_end (ap);
+}
+
+extern EFI_STATUS FanDxeInitialize (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable);
+
+int main (int argc, char **argv) {
+  Scenario s = parse_scenario (argc, argv);
+  prefill_registers (s);
+  g_pcd_duty = (uint8_t) s.duty;
+  EFI_STATUS st = FanDxeInitialize (nullptr, nullptr);
+  dump_trace ("fandxe", s);
+  printf ("# status %llu\n", (unsigned long long) st);
+  return 0;
+}
diff --git a/Tools/test-fan-trace/main_hekate.cpp b/Tools/test-fan-trace/main_hekate.cpp
new file mode 100644
index 0000000..56b4e84
--- /dev/null
+++ b/Tools/test-fan-trace/main_hekate.cpp
@@ -0,0 +1,27 @@
+// Runs hekate's real fan_set_duty() (bdk/thermal/fan.c + power/regulator_5v.c + soc/gpio.c, compiled as
+// C++ unchanged) against the fake register file and prints the register writes.
+#include <utils/types.h>
+#include <thermal/fan.h>
+#include <soc/hw_init.h>
+#include <soc/fuse.h>
+#include <soc/clock.h>
+#include <soc/timer.h>
+#include <soc/t210.h>
+#include "scenario.hpp"
+
+// Stand-ins for the parts of hekate that are not under test.
+u32  hw_get_chip_id () {                     // same logic as bdk/soc/hw_init.c
+  return (((u32) *(vu32 *)(APB_MISC_BASE + APB_MISC_GP_HIDREV) >> 4) & 0xF) >= GP_HIDREV_MAJOR_T210B01
+         ? GP_HIDREV_MAJOR_T210B01 : GP_HIDREV_MAJOR_T210;
+}
+u32  fuse_read_hw_type () { return FUSE_NX_HW_TYPE_ICOSA; }   // Erista; clock_enable_pwm() is Aula-only
+void clock_enable_pwm () { fprintf (stderr, "hekate side: clock_enable_pwm() called (Aula only!)\n"); exit (3); }
+u32  get_tmr_us () { return 0; }
+
+int main (int argc, char **argv) {
+  Scenario s = parse_scenario (argc, argv);
+  prefill_registers (s);
+  fan_set_duty (s.duty);
+  dump_trace ("hekate", s);
+  return 0;
+}
diff --git a/Tools/test-fan-trace/mutation-test.py b/Tools/test-fan-trace/mutation-test.py
new file mode 100755
index 0000000..dc24dd5
--- /dev/null
+++ b/Tools/test-fan-trace/mutation-test.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Mutation test for the fan trace harness: inject known bugs into a copy of FanDxe.c and check that
+compare.py notices each one.  HEKATE_DIR=/path/to/hekate Tools/test-fan-trace/mutation-test.py
+
+Expected result: every mutant is CAUGHT except the control (unchanged file) and "no final PWM1 pinmux
+write", an equivalent mutant: on the first call that second write stores the value the pad already has.
+"""
+import os, pathlib, subprocess, sys, tempfile
+
+HERE = pathlib.Path(__file__).resolve().parent
+PKG = HERE.parent.parent
+HEKATE = pathlib.Path(os.environ["HEKATE_DIR"])
+CXX = ["g++", "-std=gnu++17", "-x", "c++", "-fpermissive", "-w", "-O1"]
+src = (PKG / "Drivers/FanDxe/FanDxe.c").read_text()
+
+M = [
+ ("CONTROL (no change)", "FAN_PWM_PARK                   0x100", "FAN_PWM_PARK                   0x100"),
+ ("pulse shift 16->15", "#define PWM_CSR_PULSE_SHIFT            16", "#define PWM_CSR_PULSE_SHIFT            15"),
+ ("fan pad port V->U", "gpio_config (GPIO_PORT_V, GPIO_PIN_4, GPIO_MODE_SPIO)", "gpio_config (GPIO_PORT_U, GPIO_PIN_4, GPIO_MODE_SPIO)"),
+ ("fan pad pin 4->3", "gpio_config (GPIO_PORT_V, GPIO_PIN_4, GPIO_MODE_SPIO)", "gpio_config (GPIO_PORT_V, GPIO_PIN_3, GPIO_MODE_SPIO)"),
+ ("LCD_GPIO2 offset 0x20C->0x208", "#define PINMUX_AUX_LCD_GPIO2           0x20C", "#define PINMUX_AUX_LCD_GPIO2           0x208"),
+ ("SATA_LED offset 0x4C->0x48", "#define PINMUX_AUX_SATA_LED_ACTIVE     0x4C ", "#define PINMUX_AUX_SATA_LED_ACTIVE     0x48 "),
+ ("drop PWM park write", "  PWM (PWM_CONTROLLER_PWM_CSR_1) = PWM_CSR_EN | (FAN_PWM_PARK << PWM_CSR_PULSE_SHIFT);\n", ""),
+ ("gpio order: oe before out", "  gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_HIGH);\n  gpio_output_enable (GPIO_PORT_A, GPIO_PIN_5, GPIO_OUTPUT_ENABLE);", "  gpio_output_enable (GPIO_PORT_A, GPIO_PIN_5, GPIO_OUTPUT_ENABLE);\n  gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_HIGH);"),
+ ("A5 driven low", "gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_HIGH)", "gpio_write         (GPIO_PORT_A, GPIO_PIN_5, GPIO_LOW)"),
+ ("PMC clobbers other bits", "PMC (APBDEV_PMC_NO_IOPOWER) = Value & ~PMC_GPIO_BIT;", "PMC (APBDEV_PMC_NO_IOPOWER) = 0;"),
+ ("PMC bit 21->20", "#define PMC_GPIO_BIT                   (1U << 21)", "#define PMC_GPIO_BIT                   (1U << 20)"),
+ ("duty scale 236->235", "#define FAN_DUTY_SCALE                 236", "#define FAN_DUTY_SCALE                 235"),
+ ("non-inverted duty", "InvDuty = FAN_DUTY_SCALE - Duty;", "InvDuty = Duty;"),
+ ("touch CC4 (USB VBUS pad)", "  PINMUX_AUX (PINMUX_AUX_SATA_LED_ACTIVE) = 1;\n", "  PINMUX_AUX (PINMUX_AUX_SATA_LED_ACTIVE) = 1;\n  gpio_write (GPIO_PORT_CC, GPIO_PIN_4, GPIO_LOW);\n"),
+ ("touch backlight CSR_0", "  PWM (PWM_CONTROLLER_PWM_CSR_1) = PWM_CSR_EN | (InvDuty << PWM_CSR_PULSE_SHIFT);", "  PWM (0x00) = PWM_CSR_EN;\n  PWM (PWM_CONTROLLER_PWM_CSR_1) = PWM_CSR_EN | (InvDuty << PWM_CSR_PULSE_SHIFT);"),
+ ("no final PWM1 pinmux write", "  PINMUX_AUX (PINMUX_AUX_LCD_GPIO2) = 1;                // enable fan\n", ""),
+ ("clock source wrong", "((6U << 29) | 4U)", "((6U << 29) | 2U)"),
+ ("chip check inverted", "!= GP_HIDREV_MAJOR_T210)", "== GP_HIDREV_MAJOR_T210)"),
+ ("no clamp", "  if (Duty > FAN_DUTY_MAX) {\n    Duty = FAN_DUTY_MAX;\n  }\n", ""),
+ ("PWM clock check ignores enable bit", "return ((CLOCK (CLK_RST_CLK_OUT_ENB_L) & CLK_L_PWM_BIT) != 0) &&", "return TRUE &&"),
+ ("PWM clock check ignores reset", "((CLOCK (CLK_RST_RST_DEVICES_L) & CLK_L_PWM_BIT) == 0)", "TRUE"),
+]
+
+tmp = pathlib.Path(tempfile.mkdtemp())
+subprocess.run(CXX + ["-I", str(HERE / "shim/hekate"), "-I", str(HERE / "shim/common"), "-I", str(HEKATE / "bdk"),
+                      str(HERE / "main_hekate.cpp"), str(HERE / "regmodel.cpp"),
+                      str(HEKATE / "bdk/thermal/fan.c"), str(HEKATE / "bdk/power/regulator_5v.c"), str(HEKATE / "bdk/soc/gpio.c"),
+                      "-o", str(tmp / "trace_hekate")], check=True)
+unexpected = 0
+for name, old, new in M:
+    assert src.count(old) == 1, (name, src.count(old))
+    (tmp / "FanDxe.c").write_text(src.replace(old, new))
+    r = subprocess.run(CXX + ["-I", str(HERE / "shim/edk2"), "-I", str(HERE / "shim/common"), "-I", str(PKG / "Include"),
+                              str(HERE / "main_fan.cpp"), str(HERE / "regmodel.cpp"), str(tmp / "FanDxe.c"),
+                              str(PKG / "Library/GpioLib/GpioLib.c"), "-o", str(tmp / "trace_mut")],
+                       capture_output=True, text=True)
+    if r.returncode:
+        print("COMPILE-ERR", name, r.stderr[:200]); unexpected += 1; continue
+    c = subprocess.run([sys.executable, str(HERE / "compare.py"), str(tmp / "trace_hekate"), str(tmp / "trace_mut")],
+                       capture_output=True, text=True)
+    caught = c.returncode != 0
+    summary = [l for l in c.stdout.splitlines() if "scenarios passed" in l]
+    expected_pass = name.startswith("CONTROL") or name == "no final PWM1 pinmux write"
+    flag = "ok " if caught != expected_pass else "BAD"
+    unexpected += (caught == expected_pass)
+    print(f"{flag} {'CAUGHT' if caught else 'passed'}  {name:34s} {summary[0] if summary else ''}")
+print("unexpected results:", unexpected)
+sys.exit(1 if unexpected else 0)
diff --git a/Tools/test-fan-trace/regmodel.cpp b/Tools/test-fan-trace/regmodel.cpp
new file mode 100644
index 0000000..8401df1
--- /dev/null
+++ b/Tools/test-fan-trace/regmodel.cpp
@@ -0,0 +1,116 @@
+// Register file + trace recorder + scenario set-up for the fan trace test.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+#include "regmodel.hpp"
+#include "scenario.hpp"
+
+namespace {
+const uint64_t CAR = 0x60006000;
+const uint64_t GPIO = 0x6000D000;
+const uint64_t PINMUX = 0x70003000;
+const uint64_t APB_MISC = 0x70000000;
+const uint64_t PWM = 0x7000A000;
+const uint64_t PMC = 0x7000E400;
+
+struct Event { char kind; uint64_t addr; uint32_t val; uint32_t old; };
+std::map<uint64_t, uint32_t> g_val;
+std::map<uint64_t, uint32_t> g_init;
+std::vector<Event> g_ev;
+bool g_recording = false;
+
+uint32_t cur (uint64_t a) { auto it = g_val.find (a); return it == g_val.end () ? 0 : it->second; }
+}
+
+uint32_t reg_read (uint64_t a) {
+  uint32_t v = cur (a);
+  if (g_recording) g_ev.push_back ({'R', a, v, v});
+  return v;
+}
+
+void reg_write (uint64_t a, uint32_t v) {
+  uint32_t old = cur (a);
+  if (g_recording) g_ev.push_back ({'W', a, v, old});
+  // Tegra CAR write-1-to-set / write-1-to-clear aliases of RST_DEVICES_L and CLK_OUT_ENB_L.
+  if      (a == CAR + 0x300) g_val[CAR + 0x004] = cur (CAR + 0x004) |  v;
+  else if (a == CAR + 0x304) g_val[CAR + 0x004] = cur (CAR + 0x004) & ~v;
+  else if (a == CAR + 0x320) g_val[CAR + 0x010] = cur (CAR + 0x010) |  v;
+  else if (a == CAR + 0x324) g_val[CAR + 0x010] = cur (CAR + 0x010) & ~v;
+  else                       g_val[a] = v;
+}
+
+static uint32_t xorshift (uint32_t &s) { s ^= s << 13; s ^= s >> 17; s ^= s << 5; return s; }
+
+Scenario parse_scenario (int argc, char **argv) {
+  Scenario s;
+  for (int i = 1; i < argc; i++) {
+    const char *a = argv[i];
+    if      (!strncmp (a, "--duty=", 7))    s.duty = strtoul (a + 7, 0, 0);
+    else if (!strncmp (a, "--hidrev=", 9))  s.hidrev = strtoul (a + 9, 0, 0);
+    else if (!strncmp (a, "--pwm-clk=", 10)) {
+      const char *v = a + 10;
+      s.pwm_clk = !strcmp (v, "on") ? 1 : !strcmp (v, "off") ? 2 : !strcmp (v, "rst") ? 3 : !strcmp (v, "noclk") ? 0 : -1;
+      if (s.pwm_clk < 0) { fprintf (stderr, "bad --pwm-clk\n"); exit (2); }
+    }
+    else if (!strncmp (a, "--pmc-bits=", 11)) s.pmc_bits = !strcmp (a + 11, "1");
+    else if (!strncmp (a, "--gpio-rand=", 12)) s.gpio_rand = !strcmp (a + 12, "1");
+    else if (!strncmp (a, "--seed=", 7))    s.seed = strtoul (a + 7, 0, 0);
+    else { fprintf (stderr, "bad arg %s\n", a); exit (2); }
+  }
+  return s;
+}
+
+void prefill_registers (const Scenario &s) {
+  g_recording = false;
+  g_val.clear (); g_ev.clear ();
+  uint32_t r = s.seed ? s.seed : 1;
+
+  // identity
+  g_val[APB_MISC + 0x804] = s.hidrev;
+
+  // clocks: other peripherals running, PWM per scenario
+  uint32_t enb = 0x3A00A5C0 & ~(1u << 17), rst = 0x04000100 & ~(1u << 17);
+  if (s.pwm_clk & 1) enb |= (1u << 17);         // clock enabled
+  if (s.pwm_clk & 2) rst |= (1u << 17);         // block held in reset
+  g_val[CAR + 0x010] = enb;
+  g_val[CAR + 0x004] = rst;
+  g_val[CAR + 0x110] = 0x12345678;            // PWM clock source register: junk that must be replaced if touched
+
+  // GPIO controller
+  for (uint64_t off = 0; off < 0x800; off += 4)
+    g_val[GPIO + off] = s.gpio_rand ? xorshift (r) : 0;
+
+  // pinmux: the pads this test cares about get a "PinMuxDxe-like" non-trivial value
+  g_val[PINMUX + 0x20C] = 0x00000001 | (1u << 6);     // LCD_GPIO2
+  g_val[PINMUX + 0x4C]  = (2u << 2) | (1u << 6);      // SATA_LED_ACTIVE: pull-up + input (see PinMux.h)
+  g_val[PINMUX + 0x1A8] = 0x00000041;                 // USB_VBUS_EN0 on the USB function
+  g_val[PINMUX + 0x1EC] = 0x00000050;                 // CAM1_PWDN (tach)
+
+  // PWM: backlight (CSR_0) is running and must survive; CSR_1 = reset value
+  g_val[PWM + 0x00] = 0x80000000u | (200u << 16) | 0x1234;
+  g_val[PWM + 0x10] = 0;
+
+  // PMC: unrelated bits set so read-modify-write preservation is visible
+  uint32_t noio = 0x0A5A5A5A & ~(1u << 21), det = 0x00C3C3C3 & ~(1u << 21);
+  if (s.pmc_bits) { noio |= (1u << 21); det |= (1u << 21); }
+  g_val[PMC + 0x44] = noio;
+  g_val[PMC + 0xE4] = det;
+
+  g_init = g_val;
+  g_recording = true;
+}
+
+void dump_trace (const char *who, const Scenario &s) {
+  printf ("# %s duty=%u hidrev=0x%08x pwm_clk=%s pmc_bits=%d gpio_rand=%d seed=%u\n",
+          who, s.duty, s.hidrev, s.pwm_clk == 1 ? "on" : s.pwm_clk == 2 ? "off" : s.pwm_clk == 3 ? "rst" : "noclk", s.pmc_bits, s.gpio_rand, s.seed);
+  for (auto &kv : g_init)
+    printf ("I %08llx %08x\n", (unsigned long long)kv.first, kv.second);
+  for (auto &e : g_ev)
+    if (e.kind == 'W') printf ("W %08llx %08x %08x\n", (unsigned long long)e.addr, e.val, e.old);
+  for (auto &kv : g_val)
+    printf ("S %08llx %08x\n", (unsigned long long)kv.first, kv.second);
+}
diff --git a/Tools/test-fan-trace/run.sh b/Tools/test-fan-trace/run.sh
