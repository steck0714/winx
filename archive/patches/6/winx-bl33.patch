index 0000000..7680979
--- /dev/null
+++ b/Tools/test-fan-trace/run.sh
@@ -0,0 +1,25 @@
+#!/bin/bash
+# Host-side check of Drivers/FanDxe against hekate's own fan driver.
+#
+#   HEKATE_DIR=/path/to/hekate  Tools/test-fan-trace/run.sh
+#
+# Needs g++ and python3, no hardware and no EDK2. hekate must be a checkout of CTCaer/hekate
+# (the sources used are bdk/thermal/fan.c, bdk/power/regulator_5v.c, bdk/soc/gpio.c).
+set -eu
+HERE=$(cd "$(dirname "$0")" && pwd)
+PKG=$(cd "$HERE/../.." && pwd)
+: "${HEKATE_DIR:?set HEKATE_DIR to a hekate checkout}"
+OUT=${OUT_DIR:-$(mktemp -d)}
+CXX="g++ -std=gnu++17 -x c++ -fpermissive -w -O1"
+
+$CXX -I "$HERE/shim/hekate" -I "$HERE/shim/common" -I "$HEKATE_DIR/bdk" \
+     "$HERE/main_hekate.cpp" "$HERE/regmodel.cpp" \
+     "$HEKATE_DIR/bdk/thermal/fan.c" "$HEKATE_DIR/bdk/power/regulator_5v.c" "$HEKATE_DIR/bdk/soc/gpio.c" \
+     -o "$OUT/trace_hekate"
+
+$CXX -I "$HERE/shim/edk2" -I "$HERE/shim/common" -I "$PKG/Include" \
+     "$HERE/main_fan.cpp" "$HERE/regmodel.cpp" \
+     "$PKG/Drivers/FanDxe/FanDxe.c" "$PKG/Library/GpioLib/GpioLib.c" \
+     -o "$OUT/trace_fan"
+
+exec python3 "$HERE/compare.py" "$OUT/trace_hekate" "$OUT/trace_fan"
diff --git a/Tools/test-fan-trace/shim/common/regmodel.hpp b/Tools/test-fan-trace/shim/common/regmodel.hpp
new file mode 100644
index 0000000..1fadcf0
--- /dev/null
+++ b/Tools/test-fan-trace/shim/common/regmodel.hpp
@@ -0,0 +1,20 @@
+// Fake MMIO register file shared by the hekate-side and the FanDxe-side test programs.
+//
+// Register accesses in both code bases look like  *(vu32 *)(base + off) = v  /  |= /  &=  /  (read).
+// The shims make `vu32` a class WITHOUT data members: the "object" is only ever used through its
+// address, which is the register address, so no memory is touched and no mmap is needed.
+#pragma once
+#include <cstdint>
+
+uint32_t reg_read (uint64_t addr);
+void     reg_write (uint64_t addr, uint32_t value);
+
+struct vu32 {
+  uint64_t addr () const { return (uint64_t)(uintptr_t)this; }
+  operator uint32_t () const { return reg_read (addr ()); }
+  vu32 &operator= (uint32_t v) { reg_write (addr (), v); return *this; }
+  vu32 &operator= (const vu32 &o) { uint32_t v = o; reg_write (addr (), v); return *this; }
+  vu32 &operator|= (uint32_t v) { reg_write (addr (), reg_read (addr ()) | v); return *this; }
+  vu32 &operator&= (uint32_t v) { reg_write (addr (), reg_read (addr ()) & v); return *this; }
+  vu32 &operator^= (uint32_t v) { reg_write (addr (), reg_read (addr ()) ^ v); return *this; }
+};
