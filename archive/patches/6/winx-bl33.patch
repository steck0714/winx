+INT64
+DaysFromCivil (
+  IN INT64  Year,
+  IN UINTN  Month,    // 1..12
+  IN UINTN  Day       // 1..31
+  )
+{
+	INT64  Era;
+	INT64  Yoe;
+	INT64  Doy;
