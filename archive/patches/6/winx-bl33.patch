+/** @file
+  WifiPcie.h - low level part of the BCM4356 Wi-Fi bring-up over PCIe (Tegra210 PCIe controller, port index 1 / "pci@2,0", lane pcie-0).
+
+  The Switch's Wi-Fi is NOT SDIO: switch-linux's defconfig has CONFIG_BRCMFMAC_PCIE=y, CONFIG_BRCMFMAC_SDIO unset, and the firmware names
+  brcm/brcmfmac4356-pcie.{bin,txt}; its DTS enables the x1 root port (pci@2,0 with phy pcie-0) next to an (empty) x4 port.
+
+  Everything here is ported from Linux (GPL-2.0): drivers/pci/controller/pci-tegra.c, drivers/phy/tegra/xusb-tegra210.c (UPHY PLL, pcie lanes),
+  drivers/clk/tegra/{clk-pll.c,clk-tegra210.c} (PLLE + HW sequencer), drivers/soc/tegra/pmc.c (power gate, IO pad DPD) and
+  drivers/net/wireless/broadcom/brcm80211/brcmfmac/{pcie.c,chip.c,firmware.c}.
+
+  DRAFT, UNTESTED.  ALL accesses are naturally aligned 32-bit MMIO.  This file is #included by WifiBt.c (single translation unit) after Log/Rd/Wr/Us/Ms.
+**/
+
+// ---------------------------------------------------------------------------------------------
+// Register map
+// ---------------------------------------------------------------------------------------------
+#define PEX_PADS          0x01003000
+#define PEX_AFI           0x01003800
+#define PEX_CS            0x02000000          // configuration space window (4 KiB used)
+#define PEX_RP_BASE       0x01000000          // root port N config space = base + N * 0x1000
+#define PEX_PORT          1                   // port index 1 == "pci@2,0" == x1 lane pcie-0 (Wi-Fi)
+#define PEX_MEM_BASE      0x13000000          // non-prefetchable window (AXI), identity mapped to FPCI
+#define PEX_MEM_SIZE      0x0D000000
+
+#define AFI_AXI_BAR0_SZ     0x00
+#define AFI_AXI_BAR3_SZ     0x0C
+#define AFI_AXI_BAR4_SZ     0x10
+#define AFI_AXI_BAR5_SZ     0x14
+#define AFI_AXI_BAR0_START  0x18
+#define AFI_AXI_BAR3_START  0x24
+#define AFI_AXI_BAR4_START  0x28
+#define AFI_AXI_BAR5_START  0x2C
+#define AFI_FPCI_BAR0       0x30
+#define AFI_FPCI_BAR3       0x3C
+#define AFI_FPCI_BAR4       0x40
+#define AFI_FPCI_BAR5       0x44
+#define AFI_MSI_BAR_SZ      0x60
+#define AFI_MSI_FPCI_BAR_ST 0x64
+#define AFI_MSI_AXI_BAR_ST  0x68
+#define AFI_CONFIGURATION   0x0AC
+#define AFI_FPCI_ERR_MASKS  0x0B0
+#define AFI_INTR_MASK       0x0B4
+#define AFI_INTR_CODE       0x0B8
+#define AFI_INTR_SIGNATURE  0x0BC
+#define AFI_SM_INTR_ENABLE  0x0C4
+#define AFI_AFI_INTR_ENABLE 0x0C8
+#define AFI_PCIE_CONFIG     0x0F8
+#define AFI_FUSE            0x104
+#define AFI_PEX0_CTRL       0x110
+#define AFI_PEX1_CTRL       0x118
+#define AFI_PEXBIAS_CTRL_0  0x168
+
+#define PADS_REFCLK_CFG0    0x0C8
+
+// Root port (offsets inside the port's 4 KiB config space)
+#define RP_ECTL_2_R1        0xE84
+#define RP_ECTL_4_R1        0xE8C
+#define RP_ECTL_5_R1        0xE90
+#define RP_ECTL_6_R1        0xE94
+#define RP_ECTL_2_R2        0xEA4
+#define RP_ECTL_4_R2        0xEAC
+#define RP_ECTL_5_R2        0xEB0
+#define RP_ECTL_6_R2        0xEB4
+#define RP_VEND_XP          0xF00
+#define RP_VEND_CTL0        0xF44
+#define RP_VEND_CTL1        0xF48
+#define RP_VEND_XP_BIST     0xF4C
+#define RP_VEND_CTL2        0xFA8
+#define RP_PRIV_MISC        0xFE0
+#define RP_LINK_CTL_STATUS  0x090
+#define RP_LINK_CTL_STATUS2 0x0B0
+
+// CAR
+#define PX_CAR_PLLE_BASE    0x0E8
+#define PX_CAR_PLLE_MISC    0x0EC
+#define PX_CAR_PLLE_SS      0x068
+#define PX_CAR_PLLE_AUX     0x48C
+#define PX_CAR_XUSBIO_PLL   0x51C
+#define PX_CAR_OSC_CTRL     0x050
+#define PX_CAR_RST_U_SET    0x310
+#define PX_CAR_RST_U_CLR    0x314
+#define PX_CAR_ENB_U_SET    0x330
+#define PX_CAR_ENB_U_CLR    0x334
+#define PX_CAR_RST_W        0x35C
+#define PX_CAR_ENB_W        0x364
+#define PX_CAR_RST_W_SET    0x438
+#define PX_CAR_RST_W_CLR    0x43C
+#define PX_CAR_ENB_W_SET    0x448
+#define PX_CAR_RST_Y        0x2A4
+#define PX_CAR_RST_Y_CLR    0x2AC
+#define PX_U_PEX            BIT6                // clk 70 "pcie" / reset 70
+#define PX_U_AFI            BIT8                // clk 72 "afi"  / reset 72
+#define PX_U_PCIEX          BIT10               // reset 74 "pcie_x"
+#define PX_W_PADCTL         BIT14               // reset 142
+#define PX_W_XUSB           BIT15               // clk/reset 143 (xusb gate)
+#define PX_Y_UPHY           BIT13               // reset 205 PEX_USB_UPHY
+
+// PMC
+#define PX_PMC              0x7000E400
+#define PX_PMC_DPD_SAMPLE   0x020
+#define PX_PMC_PG_TOGGLE    0x030
+#define PX_PMC_PG_CLAMP     0x034
+#define PX_PMC_PG_STATUS    0x038
+#define PX_PMC_IO_DPD_REQ   0x1B8
+#define PX_PMC_IO_DPD_STS   0x1BC
+#define PX_PMC_SEL_DPD_TIM  0x1C8
+#define PX_PG_PCIE          3
+
+// XUSB padctl (UPHY lives here)
+#define PX_PADCTL           0x7009F000
+#define PAD_ELPG_PROGRAM1   0x024
+#define PAD_USB3_PAD_MUX    0x028
+#define PAD_UPHY_PLL_P0_1   0x360
+#define PAD_UPHY_PLL_P0_2   0x364
+#define PAD_UPHY_PLL_P0_4   0x36C
+#define PAD_UPHY_PLL_P0_5   0x370
+#define PAD_UPHY_PLL_P0_8   0x37C
+
+// BCM4356 / brcmfmac PCIe
+#define BCM_BAR0_WINDOW     0x80                // config register: backplane window for the 4 KiB at BAR0+0
+#define BCM_CC_BASE         0x18000000
+#define BCM_ARMCR4_ID       0x83E
+#define BCM_RAMBASE_4356    0x180000
+#define BRCMF_SHARED_CONSOLE_ADDR_OFFSET 20
+#define BRCMF_SHARED_MAX_RXBUFPOST_OFFSET 34
+#define BRCMF_SHARED_RX_DATAOFFSET_OFFSET 36
+#define BRCMF_SHARED_HTOD_MB_OFFSET       40
+#define BRCMF_SHARED_DTOH_MB_OFFSET       44
+#define BRCMF_SHARED_RING_INFO_OFFSET     48
+
+// ---------------------------------------------------------------------------------------------
+// State
+// ---------------------------------------------------------------------------------------------
+STATIC BOOLEAN  mPcieMode  = FALSE;   // Sb* helpers go through PCIe BAR0 window instead of SDIO
+STATIC BOOLEAN  mPexUp     = FALSE;   // controller + link up
+STATIC BOOLEAN  mPexEnum   = FALSE;   // endpoint BARs assigned
+STATIC UINTN    mBar0      = 0;
+STATIC UINTN    mBar2      = 0;
+STATIC UINT32   mBar0Size  = 0;
+STATIC UINT32   mBar2Size  = 0;
+STATIC UINT32   mBpWin     = 0xFFFFFFFF;
+STATIC UINT32   mPexRstRun = 1;       // level of WIFI_RST (PH1) that means "chip running"
+STATIC UINT32   mPexGen2   = 0;       // retrain to Gen2 after link-up (default: stay Gen1)
+STATIC UINT32   mUphyLanes = BIT0;    // PEX lanes whose IDDQ is released (lane0 = Wi-Fi). USB3 will need lanes 5/6.
+
+STATIC
+VOID
+Rm (
+  IN UINTN   B,
+  IN UINTN   O,
+  IN UINT32  Clr,
+  IN UINT32  Set
+  )
+{
+  Wr (B, O, (Rd (B, O) & ~Clr) | Set);
+}
+
+STATIC
+BOOLEAN
+WaitBits (
+  IN UINTN   B,
+  IN UINTN   O,
+  IN UINT32  Mask,
+  IN UINT32  Val,
+  IN UINTN   TimeoutUs
+  )
+{
+  UINTN  T;
+
+  for (T = 0; T < TimeoutUs; T += 10) {
+    if ((Rd (B, O) & Mask) == Val) {
+      return TRUE;
+    }
+    Us (10);
+  }
+  return (Rd (B, O) & Mask) == Val;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Diagnostics
+// ---------------------------------------------------------------------------------------------
+STATIC
+VOID
+PexDumpAfi (
+  IN CONST CHAR16  *Tag
+  )
+{
+  Log (L"pex[%s]: AFI_CONFIG=%08x PCIE_CONFIG=%08x PEX1_CTRL=%08x INTR_CODE=%08x SIG=%08x FPCI_BAR0=%08x",
+       Tag, Rd (PEX_AFI, AFI_CONFIGURATION), Rd (PEX_AFI, AFI_PCIE_CONFIG), Rd (PEX_AFI, AFI_PEX1_CTRL),
+       Rd (PEX_AFI, AFI_INTR_CODE), Rd (PEX_AFI, AFI_INTR_SIGNATURE), Rd (PEX_AFI, AFI_FPCI_BAR0));
+}
+
+STATIC
+VOID
+PexDumpCar (
+  IN CONST CHAR16  *Tag
+  )
+{
+  Log (L"car[%s]: ENB_U=%08x RST_U=%08x ENB_W=%08x RST_W=%08x RST_Y=%08x PLLE_BASE=%08x MISC=%08x AUX=%08x XUSBIO=%08x OSC=%08x",
+       Tag, Rd (CAR_BASE, CAR_ENB_U), Rd (CAR_BASE, CAR_RST_U), Rd (CAR_BASE, PX_CAR_ENB_W), Rd (CAR_BASE, PX_CAR_RST_W),
+       Rd (CAR_BASE, PX_CAR_RST_Y), Rd (CAR_BASE, PX_CAR_PLLE_BASE), Rd (CAR_BASE, PX_CAR_PLLE_MISC), Rd (CAR_BASE, PX_CAR_PLLE_AUX),
+       Rd (CAR_BASE, PX_CAR_XUSBIO_PLL), Rd (CAR_BASE, PX_CAR_OSC_CTRL));
+}
+
+// ---------------------------------------------------------------------------------------------
+// PMC: power gate + IO pad DPD
+// ---------------------------------------------------------------------------------------------
+STATIC
+BOOLEAN
+PexPgOn (
+  IN UINT32  Id
+  )
+{
+  UINTN  I;
+
+  if (Rd (PX_PMC, PX_PMC_PG_STATUS) & (1U << Id)) {
+    Log (L"pg: partition %d already on", Id);
+  } else {
+    Wr (PX_PMC, PX_PMC_PG_TOGGLE, BIT8 | Id);
+    for (I = 0; I < 200; I++) {
+      if (Rd (PX_PMC, PX_PMC_PG_STATUS) & (1U << Id)) {
+        break;
+      }
+      Us (100);
+    }
+    if (!(Rd (PX_PMC, PX_PMC_PG_STATUS) & (1U << Id))) {
+      Log (L"pg: partition %d did not power on (STATUS=%08x)", Id, Rd (PX_PMC, PX_PMC_PG_STATUS));
+      return FALSE;
+    }
+    Us (10);
+  }
+  Wr (PX_PMC, PX_PMC_PG_CLAMP, 1U << Id);
+  Us (10);
+  Log (L"pg: partition %d on, STATUS=%08x", Id, Rd (PX_PMC, PX_PMC_PG_STATUS));
+  return TRUE;
+}
+
+// pex-bias (bit4), pex-clk1 (bit5), pex-clk2 (bit6): leave deep power down.
+STATIC
+BOOLEAN
+PexIoPadsOn (
+  VOID
+  )
+{
+  UINT32  Mask = BIT4 | BIT5 | BIT6;
+  BOOLEAN Ok;
+
+  Wr (PX_PMC, PX_PMC_DPD_SAMPLE, 1);
+  Wr (PX_PMC, PX_PMC_SEL_DPD_TIM, 0x7F);
+  Wr (PX_PMC, PX_PMC_IO_DPD_REQ, BIT30 | Mask);          // CODE_OFF = power the pads
+  Ok = WaitBits (PX_PMC, PX_PMC_IO_DPD_STS, Mask, 0, 250000);
+  Wr (PX_PMC, PX_PMC_DPD_SAMPLE, 0);
+  Log (L"pmc: IO pads pex-bias/clk1/clk2 %s (DPD_STS=%08x)", Ok ? L"on" : L"STILL IN DPD", Rd (PX_PMC, PX_PMC_IO_DPD_STS));
+  return Ok;
+}
+
+// ---------------------------------------------------------------------------------------------
+// PLLE (software enable) + hardware sequencer  (clk_plle_tegra210_enable / tegra210_plle_hw_sequence_start)
+// ---------------------------------------------------------------------------------------------
+STATIC
+BOOLEAN
+PlleEnable (
+  VOID
+  )
+{
+  UINT32  V;
+
+  if (Rd (CAR_BASE, PX_CAR_PLLE_AUX) & BIT24) {
+    Log (L"plle: HW sequencer already running (AUX=%08x)", Rd (CAR_BASE, PX_CAR_PLLE_AUX));
+    return TRUE;
+  }
+  if (Rd (CAR_BASE, PX_CAR_PLLE_BASE) & BIT31) {
+    Log (L"plle: already enabled (BASE=%08x MISC=%08x)", Rd (CAR_BASE, PX_CAR_PLLE_BASE), Rd (CAR_BASE, PX_CAR_PLLE_MISC));
+    return TRUE;
+  }
+  Log (L"plle: enabling from OSC_CTRL=%08x (table assumes 38.4 MHz pll_ref: M=2 N=125 CML=14)", Rd (CAR_BASE, PX_CAR_OSC_CTRL));
+  Rm (CAR_BASE, PX_CAR_PLLE_BASE, BIT30, 0);                                   // no lock override
+  V = Rd (CAR_BASE, PX_CAR_PLLE_MISC);
+  V |= BIT9 | BIT14 | BIT8;                                                    // LOCK_ENABLE | IDDQ_SW_CTRL | PLLE_PTS
+  V &= ~(BIT13 | (3U << 4) | (2U << 2));                                       // IDDQ_SW_VALUE, VREG_BG_CTRL, VREG_CTRL
+  Wr (CAR_BASE, PX_CAR_PLLE_MISC, V);
+  Us (5);
+  Rm (CAR_BASE, PX_CAR_PLLE_SS, 0, BIT10 | BIT11 | BIT12);                     // SS disabled while locking
+  Rm (CAR_BASE, PX_CAR_PLLE_BASE, 0xFF | (0xFFU << 8) | (0x1FU << 24), 2 | (125U << 8) | (14U << 24));
+  Us (1);
+  Rm (CAR_BASE, PX_CAR_PLLE_BASE, 0, BIT31);                                   // enable
+  if (!WaitBits (CAR_BASE, PX_CAR_PLLE_MISC, BIT11, BIT11, 20000)) {
+    Log (L"plle: NO LOCK (BASE=%08x MISC=%08x)", Rd (CAR_BASE, PX_CAR_PLLE_BASE), Rd (CAR_BASE, PX_CAR_PLLE_MISC));
+    return FALSE;
+  }
+  V = Rd (CAR_BASE, PX_CAR_PLLE_SS);
+  V &= ~(BIT14 | BIT15 | 0x1FF | (0xFFU << 16) | (0x3FU << 24));
+  V |= 0x21 | (1U << 16) | (0x23U << 24);
+  Wr (CAR_BASE, PX_CAR_PLLE_SS, V);
+  V &= ~(BIT12 | BIT10);
+  Wr (CAR_BASE, PX_CAR_PLLE_SS, V);
+  Us (1);
+  V &= ~BIT11;
+  Wr (CAR_BASE, PX_CAR_PLLE_SS, V);
+  Us (1);
+  Log (L"plle: locked, BASE=%08x MISC=%08x SS=%08x", Rd (CAR_BASE, PX_CAR_PLLE_BASE), Rd (CAR_BASE, PX_CAR_PLLE_MISC), Rd (CAR_BASE, PX_CAR_PLLE_SS));
+  return TRUE;
+}
+
+STATIC
+VOID
+PlleHwSequence (
+  VOID
+  )
+{
+  UINT32  V;
+
+  if (Rd (CAR_BASE, PX_CAR_PLLE_AUX) & BIT24) {
+    return;
+  }
+  if (!(Rd (CAR_BASE, PX_CAR_PLLE_MISC) & BIT11)) {
+    Log (L"plle: hw sequence skipped, PLLE not locked");
+    return;
+  }
+  Rm (CAR_BASE, PX_CAR_PLLE_MISC, BIT14, 0);                                   // IDDQ_SW_CTRL off
+  V = Rd (CAR_BASE, PX_CAR_PLLE_AUX);
+  V |= BIT3 | BIT31;                                                           // USE_LOCKDET | SS_SEQ_INCLUDE
+  V &= ~(BIT4 | BIT6);                                                         // ENABLE_SWCTL | SS_SWCTL
+  Wr (CAR_BASE, PX_CAR_PLLE_AUX, V);
+  Us (1);
+  V |= BIT24;                                                                  // SEQ_ENABLE
+  Wr (CAR_BASE, PX_CAR_PLLE_AUX, V);
+  Us (1);
+  Log (L"plle: HW sequencer started, AUX=%08x", Rd (CAR_BASE, PX_CAR_PLLE_AUX));
+}
+
+// ---------------------------------------------------------------------------------------------
+// XUSB padctl access + UPHY PLL  (tegra210_pex_uphy_enable)
+// ---------------------------------------------------------------------------------------------
+STATIC
+BOOLEAN
+PadctlUp (
+  VOID
+  )
+{
+  if ((Rd (CAR_BASE, PX_CAR_ENB_W) & PX_W_XUSB) != 0 && (Rd (CAR_BASE, PX_CAR_RST_W) & (PX_W_XUSB | PX_W_PADCTL)) == 0) {
+    return TRUE;
+  }
+  Log (L"padctl: enabling clock + releasing reset (xusb gate id143, padctl reset id142)");
+  Wr (CAR_BASE, PX_CAR_ENB_W_SET, PX_W_XUSB);
+  Wr (CAR_BASE, PX_CAR_RST_W_SET, PX_W_XUSB);
+  Us (2);
+  Wr (CAR_BASE, PX_CAR_RST_W_CLR, PX_W_XUSB);
+  Wr (CAR_BASE, PX_CAR_RST_W_CLR, PX_W_PADCTL);
+  Us (2);
+  return (Rd (CAR_BASE, PX_CAR_RST_W) & (PX_W_XUSB | PX_W_PADCTL)) == 0;
+}
+
+STATIC
+BOOLEAN
+UphyWait (
+  IN UINTN        Off,
+  IN UINT32       Mask,
+  IN UINT32       Val,
+  IN CONST CHAR16 *What
+  )
+{
+  if (!WaitBits (PX_PADCTL, Off, Mask, Val, 100000)) {
+    Log (L"uphy: TIMEOUT waiting for %s (reg %03x = %08x)", What, Off, Rd (PX_PADCTL, Off));
+    return FALSE;
+  }
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+UphyEnable (
+  VOID
+  )
+{
+  UINT32  I;
+
+  if (!PadctlUp ()) {
+    Log (L"uphy: padctl not accessible");
+    return FALSE;
+  }
+  Log (L"uphy: PLL_P0 CTL1=%08x CTL2=%08x CTL4=%08x CTL5=%08x CTL8=%08x PAD_MUX=%08x XUSBIO=%08x",
+       Rd (PX_PADCTL, PAD_UPHY_PLL_P0_1), Rd (PX_PADCTL, PAD_UPHY_PLL_P0_2), Rd (PX_PADCTL, PAD_UPHY_PLL_P0_4),
+       Rd (PX_PADCTL, PAD_UPHY_PLL_P0_5), Rd (PX_PADCTL, PAD_UPHY_PLL_P0_8), Rd (PX_PADCTL, PAD_USB3_PAD_MUX), Rd (CAR_BASE, PX_CAR_XUSBIO_PLL));
+
+  if (Rd (CAR_BASE, PX_CAR_XUSBIO_PLL) & BIT24) {
+    Log (L"uphy: XUSBIO PLL HW sequencer already running, skipping PLL calibration");
+  } else {
+    Wr (CAR_BASE, PX_CAR_RST_Y_CLR, PX_Y_UPHY);                                  // release PEX_USB_UPHY reset (id 205)
+    Us (10);
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_2, 0xFFFFFFU << 4, 0x136U << 4);              // CAL_CTRL
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_5, 0xFFU << 16, 0x2AU << 16);                 // DCO_CTRL
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_1, 0, BIT4);                                  // PWR_OVRD
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_2, 0, BIT2);                                  // CAL_OVRD
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_8, 0, BIT15);                                 // RCAL_OVRD
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_4, (3U << 12) | (0xFU << 4), (2U << 12) | BIT15);   // TXCLKREF_SEL=USB, TXCLKREF_EN, REFCLK_SEL=0
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_1, (3U << 16) | (0xFFU << 20), 0x19U << 20);  // FREQ_MDIV=0, FREQ_NDIV=0x19
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_1, BIT0, 0);                                  // IDDQ off
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_1, 3U << 1, 0);                               // SLEEP = 0
+    Us (20);
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_4, 0, BIT8);                                  // REFCLKBUF_EN
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_2, 0, BIT0);                                  // CAL_EN
+    if (!UphyWait (PAD_UPHY_PLL_P0_2, BIT1, BIT1, L"CAL_DONE")) {
+      return FALSE;
+    }
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_2, BIT0, 0);
+    if (!UphyWait (PAD_UPHY_PLL_P0_2, BIT1, 0, L"CAL_DONE clear")) {
+      return FALSE;
+    }
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_1, 0, BIT3);                                  // ENABLE
+    if (!UphyWait (PAD_UPHY_PLL_P0_1, BIT15, BIT15, L"PLL LOCKDET")) {
+      return FALSE;
+    }
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_8, 0, BIT12 | BIT13);                         // RCAL_EN | RCAL_CLK_EN
+    if (!UphyWait (PAD_UPHY_PLL_P0_8, BIT31, BIT31, L"RCAL_DONE")) {
+      return FALSE;
+    }
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_8, BIT12, 0);
+    if (!UphyWait (PAD_UPHY_PLL_P0_8, BIT31, 0, L"RCAL_DONE clear")) {
+      return FALSE;
+    }
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_8, BIT13, 0);
+    // tegra210_xusb_pll_hw_control_enable()
+    Rm (CAR_BASE, PX_CAR_XUSBIO_PLL, BIT2 | BIT0, BIT6 | BIT13);                 // clear CLK_ENABLE_SWCTL|PADPLL_RESET_SWCTL, set USE_LOCKDET|SLEEP_IDDQ
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_1, BIT4, 0);
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_2, BIT2, 0);
+    Rm (PX_PADCTL, PAD_UPHY_PLL_P0_8, BIT15, 0);
+    Us (20);
+    Rm (CAR_BASE, PX_CAR_XUSBIO_PLL, 0, BIT24);                                  // tegra210_xusb_pll_hw_sequence_start()
+    Log (L"uphy: PLL calibrated + locked, XUSBIO=%08x CTL1=%08x", Rd (CAR_BASE, PX_CAR_XUSBIO_PLL), Rd (PX_PADCTL, PAD_UPHY_PLL_P0_1));
+  }
+
+  // lane muxing: pcie-0 = function "pcie-x1" (0) in USB3_PAD_MUX[13:12]; release IDDQ for the lanes we use
+  Rm (PX_PADCTL, PAD_USB3_PAD_MUX, 3U << 12, 0);
+  for (I = 0; I < 7; I++) {
+    if (mUphyLanes & (1U << I)) {
+      Rm (PX_PADCTL, PAD_USB3_PAD_MUX, 0, 1U << (1 + I));
+    }
+  }
+  PlleHwSequence ();
+
+  // tegra210_aux_mux_lp0_clamp_disable()
+  Rm (PX_PADCTL, PAD_ELPG_PROGRAM1, BIT29, 0);
+  Us (150);
+  Rm (PX_PADCTL, PAD_ELPG_PROGRAM1, BIT30, 0);
+  Us (150);
+  Rm (PX_PADCTL, PAD_ELPG_PROGRAM1, BIT31, 0);
+  Log (L"uphy: done. PAD_MUX=%08x ELPG1=%08x", Rd (PX_PADCTL, PAD_USB3_PAD_MUX), Rd (PX_PADCTL, PAD_ELPG_PROGRAM1));
+  return TRUE;
+}
+
+// ---------------------------------------------------------------------------------------------
+// PCIe configuration space access (Tegra "ECAM-like" window)
+// ---------------------------------------------------------------------------------------------
+STATIC
+UINT32
+PexCfgRd (
+  IN UINT32  Bus,
+  IN UINT32  Dev,
+  IN UINT32  Fn,
+  IN UINT32  Where
+  )
+{
+  UINT32  Off;
+
+  if (Bus == 0) {
+    if (Dev != (PEX_PORT + 1U) || Fn != 0) {
+      return 0xFFFFFFFF;
+    }
+    return Rd (PEX_RP_BASE + PEX_PORT * 0x1000, Where & 0xFFC);
+  }
+  Off = ((Where & 0xF00U) << 16) | (Bus << 16) | (Dev << 11) | (Fn << 8) | (Where & 0xFF);
+  Wr (PEX_AFI, AFI_FPCI_BAR0, 0xFE100000U + ((Off & ~0xFFFU) >> 8));
+  (VOID)Rd (PEX_AFI, AFI_FPCI_BAR0);
+  return Rd (PEX_CS, Off & 0xFFC);
+}
+
+STATIC
+VOID
+PexCfgWr (
+  IN UINT32  Bus,
+  IN UINT32  Dev,
+  IN UINT32  Fn,
+  IN UINT32  Where,
+  IN UINT32  V
+  )
+{
+  UINT32  Off;
+
+  if (Bus == 0) {
+    if (Dev == (PEX_PORT + 1U) && Fn == 0) {
+      Wr (PEX_RP_BASE + PEX_PORT * 0x1000, Where & 0xFFC, V);
+    }
+    return;
+  }
+  Off = ((Where & 0xF00U) << 16) | (Bus << 16) | (Dev << 11) | (Fn << 8) | (Where & 0xFF);
+  Wr (PEX_AFI, AFI_FPCI_BAR0, 0xFE100000U + ((Off & ~0xFFFU) >> 8));
+  (VOID)Rd (PEX_AFI, AFI_FPCI_BAR0);
+  Wr (PEX_CS, Off & 0xFFC, V);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Root port (tegra_pcie_port_enable / tegra_pcie_port_check_link)
+// ---------------------------------------------------------------------------------------------
+STATIC
+VOID
+PexPortReset (
+  VOID
+  )
+{
+  // PERST# from the SoC: RST bit low = asserted
+  Rm (PEX_AFI, AFI_PEX1_CTRL, BIT0, 0);
+  Ms (2);
+  Rm (PEX_AFI, AFI_PEX1_CTRL, 0, BIT0);
+}
+
+STATIC
+VOID
+PexRpInit (
+  VOID
+  )
+{
+  UINTN  Rp = PEX_RP_BASE + PEX_PORT * 0x1000;
+
+  Rm (PEX_AFI, AFI_PEX1_CTRL, 0, BIT3 | BIT1 | BIT4);       // REFCLK_EN | CLKREQ_EN | OVERRIDE_EN
+  PexPortReset ();
+  Rm (Rp, RP_VEND_CTL2, 0, BIT7);                           // PCA_ENABLE (T210 force_pca_enable)
+  Rm (Rp, RP_VEND_CTL1, 0, BIT13);                          // AER
+  Rm (Rp, RP_VEND_XP, 0, BIT27 | BIT28);                    // opportunistic ACK / UPDATEFC
+  Rm (Rp, RP_VEND_XP_BIST, 0, BIT28);
+  Rm (Rp, RP_PRIV_MISC, (0x7FU << 16) | (0x7FU << 24), BIT23 | BIT31 | (0xFU << 16) | (0xFU << 24));
+  // T210 ectl
+  Rm (Rp, RP_ECTL_2_R1, 0xFFFF, 0x0000000F);
+  Rm (Rp, RP_ECTL_4_R1, 0xFFFFU << 16, 0x67U << 16);
+  Wr (Rp, RP_ECTL_5_R1, 0x55010000);
+  Wr (Rp, RP_ECTL_6_R1, 0x00000001);
+  Rm (Rp, RP_ECTL_2_R2, 0xFFFF, 0x0000008F);
+  Rm (Rp, RP_ECTL_4_R2, 0xFFFFU << 16, 0xC7U << 16);
+  Wr (Rp, RP_ECTL_5_R2, 0x55010000);
+  Wr (Rp, RP_ECTL_6_R2, 0x00000001);
+  // sw fixups: deskew pulse width, FC threshold, advertise Gen1 only first
+  Rm (Rp, RP_VEND_CTL0, 0xFU << 12, 0x9U << 12);
+  Rm (Rp, RP_VEND_XP, 0xFFU << 18, 0x01800000);
+  Rm (Rp, RP_LINK_CTL_STATUS2, 0xF, 1);
+}
+
+STATIC
+BOOLEAN
+PexCheckLink (
+  VOID
+  )
+{
+  UINTN    Rp = PEX_RP_BASE + PEX_PORT * 0x1000;
+  UINT32   Try;
+
+  Rm (Rp, RP_PRIV_MISC, 0xF, 0xE);                          // override presence detect: endpoint present
+  for (Try = 0; Try < 3; Try++) {
+    if (WaitBits (Rp, RP_VEND_XP, BIT30, BIT30, 250000)) {                       // DL_UP
+      if (WaitBits (Rp, RP_LINK_CTL_STATUS, 0x20000000, 0x20000000, 250000)) {   // DL_LINK_ACTIVE
+        Log (L"pex: link UP (try %d) VEND_XP=%08x LINK_CTL_STATUS=%08x", Try, Rd (Rp, RP_VEND_XP), Rd (Rp, RP_LINK_CTL_STATUS));
+        return TRUE;
+      }
+    }
+    Log (L"pex: link down (try %d) VEND_XP=%08x LINK_CTL_STATUS=%08x PRIV_MISC=%08x -> port reset", Try, Rd (Rp, RP_VEND_XP),
+         Rd (Rp, RP_LINK_CTL_STATUS), Rd (Rp, RP_PRIV_MISC));
+    PexPortReset ();
+  }
+  return FALSE;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Backplane window over BAR0 (brcmf_pcie_buscore_*)
+// ---------------------------------------------------------------------------------------------
+STATIC
+VOID
+BpSetWin (
+  IN UINT32  Addr
+  )
+{
+  UINT32  Base = Addr & ~0xFFFU;
+
+  if (Base != mBpWin) {
+    PexCfgWr (1, 0, 0, BCM_BAR0_WINDOW, Base);
+    mBpWin = Base;
+  }
+}
+
+STATIC
+BOOLEAN
+BpRd32 (
+  IN  UINT32  Addr,
+  OUT UINT32  *V
+  )
+{
+  BpSetWin (Addr);
+  *V = Rd (mBar0, Addr & 0xFFC);
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+BpWr32 (
+  IN UINT32  Addr,
+  IN UINT32  V
+  )
+{
+  BpSetWin (Addr);
+  Wr (mBar0, Addr & 0xFFC, V);
+  return TRUE;
+}
+
+// TCM (BAR2) accesses: 32-bit only.
+STATIC UINT32 TcmRd32 (IN UINT32 Off) { return Rd (mBar2, Off & ~3U); }
+STATIC VOID   TcmWr32 (IN UINT32 Off, IN UINT32 V) { Wr (mBar2, Off & ~3U, V); }
+
+STATIC
+UINT32
+Le32 (
+  IN CONST UINT8  *P
+  )
+{
+  return (UINT32)P[0] | ((UINT32)P[1] << 8) | ((UINT32)P[2] << 16) | ((UINT32)P[3] << 24);
+}
+
+STATIC
+VOID
+TcmWriteBuf (
+  IN UINT32       Off,
+  IN CONST UINT8  *Data,
+  IN UINTN        Len
+  )
+{
+  UINTN   I;
+  UINT8   Tail[4];
+
+  for (I = 0; I + 4 <= Len; I += 4) {
+    TcmWr32 (Off + (UINT32)I, Le32 (Data + I));
+  }
+  if (I < Len) {
+    Tail[0] = Tail[1] = Tail[2] = Tail[3] = 0;
+    CopyMem (Tail, Data + I, Len - I);
+    TcmWr32 (Off + (UINT32)I, Le32 (Tail));
+  }
+}
diff --git a/Drivers/WifiBtApp/WifiPexStages.h b/Drivers/WifiBtApp/WifiPexStages.h
new file mode 100644
index 0000000..5e0bf38
--- /dev/null
+++ b/Drivers/WifiBtApp/WifiPexStages.h
@@ -0,0 +1,607 @@
+/** @file
+  WifiPexStages.h - shell-visible stages of the BCM4356 Wi-Fi bring-up over PCIe (uses the low level code in WifiPcie.h).
+
+  Stages (each logs + flushes; the LAST log line names the step that failed):
+    pex    : radio power, PMC/CAR/PLLE/UPHY, AFI, root port, link training, enumeration (BARs)     [PexUp + PexEnum]
+    pchip  : backplane window over BAR0, chip id, EROM dump, ARM CR4 halt, TCM size                [PexChip]
+    pfw    : firmware + NVRAM -> TCM, release CR4, wait for the shared-area pointer, dump it        [PexFw]
+    pcon   : dump the firmware console ring (the firmware's own boot log)                          [PexConsole]
+    poff   : everything down again                                                                 [PexOff]
+
+  What is NOT here: msgbuf rings / ioctl / scan / join / EFI_SIMPLE_NETWORK. Reaching "pfw: firmware is running" and a readable
+  firmware console is the Saturday milestone; everything beyond that needs the log from real hardware first.
+
+  DRAFT, UNTESTED. All device accesses are naturally aligned 32-bit MMIO (see Rd/Wr/TcmRd32/TcmWr32).
+**/
+
+STATIC UINT32  mChipId     = 0;
+STATIC UINT32  mArmBase    = 0x18002000;   // ARM CR4 core registers (BCM4350 family)
+STATIC UINT32  mArmWrap    = 0x18102000;   // its AI wrapper
+STATIC UINT32  mD11Wrap    = 0x18101000;   // 802.11 core AI wrapper
+STATIC UINT32  mRamBase    = BCM_RAMBASE_4356;
+STATIC UINT32  mRamSize    = 0;
+STATIC UINT32  mSharedAddr = 0;
+
+#define AFI_PLLE_CONTROL     0x160
+#define AFI_AXI_BAR1_SZ_X    0x04
+#define PEX_CAR_ENB_V_SET    0x440
+
+// ---------------------------------------------------------------------------------------------
+STATIC
+VOID
+PexCfgDump (
+  IN UINT32  Bus,
+  IN UINT32  Dev,
+  IN UINT32  Count
+  )
+{
+  UINT32  I;
+
+  for (I = 0; I < Count; I += 4) {
+    Log (L"  cfg[%d:%d.0][%02x] = %08x %08x %08x %08x", Bus, Dev, I * 4,
+         PexCfgRd (Bus, Dev, 0, I * 4), PexCfgRd (Bus, Dev, 0, I * 4 + 4),
+         PexCfgRd (Bus, Dev, 0, I * 4 + 8), PexCfgRd (Bus, Dev, 0, I * 4 + 12));
+  }
+}
+
+STATIC
+VOID
+PexAfiErr (
+  IN CONST CHAR16  *Tag
+  )
+{
+  Log (L"afi[%s]: INTR_CODE=%08x SIGNATURE=%08x (non-zero code = AFI saw a FPCI/AXI error)", Tag,
+       Rd (PEX_AFI, AFI_INTR_CODE), Rd (PEX_AFI, AFI_INTR_SIGNATURE));
+}
+
+// ---------------------------------------------------------------------------------------------
+// pex: power + controller + link
+// ---------------------------------------------------------------------------------------------
+STATIC
+BOOLEAN
+PexUp (
+  VOID
+  )
+{
+  UINT32  V;
+
+  Log (L"pex: ---- bring-up, root port %d (pci@2,0), lane pcie-0, rst-run-level=%d gen2=%d ----", PEX_PORT, mPexRstRun, mPexGen2);
+  PexDumpCar (L"start");
+  mPexUp   = FALSE;
+  mPexEnum = FALSE;
+  mBpWin   = 0xFFFFFFFF;
+
+  Log (L"pex[1] radio off (WIFI_EN/WIFI_RST low), pinmux, 32 kHz");
+  PinsRadio ();
+  Step32k (TRUE);
+  GpioH (H0 | H1, 0, TRUE);
+  Ms (10);
+
+  Log (L"pex[2] assert resets pex/afi/pcie_x, enable mselect clock (afi parent)");
+  Wr (CAR_BASE, PX_CAR_RST_U_SET, PX_U_PEX | PX_U_AFI | PX_U_PCIEX);
+  Wr (CAR_BASE, PEX_CAR_ENB_V_SET, BIT3);
+
+  Log (L"pex[3] PMC power partition PCIE (id %d) + IO pads", PX_PG_PCIE);
+  if (!PexPgOn (PX_PG_PCIE)) {
+    return FALSE;
+  }
+  PexIoPadsOn ();
+
+  Log (L"pex[4] clocks: afi, pex; PLLE + cml0");
+  Wr (CAR_BASE, PX_CAR_ENB_U_SET, PX_U_AFI | PX_U_PEX);
+  if (!PlleEnable ()) {
+    return FALSE;
+  }
+  Rm (CAR_BASE, PX_CAR_PLLE_AUX, 0, BIT0);                      // cml0 gate (clk-tegra210.c: PLLE_AUX bit0)
+  Us (20);
+  PexDumpCar (L"clocks");
+
+  Log (L"pex[5] release AFI reset, controller setup");
+  Wr (CAR_BASE, PX_CAR_RST_U_CLR, PX_U_AFI);
+  Us (20);
+  V = Rd (PEX_AFI, AFI_PLLE_CONTROL);
+  V &= ~BIT9;                                                   // BYPASS_PADS2PLLE_CONTROL
+  V |= BIT1;                                                    // PADS2PLLE_CONTROL_EN
+  Wr (PEX_AFI, AFI_PLLE_CONTROL, V);
+  Wr (PEX_AFI, AFI_PEXBIAS_CTRL_0, 0);
+  V = Rd (PEX_AFI, AFI_PCIE_CONFIG);
+  V &= ~(0xFU << 20);
+  V |= 0xEU | (1U << 20) | (7U << 29);                          // DISABLE_ALL | XBAR x4+x1 | CLKREQ_GPIO_ALL
+  V &= ~(1U << (PEX_PORT + 1));                                 // enable our port
+  V &= ~(1U << (PEX_PORT + 29));
+  Wr (PEX_AFI, AFI_PCIE_CONFIG, V);
+  Rm (PEX_AFI, AFI_FUSE, BIT2, 0);                              // Gen2 not disabled
+  Rm (PEX_AFI, AFI_CONFIGURATION, 0, BIT0 | BIT31);             // EN_FPCI | CLKEN_OVERRIDE
+  Wr (PEX_AFI, AFI_FPCI_ERR_MASKS, 0);                          // no exceptions: a bad access must not abort the CPU
+  Wr (PEX_AFI, AFI_INTR_MASK, 0);                               // no interrupts: we poll
+  Wr (PEX_AFI, AFI_AFI_INTR_ENABLE, 0);
+  Wr (PEX_AFI, AFI_SM_INTR_ENABLE, 0);
+
+  Log (L"pex[6] address translations (cfg window %08x, mem window %08x+%08x)", PEX_CS, PEX_MEM_BASE, PEX_MEM_SIZE);
+  Wr (PEX_AFI, AFI_AXI_BAR0_START, PEX_CS);
+  Wr (PEX_AFI, AFI_AXI_BAR0_SZ, 0x10000000 >> 12);
+  Wr (PEX_AFI, AFI_AXI_BAR3_START, PEX_MEM_BASE);
+  Wr (PEX_AFI, AFI_AXI_BAR3_SZ, PEX_MEM_SIZE >> 12);
+  Wr (PEX_AFI, AFI_FPCI_BAR3, (((PEX_MEM_BASE >> 12) & 0x0FFFFFFF) << 4) | 1);
+  Wr (PEX_AFI, AFI_AXI_BAR4_START, 0);
+  Wr (PEX_AFI, AFI_AXI_BAR4_SZ, 0);
+  Wr (PEX_AFI, AFI_FPCI_BAR4, 0);
+  Wr (PEX_AFI, AFI_AXI_BAR5_START, 0);
+  Wr (PEX_AFI, AFI_AXI_BAR5_SZ, 0);
+  Wr (PEX_AFI, AFI_FPCI_BAR5, 0);
+  Wr (PEX_AFI, AFI_MSI_FPCI_BAR_ST, 0);
+  Wr (PEX_AFI, AFI_MSI_BAR_SZ, 0);
+  Wr (PEX_AFI, AFI_MSI_AXI_BAR_ST, 0);
+  PexDumpAfi (L"translations");
+
+  Log (L"pex[7] release PEX reset, UPHY PLL + pcie lane");
+  Wr (CAR_BASE, PX_CAR_RST_U_CLR, PX_U_PEX);
+  Us (20);
+  if (!UphyEnable ()) {
+    PexDumpCar (L"uphy-fail");
+    return FALSE;
+  }
+  Wr (PEX_PADS, PADS_REFCLK_CFG0, 0x90B890B8);
+
+  Log (L"pex[8] power the Wi-Fi chip: WIFI_EN high, then WIFI_RST -> run level %d", mPexRstRun);
+  GpioH (H0, 1, TRUE);
+  Ms (20);
+  GpioH (H1, mPexRstRun, TRUE);
+  GpioH (H2, 0, FALSE);
+  Ms (100);
+
+  Log (L"pex[9] root port init + LTSSM start");
+  PexRpInit ();
+  Wr (CAR_BASE, PX_CAR_RST_U_CLR, PX_U_PCIEX);
+  Ms (5);
+  PexAfiErr (L"before-link");
+  if (!PexCheckLink ()) {
+    Log (L"pex: LINK DOWN. Things to try: `wifibt pex rst=%d` (opposite WIFI_RST polarity), longer power-up delay, 32 kHz clock, PLLE/UPHY lock, lane mapping", mPexRstRun ? 0 : 1);
+    PexDumpAfi (L"link-down");
+    PexDumpCar (L"link-down");
+    Log (L"pex: root port cfg dump:");
+    PexCfgDump (0, PEX_PORT + 1, 16);
+    return FALSE;
+  }
+  if (mPexGen2) {
+    Log (L"pex: retraining to Gen2");
+    Rm (PEX_RP_BASE + PEX_PORT * 0x1000, RP_LINK_CTL_STATUS2, 0xF, 2);
+    Rm (PEX_RP_BASE + PEX_PORT * 0x1000, RP_LINK_CTL_STATUS, 0, BIT5);
+    Ms (50);
+  }
+  mPexUp = TRUE;
+  Log (L"pex: link status reg %08x", Rd (PEX_RP_BASE + PEX_PORT * 0x1000, RP_LINK_CTL_STATUS));
+  return TRUE;
+}
+
+STATIC
+UINT32
+PexBarSize (
+  IN UINT32  Where
+  )
+{
+  UINT32  Old = PexCfgRd (1, 0, 0, Where);
+  UINT32  Sz;
+
+  PexCfgWr (1, 0, 0, Where, 0xFFFFFFFF);
+  Sz = PexCfgRd (1, 0, 0, Where);
+  PexCfgWr (1, 0, 0, Where, Old);
+  return Sz;
+}
+
+STATIC
+BOOLEAN
+PexEnum (
+  VOID
+  )
+{
+  UINT32  Id;
+  UINT32  T;
+  UINT32  S0;
+  UINT32  S2;
+  UINT32  Sz0;
+  UINT32  Sz2;
+  UINT32  A0;
+  UINT32  A2;
+  UINT32  Cmd;
+  UINT32  Probe;
+
+  if (!mPexUp) {
+    Log (L"enum: run `pex` first");
+    return FALSE;
+  }
+  Id = PexCfgRd (0, PEX_PORT + 1, 0, 0);
+  Log (L"enum: root port id=%08x class=%08x", Id, PexCfgRd (0, PEX_PORT + 1, 0, 8));
+  Log (L"enum: root port bus numbers pri0 sec1 sub1; memory window %08x..%08x", PEX_MEM_BASE, PEX_MEM_BASE + 0x3FFFFF);
+  PexCfgWr (0, PEX_PORT + 1, 0, 0x18, 0x00010100);
+  PexCfgWr (0, PEX_PORT + 1, 0, 0x20, 0x13301300);
+  PexCfgWr (0, PEX_PORT + 1, 0, 0x24, 0x0000FFF0);               // prefetch window closed (base > limit)
+  Cmd = PexCfgRd (0, PEX_PORT + 1, 0, 4) & 0xFFFF;
+  PexCfgWr (0, PEX_PORT + 1, 0, 4, Cmd | 0x6);
+
+  Id = 0xFFFFFFFF;
+  for (T = 0; T < 200; T++) {
+    Id = PexCfgRd (1, 0, 0, 0);
+    if (Id != 0xFFFFFFFF && Id != 0xFFFF0001 && (Id & 0xFFFF) != 0xFFFF && Id != 0) {
+      break;
+    }
+    Ms (10);
+  }
+  Log (L"enum: endpoint 1:0.0 id=%08x (expect 43ec14e4 for BCM4356)", Id);
+  PexAfiErr (L"after-ep-probe");
+  if (Id == 0xFFFFFFFF || (Id & 0xFFFF) == 0xFFFF || Id == 0xFFFF0001 || Id == 0) {
+    Log (L"enum: no endpoint answers (link up but config reads fail: check cfg window mapping / PEX_CS)");
+    return FALSE;
+  }
+  if ((Id & 0xFFFF) != 0x14E4) {
+    Log (L"enum: WARNING vendor is not Broadcom");
+  }
+  PexCfgDump (1, 0, 16);
+
+  Sz0 = PexBarSize (0x10);
+  Sz2 = PexBarSize (0x18);
+  Log (L"enum: BAR0 sizing readback=%08x  BAR2 sizing readback=%08x (bit2:1 = 10b means 64-bit BAR)", Sz0, Sz2);
+  S0 = ~(Sz0 & ~0xFU) + 1;
+  S2 = ~(Sz2 & ~0xFU) + 1;
+  if (S0 == 0 || S2 == 0 || S0 > 0x100000 || S2 > 0x1000000) {
+    Log (L"enum: implausible BAR sizes %08x / %08x", S0, S2);
+    return FALSE;
+  }
+  A0 = PEX_MEM_BASE;
+  A2 = (A0 + S0 + S2 - 1) & ~(S2 - 1);
+  if (A2 < A0 + S0) {
+    A2 += S2;
+  }
+  Log (L"enum: BAR0 size %08x -> %08x, BAR2 size %08x -> %08x", S0, A0, S2, A2);
+  PexCfgWr (1, 0, 0, 0x10, A0 | (Sz0 & 0xF));
+  if ((Sz0 & 6) == 4) {
+    PexCfgWr (1, 0, 0, 0x14, 0);
+  }
+  PexCfgWr (1, 0, 0, 0x18, A2 | (Sz2 & 0xF));
+  if ((Sz2 & 6) == 4) {
+    PexCfgWr (1, 0, 0, 0x1C, 0);
+  }
+  Cmd = PexCfgRd (1, 0, 0, 4) & 0xFFFF;
+  PexCfgWr (1, 0, 0, 4, Cmd | 0x6);                              // memory space + bus master
+  Log (L"enum: BAR0=%08x BAR2=%08x cmd=%08x", PexCfgRd (1, 0, 0, 0x10), PexCfgRd (1, 0, 0, 0x18), PexCfgRd (1, 0, 0, 4));
+
+  mBar0     = A0;
+  mBar2     = A2;
+  mBar0Size = S0;
+  mBar2Size = S2;
+  Probe = Rd (mBar0, 0);
+  Log (L"enum: first dword of BAR0 window = %08x (chipcommon chipid register if window is default)", Probe);
+  PexAfiErr (L"after-bar-read");
+  mPexEnum = TRUE;
+  return TRUE;
+}
+
+// ---------------------------------------------------------------------------------------------
+// pchip: backplane
+// ---------------------------------------------------------------------------------------------
+STATIC
+BOOLEAN
+PexChip (
+  VOID
+  )
+{
+  UINT32  V;
+  UINT32  Cap;
+  UINT32  Nab;
+  UINT32  Nbb;
+  UINT32  I;
+  UINT32  Info;
+  UINT32  Blk;
+  UINT32  Size = 0;
+  UINT32  Erom = 0;
+
+  if (!mPexEnum) {
+    Log (L"chip: run `pex` first");
+    return FALSE;
+  }
+  mPcieMode = TRUE;
+  mBpWin    = 0xFFFFFFFF;
+  Log (L"chip: BAR0_WINDOW cfg[80] = %08x", PexCfgRd (1, 0, 0, BCM_BAR0_WINDOW));
+  BpRd32 (BCM_CC_BASE, &V);
+  mChipId = V;
+  Log (L"chip: chipcommon chipid reg = %08x -> chip %04x rev %d pkg %d (BCM4356 = 4356)", V, V & 0xFFFF, (V >> 16) & 0xF, (V >> 20) & 0xF);
+  if ((V & 0xFFFF) != 0x4356) {
+    Log (L"chip: unexpected chip id. If this is garbage, BAR0 window / BAR mapping is wrong.");
+    if (V == 0xFFFFFFFF || V == 0) {
+      return FALSE;
+    }
+  }
+  BpRd32 (BCM_CC_BASE + 0xFC, &Erom);
+  Log (L"chip: EROM pointer %08x; dump:", Erom);
+  for (I = 0; I < 96; I++) {
+    if (!BpRd32 (Erom + I * 4, &V)) {
+      break;
+    }
+    if (V == 0xF) {
+      break;
+    }
+    Log (L"  erom[%02d]=%08x", I, V);
+  }
+  Log (L"chip: assuming ARM CR4 core=%08x wrap=%08x d11 wrap=%08x (override: arm= wrap= d11=; check against the EROM dump)", mArmBase, mArmWrap, mD11Wrap);
+  BpRd32 (mArmWrap + 0x800, &V);
+  Log (L"chip: CR4 wrapper RESET_CTL=%08x", V);
+  BpRd32 (mArmWrap + 0x408, &V);
+  Log (L"chip: CR4 wrapper IOCTL=%08x", V);
+
+  Log (L"chip: disabling d11 core, halting ARM CR4 (brcmf_chip_cr4_set_passive)");
+  CoreDisable (mD11Wrap, 0x0C, 0x04);
+  CoreReset (mArmWrap, 0x20, 0x20, 0x20);
+  BpRd32 (mArmWrap + 0x408, &V);
+  Log (L"chip: CR4 IOCTL after halt=%08x (bit5 = CPUHALT, bit0 = clock)", V);
+
+  BpRd32 (mArmBase + 0x04, &Cap);
+  Nab = Cap & 0xF;
+  Nbb = (Cap >> 4) & 0xF;
+  Log (L"chip: CR4 CAP=%08x -> %d A-banks + %d B-banks", Cap, Nab, Nbb);
+  for (I = 0; I < Nab + Nbb && I < 16; I++) {
+    BpWr32 (mArmBase + 0x40, I);
+    BpRd32 (mArmBase + 0x44, &Info);
+    Blk = 8192;
+    if (Info & 0x200) {
+      Blk >>= 3;
+    }
+    Size += ((Info & 0x7F) + 1) * Blk;
+    Log (L"  bank %d info=%08x", I, Info);
+  }
+  Log (L"chip: TCM size from banks = %08x; rambase %08x", Size, mRamBase);
+  if (mRamSize == 0) {
+    mRamSize = Size;
+  }
+  if (mRamSize == 0) {
+    Log (L"chip: could not determine RAM size (pass size=0x...). BCM4356 is believed to be 0xC0000..0xE0000");
+    return FALSE;
+  }
+  Log (L"chip: using ramsize %08x. Next: pfw brcmfmac4356-pcie.bin brcmfmac4356-pcie.txt", mRamSize);
+  return TRUE;
+}
+
+// ---------------------------------------------------------------------------------------------
+// pfw: firmware download + boot
+// ---------------------------------------------------------------------------------------------
+STATIC
+BOOLEAN
+PexNvramBuild (
+  IN  CONST UINT8  *Nv,
+  IN  UINTN        NvSz,
+  OUT UINT8        **Out,
+  OUT UINT32       *OutLen        // includes the 4-byte length token
+  )
+{
+  UINT8    *Clean;
+  UINTN    I;
+  UINTN    O = 0;
+  UINT8    C;
+  BOOLEAN  Comment = FALSE;
+  BOOLEAN  Start   = TRUE;
+  UINT32   Tok;
+
+  Clean = AllocateZeroPool (NvSz + 16);
+  if (Clean == NULL) {
+    return FALSE;
+  }
+  for (I = 0; I < NvSz; I++) {
+    C = Nv[I];
+    if (C == '\r') {
+      continue;
+    }
+    if (Start && C == '#') {
+      Comment = TRUE;
+    }
+    if (C == '\n') {
+      if (!Comment && !Start) {
+        Clean[O++] = 0;
+      }
+      Comment = FALSE;
+      Start   = TRUE;
+      continue;
+    }
+    if (Start && (C == ' ' || C == '\t')) {
+      continue;
+    }
+    Start = FALSE;
+    if (!Comment) {
+      Clean[O++] = C;
+    }
+  }
+  if (!Start && !Comment) {
+    Clean[O++] = 0;                    // last line without newline
+  }
+  Clean[O++] = 0;                      // extra terminator (Linux: roundup(len + 1, 4))
+  O = (O + 3) & ~(UINTN)3;
+  Tok = (UINT32)(O / 4);
+  Tok = ((~Tok & 0xFFFF) << 16) | (Tok & 0xFFFF);
+  Clean[O + 0] = (UINT8)(Tok);
+  Clean[O + 1] = (UINT8)(Tok >> 8);
+  Clean[O + 2] = (UINT8)(Tok >> 16);
+  Clean[O + 3] = (UINT8)(Tok >> 24);
+  *Out    = Clean;
+  *OutLen = (UINT32)O + 4;
+  return TRUE;
+}
+
+STATIC
+BOOLEAN
+PexFw (
+  IN CONST CHAR16  *FwName,
+  IN CONST CHAR16  *NvName
+  )
+{
+  UINT8    *Fw   = NULL;
+  UINT8    *Nv   = NULL;
+  UINT8    *NvB  = NULL;
+  UINTN    FwSz  = 0;
+  UINTN    NvSz  = 0;
+  UINT32   NvLen = 0;
+  UINT32   Rst;
+  UINT32   Mark;
+  UINT32   Cur;
+  UINT32   I;
+  UINT32   V;
+
+  if (!mPexEnum || mRamSize == 0) {
+    Log (L"pfw: run `pex` and `pchip` first (same boot)");
+    return FALSE;
+  }
+  if (EFI_ERROR (ReadFile (FwName, &Fw, &FwSz)) || FwSz < 4) {
+    return FALSE;
+  }
+  if (FwSz > mRamSize) {
+    Log (L"pfw: firmware (%d) larger than RAM (%08x)", FwSz, mRamSize);
+    return FALSE;
+  }
+  Rst = Le32 (Fw);
+  Log (L"pfw: firmware %d bytes, first word (reset vector) %08x", FwSz, Rst);
+  Log (L"pfw: halting CR4");
+  CoreReset (mArmWrap, 0x20, 0x20, 0x20);
+
+  Log (L"pfw: writing firmware to TCM offset %08x (32-bit stores)", mRamBase);
+  TcmWriteBuf (mRamBase, Fw, FwSz);
+  V = TcmRd32 (mRamBase);
+  Log (L"pfw: readback word0 = %08x (%s)", V, V == Rst ? L"ok" : L"MISMATCH - BAR2/TCM write path broken");
+  V = TcmRd32 (mRamBase + (UINT32)(FwSz & ~3U) - 4);
+  Log (L"pfw: readback last word = %08x (fw %08x)", V, Le32 (Fw + (FwSz & ~3U) - 4));
+  FreePool (Fw);
+
+  TcmWr32 (mRamBase + mRamSize - 4, 0);
+  if (NvName != NULL && !EFI_ERROR (ReadFile (NvName, &Nv, &NvSz))) {
+    if (!PexNvramBuild (Nv, NvSz, &NvB, &NvLen)) {
+      Log (L"pfw: nvram build failed");
+      return FALSE;
+    }
+    Log (L"pfw: nvram %d bytes -> %d (incl. token) at TCM %08x", NvSz, NvLen, mRamBase + mRamSize - NvLen);
+    TcmWriteBuf (mRamBase + mRamSize - NvLen, NvB, NvLen);
+    FreePool (NvB);
+    FreePool (Nv);
+  } else {
+    Log (L"pfw: NO NVRAM - the firmware will probably not start (needs board nvram text)");
+  }
+
+  Mark = TcmRd32 (mRamBase + mRamSize - 4);
+  Log (L"pfw: marker at RAM end = %08x (firmware overwrites it with the shared-area pointer)", Mark);
+  Log (L"pfw: write reset vector to TCM[0], release CR4");
+  TcmWr32 (0, Rst);
+  CoreReset (mArmWrap, 0x20, 0, 0);
+  BpRd32 (mArmWrap + 0x408, &V);
+  Log (L"pfw: CR4 IOCTL=%08x RESET_CTL follows", V);
+  BpRd32 (mArmWrap + 0x800, &V);
+  Log (L"pfw: CR4 RESET_CTL=%08x", V);
+
+  Cur = Mark;
+  for (I = 0; I < 100 && Cur == Mark; I++) {
+    Ms (50);
+    Cur = TcmRd32 (mRamBase + mRamSize - 4);
+  }
+  if (Cur == Mark) {
+    Log (L"pfw: FIRMWARE DID NOT START within 5 s (marker unchanged %08x)", Cur);
+    Log (L"pfw: try: other nvram file, `ram=`/`size=`, check chip halted state, then `pcon` anyway");
+    return FALSE;
+  }
+  if (Cur < mRamBase || Cur >= mRamBase + mRamSize) {
+    Log (L"pfw: marker changed to %08x but is outside RAM [%08x,%08x)", Cur, mRamBase, mRamBase + mRamSize);
+    return FALSE;
+  }
+  mSharedAddr = Cur;
+  Log (L"pfw: FIRMWARE IS RUNNING after %d ms; shared area at %08x", (I) * 50, Cur);
+  Log (L"pfw: shared: flags=%08x (version %d) console=%08x w32(maxrxbuf@34)=%08x rxdataoff=%08x htod_mb=%08x dtoh_mb=%08x ringinfo=%08x",
+       TcmRd32 (Cur + 0), TcmRd32 (Cur + 0) & 0xFF, TcmRd32 (Cur + BRCMF_SHARED_CONSOLE_ADDR_OFFSET),
+       TcmRd32 (Cur + 32), TcmRd32 (Cur + 36), TcmRd32 (Cur + BRCMF_SHARED_HTOD_MB_OFFSET),
+       TcmRd32 (Cur + BRCMF_SHARED_DTOH_MB_OFFSET), TcmRd32 (Cur + BRCMF_SHARED_RING_INFO_OFFSET));
+  return TRUE;
+}
+
+// ---------------------------------------------------------------------------------------------
+// pcon: firmware console
+// ---------------------------------------------------------------------------------------------
+STATIC
+VOID
+PexConsole (
+  VOID
+  )
+{
+  UINT32  Con;
+  UINT32  Buf;
+  UINT32  Size;
+  UINT32  Widx;
+  UINT32  I;
+  UINT32  W = 0;
+  CHAR8   Line[160];
+  UINTN   L = 0;
+  UINT8   C;
+
+  if (!mPexEnum) {
+    Log (L"pcon: run `pex` first");
+    return;
+  }
+  if (mSharedAddr == 0) {
+    Log (L"pcon: shared area unknown (pfw did not see the firmware start); trying to locate it at RAM end");
+    mSharedAddr = TcmRd32 (mRamBase + mRamSize - 4);
+    if (mSharedAddr < mRamBase || mSharedAddr >= mRamBase + mRamSize) {
+      Log (L"pcon: RAM end word=%08x is not a pointer, firmware console not available", mSharedAddr);
+      mSharedAddr = 0;
+      return;
+    }
+  }
+  Con = TcmRd32 (mSharedAddr + BRCMF_SHARED_CONSOLE_ADDR_OFFSET);
+  if (Con < mRamBase || Con >= mRamBase + mRamSize) {
+    Log (L"pcon: bad console address %08x", Con);
+    return;
+  }
+  Buf  = TcmRd32 (Con + 8);
+  Size = TcmRd32 (Con + 12);
+  Widx = TcmRd32 (Con + 16);
+  Log (L"pcon: console struct %08x buf=%08x size=%08x widx=%08x", Con, Buf, Size, Widx);
+  if (Buf < mRamBase || Size == 0 || Size > 0x10000) {
+    return;
+  }
+  if (Widx > Size) {
+    Widx = Size;
+  }
+  for (I = 0; I < Widx; I++) {
+    if ((I & 3) == 0) {
+      W = TcmRd32 (Buf + I);
+    }
+    C = (UINT8)(W >> ((I & 3) * 8));
+    if (C == '\n' || L >= sizeof (Line) - 2) {
+      Line[L] = 0;
+      Log (L"fw> %a", Line);
+      L = 0;
+      if (C == '\n') {
+        continue;
+      }
+    }
+    if (C >= 0x20 && C < 0x7F) {
+      Line[L++] = (CHAR8)C;
+    }
+  }
+  if (L) {
+    Line[L] = 0;
+    Log (L"fw> %a", Line);
+  }
+}
+
+// ---------------------------------------------------------------------------------------------
+STATIC
+VOID
+PexOff (
+  VOID
+  )
+{
+  Log (L"poff: halt CR4 if reachable, hold PCIe in reset, radio off");
+  if (mPexEnum && mPcieMode) {
+    CoreReset (mArmWrap, 0x20, 0x20, 0x20);
+  }
+  GpioH (H0 | H1, 0, TRUE);
+  if (mPexUp) {
+    Rm (PEX_AFI, AFI_PEX1_CTRL, BIT0, 0);
+  }
+  Wr (CAR_BASE, PX_CAR_RST_U_SET, PX_U_PCIEX);
+  mPexUp      = FALSE;
+  mPexEnum    = FALSE;
+  mPcieMode   = FALSE;
+  mSharedAddr = 0;
+}
diff --git a/Drivers/WifiBtApp/wifi_test.nsh b/Drivers/WifiBtApp/wifi_test.nsh
new file mode 100644
index 0000000..6909409
--- /dev/null
+++ b/Drivers/WifiBtApp/wifi_test.nsh
@@ -0,0 +1,18 @@
+@echo -off
+# BCM4356 Wi-Fi (PCIe) + Bluetooth bring-up (DRAFT). Run from the SD shell; read wifibt.log afterwards: the LAST line names the step that failed.
+# Needs next to this script: brcmfmac4356-pcie.bin, brcmfmac4356-pcie.txt (Wi-Fi), BCM4356A2.hcd (Bluetooth, optional).
+echo wifibt test start
+wifibt info
+wifibt pwr
+echo --- Wi-Fi over PCIe
+wifibt pex
+wifibt pchip
+wifibt pfw brcmfmac4356-pcie.bin brcmfmac4356-pcie.txt
+wifibt pcon
+wifibt poff
+echo --- Bluetooth over UART-D
+wifibt bt BCM4356A2.hcd
+echo put a Joy-Con/Pro Controller in SYNC (pairing) mode now
+wifibt btscan 15
+wifibt off
+echo wifibt test finished: see wifibt.log
diff --git a/Drivers/WinbootSpyDxe/WinbootSpyDxe.c b/Drivers/WinbootSpyDxe/WinbootSpyDxe.c
new file mode 100644
index 0000000..60e3ce7
--- /dev/null
+++ b/Drivers/WinbootSpyDxe/WinbootSpyDxe.c
@@ -0,0 +1,637 @@
+/** @file
+  WinbootSpyDxe: find out which firmware call makes bootmgr.efi give up (0xc0000185).
+
+  Records, deduplicated with counts, every failing call of
+    BootServices: HandleProtocol/OpenProtocol/LocateProtocol/LocateDevicePath/LoadImage/StartImage/
+                  AllocatePages/AllocatePool/GetMemoryMap
+    RuntimeServices: GetVariable/SetVariable/QueryVariableInfo/GetTime
+    BlockIo ReadBlocks/WriteBlocks (LBA, size, status, largest OK read)
+    File protocol Open/Read (file name, status, sizes)
+  plus an ordered event list (file opens, LoadImage/StartImage, ExitBootServices), every BlockIo handle
+  with its device path / partition info, configuration tables and a memory map summary.
+  The text is rewritten to \winboot_spy.log of the volume that holds \EFI or \bootmgr.efi, once a
+  second while something changed (and just before ExitBootServices).
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#include <Uefi.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/PrintLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/DevicePath.h>
+#include <Protocol/DevicePathToText.h>
+#include <Protocol/PartitionInfo.h>
+#include <Protocol/SimpleFileSystem.h>
+#include <Guid/FileInfo.h>
+
+typedef EFI_SIMPLE_FILE_SYSTEM_PROTOCOL_OPEN_VOLUME EFI_VOLUME_OPEN;
+#define IsDevicePathEnd(N)      ((N)->Type == END_DEVICE_PATH_TYPE && (N)->SubType == END_ENTIRE_DEVICE_PATH_SUBTYPE)
+#define DevicePathType(N)       ((N)->Type)
+#define DevicePathSubType(N)    ((N)->SubType)
+#define NextDevicePathNode(N)   ((CONST EFI_DEVICE_PATH_PROTOCOL *)((CONST UINT8 *)(N) + ((N)->Length[0] | ((N)->Length[1] << 8))))
+#define LOG_MAX      (96 * 1024)
+#define MAXU         320          // unique failure entries
+#define MAXEV        300          // ordered events
+#define MAXBLK       16
+#define MAXFILE      256
+#define MAXSFS       8
+
+enum { K_HANDLEPROTO, K_OPENPROTO, K_LOCATEPROTO, K_LOCATEDP, K_LOADIMAGE, K_STARTIMAGE, K_ALLOCPAGES,
+       K_ALLOCPOOL, K_GETMMAP, K_GETVAR, K_SETVAR, K_QUERYVAR, K_GETTIME, K_BLKREAD, K_BLKWRITE,
+       K_FOPEN, K_FREAD, K_KINDS };
+STATIC CONST CHAR8 *mKindName[K_KINDS] = {
+  "HandleProtocol", "OpenProtocol", "LocateProtocol", "LocateDevicePath", "LoadImage", "StartImage",
+  "AllocatePages", "AllocatePool", "GetMemoryMap", "GetVariable", "SetVariable", "QueryVariableInfo",
+  "GetTime", "BlockIo.ReadBlocks", "BlockIo.WriteBlocks", "File.Open", "File.Read" };
+
+typedef struct {
+  UINT8       Kind;
+  EFI_STATUS  Status;
+  UINT32      Count;
+  EFI_GUID    Guid;
+  CHAR8       Name[56];
+  UINT64      A, B;          // first occurrence arguments
+} UENT;
+
+typedef struct { UINT32 Seq; UINT8 Kind; EFI_STATUS Status; CHAR8 Text[88]; } EVENT;
+
+typedef struct {
+  EFI_BLOCK_IO_PROTOCOL *P;
+  EFI_BLOCK_READ         OrigRead;
+  EFI_BLOCK_WRITE        OrigWrite;
+  UINT64                 Reads, Writes, BytesRead, FailRead, FailWrite;
+  UINT64                 MaxOkRead, MinFailRead;
+} BLK;
+
+typedef struct {
+  EFI_FILE_PROTOCOL *F;
+  EFI_FILE_OPEN      OrigOpen;
+  EFI_FILE_READ      OrigRead;
+  EFI_FILE_CLOSE     OrigClose;
+  CHAR8              Name[64];
+  UINT64             Bytes, MaxReq, Reads, Fails;
+} FIL;
+
+typedef struct { EFI_SIMPLE_FILE_SYSTEM_PROTOCOL *P; EFI_VOLUME_OPEN Orig; } SFSH;
+
+STATIC UENT   *mU;      STATIC UINTN mNU;     STATIC UINT64 mDropU;
+STATIC EVENT  *mEv;     STATIC UINTN mNEv;    STATIC UINT32 mSeq;
+STATIC BLK     mBlk[MAXBLK];  STATIC UINTN mNBlk;
+STATIC FIL    *mFil;    STATIC UINTN mNFil;
+STATIC SFSH    mSfs[MAXSFS];  STATIC UINTN mNSfs;
+STATIC UINT32  mDirty, mFlushed;
+STATIC volatile UINTN mBusy;     // BlockIo calls in flight: never touch the SD from the timer while one is running
+STATIC BOOLEAN mInSpy;
+STATIC CHAR8  *mLog;
+STATIC EFI_HANDLE mVolHandle;
+STATIC EFI_EVENT  mTimer, mNotifyEv, mNotifyEv2;
+STATIC VOID   *mReg, *mReg2;
+
+STATIC EFI_HANDLE_PROTOCOL        OrigHandleProtocol;
+STATIC EFI_OPEN_PROTOCOL          OrigOpenProtocol;
+STATIC EFI_LOCATE_PROTOCOL        OrigLocateProtocol;
+STATIC EFI_LOCATE_DEVICE_PATH     OrigLocateDevicePath;
+STATIC EFI_IMAGE_LOAD             OrigLoadImage;
+STATIC EFI_IMAGE_START            OrigStartImage;
+STATIC EFI_ALLOCATE_PAGES         OrigAllocatePages;
+STATIC EFI_ALLOCATE_POOL          OrigAllocatePool;
+STATIC EFI_GET_MEMORY_MAP         OrigGetMemoryMap;
+STATIC EFI_EXIT_BOOT_SERVICES     OrigExitBS;
+STATIC EFI_GET_VARIABLE           OrigGetVariable;
+STATIC EFI_SET_VARIABLE           OrigSetVariable;
+STATIC EFI_QUERY_VARIABLE_INFO    OrigQueryVariableInfo;
+STATIC EFI_GET_TIME               OrigGetTime;
+
+STATIC VOID Flush (BOOLEAN Final);
+STATIC VOID ConsoleSummary (VOID);
+
+STATIC VOID UcsToAscii (CONST CHAR16 *S, CHAR8 *D, UINTN Max)
+{
+  UINTN I = 0;
+  if (S != NULL) { for (; S[I] != 0 && I + 1 < Max; I++) D[I] = (S[I] < 0x80 && S[I] >= 0x20) ? (CHAR8)S[I] : '?'; }
+  D[I] = 0;
+}
+
+// Record one failing call (deduplicated by kind/guid/name/status).
+STATIC VOID Note (UINT8 Kind, EFI_STATUS St, CONST EFI_GUID *G, CONST CHAR8 *Name, UINT64 A, UINT64 B)
+{
+  UINTN I; EFI_TPL T;
+  if (mInSpy || mU == NULL) return;
+  T = gBS->RaiseTPL (TPL_HIGH_LEVEL);
+  for (I = 0; I < mNU; I++) {
+    if (mU[I].Kind == Kind && mU[I].Status == St &&
+        ((G == NULL && IsZeroGuid (&mU[I].Guid)) || (G != NULL && CompareGuid (&mU[I].Guid, G))) &&
+        (Name == NULL || AsciiStrnCmp (mU[I].Name, Name, sizeof (mU[I].Name) - 1) == 0)) {
+      mU[I].Count++; goto done;
+    }
+  }
+  if (mNU < MAXU) {
+    UENT *E = &mU[mNU++];
+    E->Kind = Kind; E->Status = St; E->Count = 1; E->A = A; E->B = B;
+    if (G != NULL) CopyGuid (&E->Guid, G); else ZeroMem (&E->Guid, sizeof (EFI_GUID));
+    if (Name != NULL) AsciiStrnCpyS (E->Name, sizeof (E->Name), Name, sizeof (E->Name) - 1); else E->Name[0] = 0;
+  } else mDropU++;
+done:
+  mDirty++;
+  gBS->RestoreTPL (T);
+}
+
+STATIC VOID Event (UINT8 Kind, EFI_STATUS St, CONST CHAR8 *Text)
+{
+  EFI_TPL T;
+  if (mInSpy || mEv == NULL) return;
+  T = gBS->RaiseTPL (TPL_HIGH_LEVEL);
+  if (mNEv < MAXEV) {
+    EVENT *E = &mEv[mNEv++];
+    E->Seq = mSeq++; E->Kind = Kind; E->Status = St;
+    AsciiStrnCpyS (E->Text, sizeof (E->Text), Text, sizeof (E->Text) - 1);
+    mDirty++;
+  }
+  gBS->RestoreTPL (T);
+}
+
+STATIC VOID PathTail (CONST EFI_DEVICE_PATH_PROTOCOL *P, CHAR8 *Out, UINTN Max)
+{
+  CONST EFI_DEVICE_PATH_PROTOCOL *N = P;
+  CONST CHAR16 *Last = NULL;
+  Out[0] = 0;
+  while (N != NULL && N->Length[0] >= 4 && !IsDevicePathEnd (N)) {
+    if (DevicePathType (N) == MEDIA_DEVICE_PATH && DevicePathSubType (N) == MEDIA_FILEPATH_DP) Last = (CONST CHAR16 *)(N + 1);
+    N = NextDevicePathNode (N);
+  }
+  if (Last != NULL) UcsToAscii (Last, Out, Max);
+}
+
+// ---- Boot services hooks ----
+STATIC EFI_STATUS EFIAPI HHandleProtocol (EFI_HANDLE H, EFI_GUID *G, VOID **I)
+{
+  EFI_STATUS S = OrigHandleProtocol (H, G, I);
+  if (EFI_ERROR (S)) Note (K_HANDLEPROTO, S, G, NULL, 0, 0);
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HOpenProtocol (EFI_HANDLE H, EFI_GUID *G, VOID **I, EFI_HANDLE AH, EFI_HANDLE CH, UINT32 A)
+{
+  EFI_STATUS S = OrigOpenProtocol (H, G, I, AH, CH, A);
+  if (EFI_ERROR (S)) Note (K_OPENPROTO, S, G, NULL, A, 0);
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HLocateProtocol (EFI_GUID *G, VOID *R, VOID **I)
+{
+  EFI_STATUS S = OrigLocateProtocol (G, R, I);
+  if (EFI_ERROR (S)) Note (K_LOCATEPROTO, S, G, NULL, 0, 0);
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HLocateDevicePath (EFI_GUID *G, EFI_DEVICE_PATH_PROTOCOL **DP, EFI_HANDLE *D)
+{
+  EFI_STATUS S = OrigLocateDevicePath (G, DP, D);
+  if (EFI_ERROR (S)) Note (K_LOCATEDP, S, G, NULL, 0, 0);
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HLoadImage (BOOLEAN BP, EFI_HANDLE PH, EFI_DEVICE_PATH_PROTOCOL *DP, VOID *SB, UINTN SS, EFI_HANDLE *IH)
+{
+  CHAR8 Nm[64], Tx[88];
+  EFI_STATUS S = OrigLoadImage (BP, PH, DP, SB, SS, IH);
+  PathTail (DP, Nm, sizeof (Nm));
+  AsciiSPrint (Tx, sizeof (Tx), "LoadImage '%a'%a size=%lu", Nm, SB != NULL ? " (buffer)" : "", (UINT64)SS);
+  Event (K_LOADIMAGE, S, Tx);
+  if (EFI_ERROR (S)) Note (K_LOADIMAGE, S, NULL, Nm, SS, 0);
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HStartImage (EFI_HANDLE IH, UINTN *ES, CHAR16 **ED)
+{
+  CHAR8 Tx[88];
+  EFI_STATUS S;
+  AsciiSPrint (Tx, sizeof (Tx), "StartImage handle=%p ...", IH);
+  Event (K_STARTIMAGE, EFI_SUCCESS, Tx);
+  S = OrigStartImage (IH, ES, ED);
+  AsciiSPrint (Tx, sizeof (Tx), "StartImage handle=%p returned", IH);
+  Event (K_STARTIMAGE, S, Tx);
+  if (EFI_ERROR (S)) { Note (K_STARTIMAGE, S, NULL, NULL, (UINT64)(UINTN)IH, 0); ConsoleSummary (); }
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HAllocatePages (EFI_ALLOCATE_TYPE T, EFI_MEMORY_TYPE M, UINTN P, EFI_PHYSICAL_ADDRESS *A)
+{
+  EFI_PHYSICAL_ADDRESS In = (A != NULL) ? *A : 0;
+  EFI_STATUS S = OrigAllocatePages (T, M, P, A);
+  if (EFI_ERROR (S)) { CHAR8 Tx[56]; AsciiSPrint (Tx, sizeof (Tx), "type=%d mem=%d", T, M); Note (K_ALLOCPAGES, S, NULL, Tx, (UINT64)P << 12, In); }
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HAllocatePool (EFI_MEMORY_TYPE M, UINTN Sz, VOID **B)
+{
+  EFI_STATUS S = OrigAllocatePool (M, Sz, B);
+  if (EFI_ERROR (S)) { CHAR8 Tx[56]; AsciiSPrint (Tx, sizeof (Tx), "mem=%d", M); Note (K_ALLOCPOOL, S, NULL, Tx, Sz, 0); }
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HGetMemoryMap (UINTN *Sz, EFI_MEMORY_DESCRIPTOR *Map, UINTN *Key, UINTN *DS, UINT32 *DV)
+{
+  EFI_STATUS S = OrigGetMemoryMap (Sz, Map, Key, DS, DV);
+  if (EFI_ERROR (S) && S != EFI_BUFFER_TOO_SMALL) Note (K_GETMMAP, S, NULL, NULL, 0, 0);
+  return S;
+}
+STATIC EFI_STATUS EFIAPI HExitBS (EFI_HANDLE IH, UINTN Key)
+{
+  EFI_STATUS S;
+  Event (K_STARTIMAGE, EFI_SUCCESS, "ExitBootServices called");
+  Flush (TRUE);
+  S = OrigExitBS (IH, Key);
+  if (EFI_ERROR (S)) Note (K_STARTIMAGE, S, NULL, "ExitBootServices", Key, 0);
+  return S;
+}
