+		AddMem,
+		EfiBootServicesCode
+	},
+	{
+		// DRAM up to the hekate framebuffers
+		0xaa100000,
+		0x4b900000,
+		EFI_RESOURCE_SYSTEM_MEMORY,
+		SYSTEM_MEMORY_RESOURCE_ATTR_CAPABILITIES,
+		ARM_MEMORY_REGION_ATTRIBUTE_WRITE_BACK,
+		AddMem,
+		EfiConventionalMemory
+	},
+	{
+		// hekate framebuffers (IPL/LOG/NYX/NYX2)
