+	// Landscape surface size is the native size with the axes swapped.
+	CONST UINTN  LW = mNativeHeight;
+	CONST UINTN  LH = mNativeWidth;
+	UINTN        Lx, Ly;
+	UINT32       *Src;
+	UINT32       *Tmp;
+	EFI_STATUS   Status;
+
+	if (Width == 0 || Height == 0) return EFI_SUCCESS;
+
+	if (Delta == 0)
