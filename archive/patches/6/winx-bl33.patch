diff --git a/Drivers/SmBiosTableDxe/SmBiosTableDxe.c b/Drivers/SmBiosTableDxe/SmBiosTableDxe.c
index 9a673c1..7982f03 100644
--- a/Drivers/SmBiosTableDxe/SmBiosTableDxe.c
+++ b/Drivers/SmBiosTableDxe/SmBiosTableDxe.c
@@ -52,6 +52,9 @@
 #include <Library/BaseMemoryLib.h>
 #include <Library/MemoryAllocationLib.h>
 #include <Library/UefiBootServicesTableLib.h>
+#include <Library/ArmLib.h>
+#include <Library/ArmGenericTimerCounterLib.h>
+#include <Library/PcdLib.h>
 
 /* Build-time generated ReleaseInfo.h will override the default one */
 #include "ReleaseInfo.h"
@@ -654,14 +657,123 @@ EnclosureInfoUpdateSmbiosType3 (
 /***********************************************************************
 	SMBIOS data update  TYPE4  Processor Information
 ************************************************************************/
+/**
+  A chain of dependent 1-cycle ADDs: a Cortex-A57 retires one per cycle, so the number of
+  cycles spent equals the number of ADDs executed (the SUBS/B.NE loop overhead issues in
+  parallel and is not on the dependency chain).
+
+  @return  number of ADDs executed (Iterations * 128).
+**/
+STATIC
+UINT64
+CpuDependentAdds (
+  IN UINTN  Iterations
+  )
+{
+	UINT64  Acc = 0;
+
+	__asm__ volatile (
+		"1:\n\t"
+		".rept 128\n\t"
+		"add  %[a], %[a], #1\n\t"
+		".endr\n\t"
+		"subs %[n], %[n], #1\n\t"
+		"b.ne 1b\n\t"
+		: [a] "+r" (Acc), [n] "+r" (Iterations)
+		:
+		: "cc"
+	);
+
+	return Acc;
+}
+
+/**
+  Measure the clock of the CPU core running this code, in MHz.
+
+  The CPU frequency is whatever hekate / BL31 / BPMP-FW left behind; this firmware never
+  changes it and Windows has no driver that does. Measuring it (instead of printing a made up
+  number) tells the person what "fixed operating point" they actually got. The generic timer
+  is the reference; interrupts are masked so the periodic tick cannot inflate the time, and the
+  fastest of several passes is used because noise can only make a pass slower.
+
+  @return  MHz, or 0 if the result is not plausible (reported to SMBIOS as "unknown").
+**/
+STATIC
+UINT32
+MeasureCpuMhz (
+  VOID
+  )
+{
+	CONST UINTN  Iterations = 100000;       // 12.8M cycles: ~7-13 ms at 1.0-1.9 GHz
+	UINT64       Freq;
+	UINT64       T0, T1, Best, Adds;
+	UINTN        Pass;
+	BOOLEAN      IrqWasEnabled;
+	UINT64       Mhz;
+
+	Freq = ArmGenericTimerGetTimerFreq ();
+	if (Freq == 0) {
+		Freq = FixedPcdGet32 (PcdArmArchTimerFreqInHz);
+	}
+	if (Freq == 0) {
+		return 0;
+	}
+
+	IrqWasEnabled = ArmGetInterruptState ();
+	ArmDisableInterrupts ();
+
+	CpuDependentAdds (1000);                // warm the I-cache and branch predictor
+
+	Best = MAX_UINT64;
+	Adds = 0;
+	for (Pass = 0; Pass < 5; Pass++) {
+		T0   = ArmGenericTimerGetSystemCount ();
+		Adds = CpuDependentAdds (Iterations);
+		T1   = ArmGenericTimerGetSystemCount ();
+		if (T1 - T0 < Best) {
+			Best = T1 - T0;
+		}
+	}
+
+	if (IrqWasEnabled) {
+		ArmEnableInterrupts ();
+	}
+
+	if (Best == 0) {
+		return 0;
+	}
+
+	// MHz = cycles / seconds / 1e6, seconds = ticks / Freq
+	Mhz = DivU64x64Remainder (MultU64x64 (Adds, Freq), MultU64x32 (Best, 1000000), NULL);
+	DEBUG ((DEBUG_INFO, "SmBios: measured CPU clock ~%lu MHz (%lu ticks @ %lu Hz for %lu adds)\n",
+		Mhz, Best, Freq, Adds));
+
+	if (Mhz < 50 || Mhz > 2500) {
+		return 0;
+	}
+
+	return (UINT32) Mhz;
+}
+
 VOID
 ProcessorInfoUpdateSmbiosType4 (
   IN UINTN MaxCpus
   )
 {
+	UINT32 CpuMhz;
+
 	// Update string table before proceeds
 	mProcessorInfoType4Strings[2] = (CHAR8*) FixedPcdGetPtr(PcdSmbiosProcessorModel);
 
+	// Tegra X1 / Switch: 4x Cortex-A57 (MADT and PcdCoreCount agree), one thread each.
+	mProcessorInfoType4.CoreCount        = (UINT8) FixedPcdGet32 (PcdCoreCount);
+	mProcessorInfoType4.EnabledCoreCount = (UINT8) FixedPcdGet32 (PcdCoreCount);
+	mProcessorInfoType4.ThreadCount      = (UINT8) FixedPcdGet32 (PcdCoreCount);
+
+	// The static 1900 MHz is the part's nominal ceiling, not what this boot chain configured.
+	CpuMhz = MeasureCpuMhz ();
+	mProcessorInfoType4.CurrentSpeed = (UINT16) CpuMhz;       // 0 = unknown (SMBIOS spec)
+
 	LogSmbiosData ((EFI_SMBIOS_TABLE_HEADER *)&mProcessorInfoType4, mProcessorInfoType4Strings, NULL);
 }
 
