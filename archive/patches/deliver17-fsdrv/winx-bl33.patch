diff --git a/AcpiTables/Pptt.aslc b/AcpiTables/Pptt.aslc
new file mode 100644
index 0000000..e4a0ba0
--- /dev/null
+++ b/AcpiTables/Pptt.aslc
@@ -0,0 +1,51 @@
+/** @file
+  Processor Properties Topology Table (PPTT): 1 package, 4 Cortex-A57 cores.
+  No cache nodes yet (Windows does not require them). UNTESTED ON HARDWARE.
+**/
+
+#include <Base.h>
+#include <Library/AcpiLib.h>
+#include <Library/PcdLib.h>
+
+#include <IndustryStandard/Acpi.h>
+
+#include "Platform.h"
+
+#pragma pack(1)
+
+typedef struct {
+  UINT8  Type;            // 0 = processor hierarchy node
+  UINT8  Length;          // 20 (no private resources)
+  UINT16 Reserved;
+  UINT32 Flags;
+  UINT32 Parent;          // byte offset from table start, 0 = none
+  UINT32 AcpiProcessorId;
+  UINT32 NumPrivResources;
+} PPTT_PROC_NODE;
+
+typedef struct {
+  EFI_ACPI_DESCRIPTION_HEADER Header;
+  PPTT_PROC_NODE              Package;
+  PPTT_PROC_NODE              Core[4];
+} NINTENDO_SWITCH_PPTT;
+
+#pragma pack()
+
+// Flags: bit0 physical package, bit1 ACPI Processor ID valid, bit3 leaf node
+#define PPTT_PACKAGE_FLAGS 0x3
+#define PPTT_CORE_FLAGS    0xA
+// Package node sits right after the 36-byte header
+#define PPTT_PKG_OFFSET    36
+
+#define PPTT_CORE(Uid) \
+  {0, sizeof(PPTT_PROC_NODE), 0, PPTT_CORE_FLAGS, PPTT_PKG_OFFSET, (Uid), 0}
+
+NINTENDO_SWITCH_PPTT Pptt = {
+    ARM_ACPI_HEADER(EFI_ACPI_6_2_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
+                    NINTENDO_SWITCH_PPTT,
+                    EFI_ACPI_6_2_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION),
+    {0, sizeof(PPTT_PROC_NODE), 0, PPTT_PACKAGE_FLAGS, 0, 0, 0},
+    {PPTT_CORE(0), PPTT_CORE(1), PPTT_CORE(2), PPTT_CORE(3)},
+};
+
+VOID *CONST ReferenceAcpiTable = &Pptt;
diff --git a/Drivers/EhciDxeTegra/Ehci.c b/Drivers/EhciDxeTegra/Ehci.c
index b4f1a50..33a061c 100644
--- a/Drivers/EhciDxeTegra/Ehci.c
+++ b/Drivers/EhciDxeTegra/Ehci.c
@@ -358,15 +358,27 @@ EhcGetRootHubPortStatus (
   State = EhcReadOpReg (Ehc, Offset);
 
   //
-  // Identify device speed. If in K state, it is low speed.
-  // If the port is enabled after reset, the device is of
-  // high speed. The USB bus driver should retrieve the actual
-  // port speed after reset.
-  //
-  if (EHC_BIT_IS_SET (State, PORTSC_LINESTATE_K)) {
-    PortStatus->PortStatus |= USB_PORT_STAT_LOW_SPEED;
-  } else if (EHC_BIT_IS_SET (State, PORTSC_ENABLED)) {
-    PortStatus->PortStatus |= USB_PORT_STAT_HIGH_SPEED;
+  // Identify device speed.
+  //
+  // Tegra210 (ChipIdea, integrated transaction translator): low and full speed devices on the
+  // root port are enabled by the controller itself (there is no companion controller), so
+  // "enabled" does NOT imply high speed. The real speed is in HOSTPC1.PSPD (op + 0x84, bits
+  // 26:25: 0 = full, 1 = low, 2 = high). Reporting a full speed device as high speed makes the
+  // bus driver build high speed QHs for it and every transfer fails.
+  //
+  if (EHC_BIT_IS_SET (State, PORTSC_ENABLED)) {
+    switch ((EhcReadOpReg (Ehc, EHC_TEGRA_HOSTPC1_OFFSET) >> 25) & 0x3) {
+      case 0:
+        break;                                              // full speed: no speed flag
+      case 1:
+        PortStatus->PortStatus |= USB_PORT_STAT_LOW_SPEED;
+        break;
+      default:
+        PortStatus->PortStatus |= USB_PORT_STAT_HIGH_SPEED;
+        break;
+    }
+  } else if (EHC_BIT_IS_SET (State, PORTSC_LINESTATE_K)) {
+    PortStatus->PortStatus |= USB_PORT_STAT_LOW_SPEED;      // not enabled yet: K state = low speed
   }
 
   //
