+# TouchPanelDxe.inf: Nintendo Switch touch panel (STMicro FingerTip "FTS4", I2C3 0x49)
+# exposed as EFI_ABSOLUTE_POINTER_PROTOCOL. Protocol/power-up sequence follows the Linux
+# ftm4 (L4T) / hekate FTS4 drivers.
+
+[Defines]
+  INF_VERSION                    = 0x00010005
+  BASE_NAME                      = TouchPanelDxe
+  FILE_GUID                      = 7d0f6a52-3c41-4e8b-9a3e-5b1c2d94f0a7
+  MODULE_TYPE                    = DXE_DRIVER
+  VERSION_STRING                 = 1.0
+  ENTRY_POINT                    = TouchPanelDxeInitialize
+
+[Sources.common]
+  TouchPanel.c
+  Fts4.h
+
+[Packages]
+  ArmPkg/ArmPkg.dec
+  MdePkg/MdePkg.dec
+  MdeModulePkg/MdeModulePkg.dec
+  EmbeddedPkg/EmbeddedPkg.dec
+  NintendoSwitchPkg/NintendoSwitch.dec
+
+[LibraryClasses]
+  BaseLib
+  BaseMemoryLib
+  DebugLib
+  DevicePathLib
+  IoLib
+  UefiLib
+  UefiBootServicesTableLib
+  UefiDriverEntryPoint
+  CompilerIntrinsicsLib
+  GpioLib
+  I2cLib
+  ClockLib
+  EarlyTimerLib
+
+[Protocols]
+  gEfiAbsolutePointerProtocolGuid
+  gEfiDevicePathProtocolGuid
+  gPmicProtocolGuid
+  gTegraPinMuxProtocolGuid
+
+[Depex]
+  gPmicProtocolGuid AND gTegraPinMuxProtocolGuid
diff --git a/Include/Device/TouchPanel.h b/Include/Device/TouchPanel.h
new file mode 100644
index 0000000..81009d8
--- /dev/null
+++ b/Include/Device/TouchPanel.h
@@ -0,0 +1,29 @@
+#ifndef __TOUCH_PANEL_H__
+#define __TOUCH_PANEL_H__
+
+#include <Uefi.h>
+#include <Protocol/DevicePath.h>
+#include <Library/DevicePathLib.h>
+
+// Vendor hardware device path used to expose the FTS4 touch panel (ConIn / AbsolutePointer).
+#define PLAT_TOUCH_DEVICE_GUID \
+    { 0x2abf720d, 0x6e2a, 0x4caa, { 0x80, 0x96, 0x31, 0x7e, 0xf8, 0x27, 0x5b, 0x70 } }
+
+#pragma pack(1)
+typedef struct {
+  VENDOR_DEVICE_PATH  Device;
+  EFI_DEVICE_PATH     End;
+} TOUCH_DEVICE_PATH;
+#pragma pack()
+
+#define TOUCH_DEVICE_PATH_INIT                                                       \
+  {                                                                                  \
+    { { HARDWARE_DEVICE_PATH, HW_VENDOR_DP,                                          \
+        { (UINT8)sizeof (VENDOR_DEVICE_PATH),                                        \
+          (UINT8)(sizeof (VENDOR_DEVICE_PATH) >> 8) } },                             \
+      PLAT_TOUCH_DEVICE_GUID },                                                      \
+    { END_DEVICE_PATH_TYPE, END_ENTIRE_DEVICE_PATH_SUBTYPE,                          \
+      { sizeof (EFI_DEVICE_PATH_PROTOCOL), 0 } }                                     \
+  }
+
+#endif
diff --git a/Include/Library/I2cLib.h b/Include/Library/I2cLib.h
index 65921ab..13304d7 100644
--- a/Include/Library/I2cLib.h
+++ b/Include/Library/I2cLib.h
@@ -29,5 +29,8 @@ UINT32 i2c_send_buf_small(UINT32 idx, UINT32 x, UINT32 y, UINT8 *buf, UINT32 siz
 int i2c_recv_buf_small(UINT8 *buf, UINT32 size, UINT32 idx, UINT32 x, UINT32 y);
 UINT32 i2c_send_byte(UINT32 idx, UINT32 x, UINT32 y, UINT8 b);
 UINT8 i2c_recv_byte(UINT32 idx, UINT32 x, UINT32 y);
+int i2c_xfer_packet(UINT32 idx, UINT32 dev_addr, const UINT8 *tx_buf, UINT32 tx_size, UINT8 *rx_buf, UINT32 rx_size);
+int i2c_recv_buf_big(UINT8 *buf, UINT32 size, UINT32 idx, UINT32 dev_addr, UINT32 reg);
+
 
 #endif
