;
; switchbattery.inf - Nintendo Switch battery (MAX17050 gauge + BQ24193 charger on I2C1)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Battery
ClassGuid   = {72631e54-78a4-11d0-bcf7-00aa00b7b32a}
Provider    = %Mfg%
CatalogFile = switchbattery.cat
DriverVer   = 11/06/2026,1.0.0.7
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
switchbattery.sys = 1

[Manufacturer]
%Mfg% = Std, NTarm64

[Std.NTarm64]
%DeviceDesc% = SwBat_Inst, ACPI\SWOA0301
%LiteDesc% = LiteBat_Inst, ACPI\SWOA0314

[SwBat_Inst.NT]
AddReg    = Erista_Policy
CopyFiles = SwBat_Copy
Include   = battery.inf
Needs     = Battery_Inst

[LiteBat_Inst.NT]
CopyFiles = SwBat_Copy
Include   = battery.inf
Needs     = Battery_Inst
AddReg    = Lite_Policy

[Erista_Policy]
HKR,,PdBoard,0x00010001,0

[Lite_Policy]
HKR,,PdBoard,0x00010001,1

[LiteBat_Inst.NT.Services]
AddService = switchbattery, 0x00000002, SwBat_Service

[LiteBat_Inst.NT.Wdf]
KmdfService = switchbattery, SwBat_WdfSection

[SwBat_Copy]
switchbattery.sys

[SwBat_Inst.NT.Services]
AddService = switchbattery, 0x00000002, SwBat_Service

[SwBat_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\switchbattery.sys

[SwBat_Inst.NT.Wdf]
KmdfService = switchbattery, SwBat_WdfSection

[SwBat_WdfSection]
KmdfLibraryVersion = 1.15

[Strings]
LiteDesc    = "Nintendo Switch Lite Battery and USB-C Power"
Mfg         = "SwitchWOA"
DiskName    = "SwitchWOA Battery"
DeviceDesc  = "Nintendo Switch Battery"
ServiceDesc = "Nintendo Switch Battery"
