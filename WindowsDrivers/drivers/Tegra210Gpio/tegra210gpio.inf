;
; tegra210gpio.inf - Tegra210 GPIO controller (GpioClx client) for the Nintendo Switch
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Mfg%
CatalogFile = tegra210gpio.cat
DriverVer   = 10/25/2026,1.0.0.3
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
tegra210gpio.sys = 1

[Manufacturer]
%Mfg% = Std, NTarm64

[Std.NTarm64]
%DeviceDesc% = TegraGpio_Inst, ACPI\SWOA0101

[TegraGpio_Inst.NT]
CopyFiles = TegraGpio_Copy

[TegraGpio_Copy]
tegra210gpio.sys

[TegraGpio_Inst.NT.Services]
AddService = tegra210gpio, 0x00000002, TegraGpio_Service

[TegraGpio_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\tegra210gpio.sys

[TegraGpio_Inst.NT.Wdf]
KmdfService = tegra210gpio, TegraGpio_WdfSection

[TegraGpio_WdfSection]
KmdfLibraryVersion = 1.15

[Strings]
Mfg         = "SwitchWOA"
DiskName    = "SwitchWOA Tegra210 GPIO"
DeviceDesc  = "NVIDIA Tegra210 GPIO Controller"
ServiceDesc = "Tegra210 GPIO Controller"
