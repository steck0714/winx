[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
CatalogFile=switchsio.cat
DriverVer=11/06/2026,0.2.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTarm64

[Models.NTarm64]
%Device%=Sio,ACPI\SWOA0902

[Sio.NT]
CopyFiles=DriverFiles

[Sio.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,LowerFilters,0x00010000,"vhf"
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[Sio.NT.Services]
AddService=switchsio,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\switchsio.sys

[Sio.NT.Wdf]
KmdfService=switchsio,Framework

[Framework]
KmdfLibraryVersion=1.15

[DestinationDirs]
DriverFiles=13

[DriverFiles]
switchsio.sys

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
switchsio.sys=1

[Strings]
Provider="SwitchWOA"
Device="Switch Lite Internal Gamepad, Mouse and Motion"
Disk="Switch Lite SIO Driver"
