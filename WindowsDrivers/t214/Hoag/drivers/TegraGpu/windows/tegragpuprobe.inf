; Experimental Windows GPU bring-up transport; keeps the existing display.
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Mfg%
CatalogFile=tegragpuprobe.cat
DriverVer=11/09/2026,0.1.0.59
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12
FirmwareFiles=12,TegraGpu
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
tegragpuprobe.sys=1
NETB_img.bin=1
fecs.bin=1
gpccs.bin=1
nv_acr_ucode_prod.bin=1
pmu_bl.bin=1
gpmu_ucode_image.bin=1
gpmu_ucode_desc.bin=1
pmu_sig.bin=1
fecs_sig.bin=1
[Manufacturer]
%Mfg%=Models,NTarm64
[Models.NTarm64]
%Device%=Install,ACPI\SWOA0F01
[Install.NT]
CopyFiles=Copy,FirmwareFiles
[Copy]
tegragpuprobe.sys
[FirmwareFiles]
NETB_img.bin
fecs.bin
gpccs.bin
nv_acr_ucode_prod.bin
pmu_bl.bin
gpmu_ucode_image.bin
gpmu_ucode_desc.bin
pmu_sig.bin
fecs_sig.bin
[Install.NT.Services]
AddService=tegragpuprobe,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\tegragpuprobe.sys
AddReg=Parameters
[Parameters]
HKR,Parameters,SelectedKhz,0x00010003,0x000B2200
[Install.NT.Wdf]
KmdfService=tegragpuprobe,Wdf
[Wdf]
KmdfLibraryVersion=1.15
[Strings]
Mfg="SwitchWOA"
Disk="T214 GPU bring-up"
Device="Switch Lite GPU Bring-up (experimental)"
