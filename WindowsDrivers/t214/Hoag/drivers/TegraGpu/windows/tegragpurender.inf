; Opt-in MCDM miniport for the Lite's GPU ACPI device.
[Version]
Signature="$WINDOWS NT$"
Class=ComputeAccelerator
ClassGuid={F01A9D53-3FF6-48D2-9F97-C8A7004BE10C}
Provider=%Mfg%
CatalogFile=tegragpurender.cat
DriverVer=11/09/2026,0.1.0.65
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12
FirmwareFiles=12,TegraGpu
UmdFiles=13
[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
tegragpurender.sys=1
tegragpuno3d.dll=1
NETB_img.bin=1
fecs.bin=1
gpccs.bin=1
nv_acr_ucode_prod.bin=1
pmu_bl.bin=1
gpmu_ucode_image.bin=1
gpmu_ucode_desc.bin=1
pmu_sig.bin=1
fecs_sig.bin=1
[Manufacturer]
%Mfg%=Models,NTarm64
[Models.NTarm64]
%Device%=Install,ACPI\SWOA0F01
[Install.NT]
CopyFiles=Copy,FirmwareFiles,UmdFiles
AddReg=UmdRegistration
[Copy]
tegragpurender.sys
[UmdFiles]
tegragpuno3d.dll
[UmdRegistration]
HKR,,UserModeDriverName,0x00010000,"%13%\tegragpuno3d.dll","%13%\tegragpuno3d.dll","%13%\tegragpuno3d.dll","%13%\tegragpuno3d.dll"
[FirmwareFiles]
NETB_img.bin
fecs.bin
gpccs.bin
nv_acr_ucode_prod.bin
pmu_bl.bin
gpmu_ucode_image.bin
gpmu_ucode_desc.bin
pmu_sig.bin
fecs_sig.bin
[Install.NT.Services]
AddService=tegragpurender,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\tegragpurender.sys
AddReg=Parameters
[Parameters]
HKR,Parameters,InitializeStatus,0x00010001,0xFFFFFFFF
HKR,Parameters,ResourceStatus,0x00010001,0xFFFFFFFF
HKR,Parameters,HardwareStatus,0x00010001,0xFFFFFFFF
[Strings]
Mfg="SwitchWOA"
Disk="T214 render driver"
Device="Switch Lite GM20B Render Adapter (experimental)"
