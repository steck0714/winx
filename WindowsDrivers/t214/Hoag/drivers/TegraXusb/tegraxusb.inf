[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=tegraxusb.cat
DriverVer=11/06/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTarm64

[Models.NTarm64]
%Device%=Xusb,ACPI\SWOA0D02

[Xusb.NT]
CopyFiles=DriverFiles

[Xusb.NT.Services]
AddService=tegraxusb,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\tegraxusb.sys

[Xusb.NT.Wdf]
KmdfService=tegraxusb,Framework

[Framework]
KmdfLibraryVersion=1.15

[DestinationDirs]
DriverFiles=13

[DriverFiles]
tegraxusb.sys

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
tegraxusb.sys=1

[Strings]
Provider="SwitchWOA"
Device="Switch Lite XUSB Firmware Mailbox"
Disk="Switch Lite XUSB Sideband Driver"
