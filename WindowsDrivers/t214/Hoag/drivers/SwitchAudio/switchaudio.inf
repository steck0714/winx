;
; switchaudio.inf - Nintendo Switch audio (speaker): Tegra210 ADMA/AHUB/I2S1 + ALC5639, PortCls WaveRT
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %Mfg%
CatalogFile = switchaudio.cat
DriverVer   = 11/05/2026,1.0.0.9
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
switchaudio.sys = 1

[Manufacturer]
%Mfg% = Std, NTarm64

[Std.NTarm64]
%DeviceDesc% = SwAud_Inst, ACPI\SWOA0C01

[SwAud_Inst.NT]
Include   = ks.inf, wdmaudio.inf
Needs     = KS.Registration, WDMAUDIO.Registration
CopyFiles = SwAud_Copy
AddReg    = SwAud_AddReg

[SwAud_Copy]
switchaudio.sys

[SwAud_AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,switchaudio.sys

[SwAud_Inst.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%,     SwAud_Wave
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_Wave%,     SwAud_Wave
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%,     SwAud_Wave
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Topology%, SwAud_Topo
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topology%, SwAud_Topo

[SwAud_Wave]
AddReg = SwAud_Wave_AddReg

[SwAud_Wave_AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveDesc%

[SwAud_Topo]
AddReg = SwAud_Topo_AddReg

[SwAud_Topo_AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopoDesc%

[SwAud_Inst.NT.Services]
AddService = switchaudio, 0x00000002, SwAud_Service

[SwAud_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\switchaudio.sys

[Strings]
Mfg                 = "SwitchWOA"
DiskName            = "SwitchWOA Audio"
DeviceDesc          = "Nintendo Switch Audio"
ServiceDesc         = "Nintendo Switch Audio"
WaveDesc            = "Nintendo Switch Speaker Wave"
TopoDesc            = "Nintendo Switch Speaker Topology"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER   = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
Proxy.CLSID         = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSNAME_Wave         = "Wave"
KSNAME_Topology     = "Topology"
