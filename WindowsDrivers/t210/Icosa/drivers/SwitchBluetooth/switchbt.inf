;
; switchbt.inf - Nintendo Switch Bluetooth (BCM4356A3 on UART-D), H4 transport for the inbox BthMini
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %Mfg%
CatalogFile = switchbt.cat
DriverVer   = 10/31/2026,1.0.0.13
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
switchbt.sys = 1

[Manufacturer]
%Mfg% = Std, NTarm64

[Std.NTarm64]
%DeviceDesc% = SwBt_Inst, ACPI\SWOA0B01

[SwBt_Inst.NT]
CopyFiles = SwBt_Copy

[SwBt_Copy]
switchbt.sys

[SwBt_Inst.NT.Services]
AddService = switchbt, 0x00000002, SwBt_Service

[SwBt_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\switchbt.sys

[SwBt_Inst.NT.Wdf]
KmdfService = switchbt, SwBt_WdfSection

[SwBt_WdfSection]
KmdfLibraryVersion = 1.15

[Strings]
Mfg         = "SwitchWOA"
DiskName    = "SwitchWOA Bluetooth"
DeviceDesc  = "Nintendo Switch Bluetooth (UART)"
ServiceDesc = "Nintendo Switch Bluetooth"
