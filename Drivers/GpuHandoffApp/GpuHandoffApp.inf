## @file
#  GpuHandoff.efi - UEFI Shell tool that checks / restores the GM20B hand-off state.
#  Shell app only (not in the FDF): built when SWITCH_ERISTA_GPU / SWITCH_LITE_GPU / SWITCH_OLED_GPU
#  is set; copy GpuHandoff.efi from the build output to the SD card, like XusbInit.efi.
#  Shares Library/PlatformBootManagerLib/GpuHandoff.h with the boot manager. Not a BL33 / firmware image.
#
#  SPDX-License-Identifier: GPL-2.0-only
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = GpuHandoff
  FILE_GUID                      = 6C0E4B5A-5D3F-4B7B-9E7A-2F1D8A4C7E21
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

[Sources]
  GpuHandoffApp.c
  ../../Library/PlatformBootManagerLib/GpuHandoff.h

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  BaseLib
  BaseMemoryLib
  IoLib

[Protocols]
  gEfiShellParametersProtocolGuid
