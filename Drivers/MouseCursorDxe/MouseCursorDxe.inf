# SPDX-License-Identifier: BSD-2-Clause-Patent
# MouseCursorDxe.inf: software mouse cursor on the GOP framebuffer, driven by EFI_SIMPLE_POINTER_PROTOCOL.
# Included in every build; it checks for pointers every 250 ms while idle. See MouseCursorDxe.c.

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = MouseCursorDxe
  FILE_GUID                      = fccde4ca-fb17-44bb-9abf-1a3df22cea3f
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = MouseCursorEntry

[Sources]
  MouseCursorDxe.c
  SwitchMouseCursor.h

[Packages]
  MdePkg/MdePkg.dec
  NintendoSwitchPkg/NintendoSwitch.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiDevicePathProtocolGuid           ## CONSUMES
  gEfiSimplePointerProtocolGuid     ## CONSUMES
  gEfiGraphicsOutputProtocolGuid    ## CONSUMES
  gWinXMouseCursorProtocolGuid      ## PRODUCES

[Depex]
  TRUE
