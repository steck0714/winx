!endif
!ifdef SWITCH_LITE_RESET
  INF NintendoSwitchPkg/Drivers/PmicDxe/t214/LiteResetDxe.inf
!endif
  INF NintendoSwitchPkg/Drivers/SdMmcDxe/SdMmcDxe.inf
!ifndef SWITCH_WOA
!ifndef SWITCH_LITE_TOUCH
  INF NintendoSwitchPkg/Drivers/PinMuxDxe/PinMuxDxe.inf
!endif
!endif
  INF NintendoSwitchPkg/Drivers/TouchPanelDxe/TouchPanelDxe.inf
!ifndef SWITCH_WOA
!ifdef SWITCH_FAN_DUTY
!ifdef SWITCH_LITE_FAN
  INF NintendoSwitchPkg/Drivers/FanDxe/LiteFanPower.inf
!else
  INF NintendoSwitchPkg/Drivers/FanDxe/FanDxe.inf
!endif
!endif
!endif
!ifndef SWITCH_WOA
!ifdef SWITCH_USB
  # USB host (Tegra210 UTMIP / EHCI) is opt-in: build with -D SWITCH_USB=1. Not needed to boot Windows
  # from microSD. Uses the hekate-derived PHY bring-up in PciEmulation and EhciDxeTegra (EhciDxe plus
  # a host-mode restore after HC reset).
  INF NintendoSwitchPkg/Drivers/EhciPciEmulationDxe/PciEmulation.inf
!endif
!endif
  INF MdeModulePkg/Bus/Pci/NonDiscoverablePciDeviceDxe/NonDiscoverablePciDeviceDxe.inf
!ifdef SWITCH_WOA
  # hayato41200/Windows-for-Switch: board bring-up + stock xHCI. The XUSB firmware is embedded and
  # found by UsbPowerAuditDxe through GetSectionFromAnyFv (see Firmware/README.md).
  INF NintendoSwitchPkg/Drivers/UsbPowerAuditDxe/UsbPowerAudit.inf
  # R392 (hayato41200): embed NVIDIA's firmware only with -D EMBED_XUSB_FIRMWARE=TRUE (private builds);
  # otherwise UsbPowerAuditDxe reads \tegra21x_xusb_firmware from the ESP (FAT volume).
!if $(EMBED_XUSB_FIRMWARE) == TRUE
  FILE FREEFORM = 5A0F6A3E-2D4C-4C1B-9E51-7B3F168A0C42 {
    SECTION RAW = NintendoSwitchPkg/Firmware/tegra21x_xusb_firmware
  }
!endif
  INF MdeModulePkg/Bus/Pci/XhciDxe/XhciDxe.inf
!else
!ifdef SWITCH_USB
!ifdef SWITCH_USB_STDEHCI
  # A/B test: the stock EDK2 EhciDxe on top of PciEmulation's PHY/VBUS bring-up. Its HC reset drops the
  # ChipIdea core out of host mode, so the UEFI keyboard does not work; only the OS-side behaviour is of interest.
  INF MdeModulePkg/Bus/Pci/EhciDxe/EhciDxe.inf
!else
  INF NintendoSwitchPkg/Drivers/EhciDxeTegra/EhciDxeTegra.inf
!endif
!else
  INF MdeModulePkg/Bus/Pci/EhciDxe/EhciDxe.inf
!endif
!endif
  INF MdeModulePkg/Bus/Usb/UsbBusDxe/UsbBusDxe.inf
  INF MdeModulePkg/Bus/Usb/UsbMassStorageDxe/UsbMassStorageDxe.inf
  INF MdeModulePkg/Bus/Usb/UsbKbDxe/UsbKbDxe.inf
  INF MdeModulePkg/Bus/Usb/UsbMouseDxe/UsbMouseDxe.inf
  INF NintendoSwitchPkg/Drivers/MouseCursorDxe/MouseCursorDxe.inf
!ifdef SWITCH_EXT
  INF MdeModulePkg/Universal/Disk/RamDiskDxe/RamDiskDxe.inf
!endif
